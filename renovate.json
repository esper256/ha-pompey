{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["dockerfile", "github-actions"],
  "pinDigests": true,
  "automerge": false,
  "prConcurrentLimit": 2,
  "packageRules": [
    {"matchManagers": ["github-actions"], "groupName": "GitHub Actions"},
    {"matchManagers": ["dockerfile"], "groupName": "container base images"}
  ]
}
