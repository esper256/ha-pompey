#!/bin/sh
set -eu
name="$1"
shift
for dir in /test-tools/usr/bin /test-tools/bin /test-tools/usr/sbin; do
  if [ -x "${dir}/${name}" ]; then
    exec /test-tools/lib/ld-musl-x86_64.so.1 --library-path /test-tools/lib:/test-tools/usr/lib "${dir}/${name}" "$@"
  fi
done
printf 'Missing test tool: %s\n' "${name}" >&2
exit 127
