#!/command/with-contenv bashio
# shellcheck shell=bash
# If Gluetun dies, take the whole supervision tree down so *arr cannot leak.
if [[ "${1:-0}" -ne 0 ]] && [[ "${1:-0}" -ne 256 ]]; then
  bashio::log.error "Gluetun crashed (${1}); halting container (kill switch)"
  exec /run/s6/basedir/bin/halt
fi
