#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail
# shellcheck source=/dev/null
source "$(command -v pompey-env)"

until [[ -f "${POMPEY_READY}/engines-ready" ]]; do
  sleep 2
done

pompey-log start "search wiring"
if [[ ! -f "${POMPEY_READY}/wired" ]]; then
  pompey-status wire "Connecting search to your library" 80 || true
fi

wait-for-http http://127.0.0.1:8080/api/v2/app/version 90 || true
wait-for-http http://127.0.0.1:9696/ping 90
wait-for-http http://127.0.0.1:9698/ping 90
wait-for-http http://127.0.0.1:8989/ping 90
wait-for-http http://127.0.0.1:7878/ping 90
wait-for-http http://127.0.0.1:5055/api/v1/settings/public 90

export POMPEY_SECRETS MEDIA_ROOT MEDIA_MOVIES MEDIA_MOVIES_KID MEDIA_TV MEDIA_TV_KID AFTER_DOWNLOAD
export INGRESS_PORT="$(bashio::addon.ingress_port)"

# Retry until Seerr is up and wiring succeeds.
i=0
until python3 /usr/local/bin/wire-stack; do
  i=$((i + 1))
  if [[ "${i}" -ge 30 ]]; then
    bashio::log.error "Wiring failed; household UI may stay on the wait screen"
    if [[ ! -f "${POMPEY_READY}/wired" ]]; then
      pompey-status wire "Could not finish connecting search" 80 "Engines started but wiring failed. Check the app log." || true
    fi
    exec sleep infinity
  fi
  if [[ "${i}" -eq 1 || $((i % 5)) -eq 0 ]]; then
    bashio::log.warning "Wiring not ready yet (attempt ${i})"
  fi
  sleep 8
done

# Search is up. Keep applying Seerr→Arr until the Plex wizard creates user id 1
# (the API key impersonates that row and 403s before then).
until [[ -f "${POMPEY_READY}/seerr-arr" ]]; do
  sleep 15
  python3 /usr/local/bin/wire-stack >/dev/null || true
done

# Search is up. Stop Arr hunting as soon as a Seerr request is removed
# (unmonitor, cancel searches, drop the Arr queue). Housekeep still imports
# leftover files on a slower tick.
python3 /usr/local/bin/wire-stack closeout || true
n=0
while true; do
  sleep 15
  python3 /usr/local/bin/wire-stack closeout || true
  n=$((n + 1))
  if [[ "${n}" -ge 20 ]]; then
    n=0
    python3 /usr/local/bin/wire-stack housekeep || true
  fi
done
