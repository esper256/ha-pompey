#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail
# shellcheck source=/dev/null
source "$(command -v pompey-env)"
export POMPEY_SECRETS POMPEY_CONFIG POMPEY_READY POMPEY_DATA POMPEY_ENGINES
exec > >(pompey-log prefix "Pompey")
exec 2>&1
exec python3 /usr/local/bin/pompey_controller.py
