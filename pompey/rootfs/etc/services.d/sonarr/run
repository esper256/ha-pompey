#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail
# shellcheck source=/dev/null
source "$(command -v pompey-env)"

until [[ -f "${POMPEY_READY}/engines-ready" ]]; do
  sleep 2
done

pompey-svc start "Sonarr"
exec "${POMPEY_ENGINES}/Sonarr/Sonarr" -nobrowser -data="${POMPEY_CONFIG}/sonarr"
