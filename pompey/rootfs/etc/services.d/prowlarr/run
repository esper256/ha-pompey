#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail
# shellcheck source=/dev/null
source "$(command -v pompey-env)"


pompey-log start "Prowlarr"
exec > >(pompey-log prefix "Prowlarr")
exec 2>&1
exec s6-setuidgid pompey "${POMPEY_ENGINES}/Prowlarr/Prowlarr" -nobrowser -data="${POMPEY_CONFIG}/prowlarr"
