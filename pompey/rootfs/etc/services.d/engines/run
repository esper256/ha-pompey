#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail
# shellcheck source=/dev/null
source "$(command -v pompey-env)"

# Do not fetch until WireGuard has a handshake. vpn-applied is only "Proton
# file is on disk"; wg-quick may still be retrying. with-contenv also drops
# WAIT_FOR_VPN_QUIET, which used to spam handshake errors from this service.
until [[ -f "${POMPEY_READY}/vpn-up" ]]; do
  sleep 2
done
pompey-log start "engine fetch"
# Opening Ingress only reads status.json. Do not rewind the installer bar
# because this service restarted after search was already wired.
if [[ ! -f "${POMPEY_READY}/wired" ]]; then
  pompey-status fetch "Downloading hidden engines" 30 || true
fi
n=0
until fetch-engines; do
  n=$((n + 1))
  if [[ "${n}" -ge 5 ]]; then
    if [[ ! -f "${POMPEY_READY}/wired" ]]; then
      pompey-status fetch "Download failed" 30 "Could not download the household UI or hidden engines. The tunnel may be down." || true
    fi
    exit 1
  fi
  bashio::log.warning "Engine download failed; retry ${n}/5"
  sleep 15
done
write-engine-configs
# Only after configs exist so the other services do not start empty.
touch "${POMPEY_READY}/engines-ready"
if [[ ! -f "${POMPEY_READY}/wired" ]]; then
  pompey-status start "Starting hidden engines" 70 || true
fi
bashio::log.info "Engine fetch complete"
exec sleep infinity
