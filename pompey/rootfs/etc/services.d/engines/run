#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail
# shellcheck source=/dev/null
source "$(command -v pompey-env)"

# Do not burn the handshake countdown before a Proton file exists.
until [[ -f "${POMPEY_READY}/vpn-applied" ]]; do
  sleep 2
done
WAIT_FOR_VPN_QUIET=1 wait-for-vpn 45
pompey-status fetch "Downloading hidden engines" 30 || true
n=0
until fetch-engines; do
  n=$((n + 1))
  if [[ "${n}" -ge 5 ]]; then
    pompey-status fetch "Download failed" 30 "Could not download the household UI or hidden engines. The tunnel may be down." || true
    exit 1
  fi
  bashio::log.warning "Engine download failed; retry ${n}/5"
  sleep 15
done
write-engine-configs
# Only after configs exist so the other services do not start empty.
touch "${POMPEY_READY}/engines-ready"
pompey-status start "Starting hidden engines" 70 || true
bashio::log.info "Engine fetch complete"
exec sleep infinity
