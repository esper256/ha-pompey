#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

if ! bashio::config.true 'port_forwarding'; then
  bashio::log.info "Port forwarding disabled"
  exec sleep infinity
fi

wait-for-vpn 45
GW="$(bashio::config 'wireguard_dns')"
bashio::log.info "NAT-PMP renew loop against ${GW}"

while true; do
  if out="$(natpmpc -a 1 0 udp 60 -g "${GW}" 2>/dev/null)"; then
    port="$(printf '%s\n' "${out}" | awk '/Mapped public port/ { print $4; exit }')"
    if [[ -n "${port}" ]]; then
      printf '%s\n' "${port}" >/tmp/vpn/forwarded_port
      apply-qbit-port /tmp/vpn/forwarded_port || true
    fi
  else
    bashio::log.warning "natpmpc UDP mapping failed (need a Proton config with NAT-PMP enabled)"
  fi
  natpmpc -a 1 0 tcp 60 -g "${GW}" >/dev/null 2>&1 || true
  sleep 45
done
