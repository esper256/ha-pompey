#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail
# shellcheck source=/dev/null
source "$(command -v pompey-env)"

until [[ -f "${POMPEY_READY}/engines-ready" ]]; do
  sleep 2
done

exec "${POMPEY_ENGINES}/qbittorrent-nox" \
  --profile="${POMPEY_CONFIG}" \
  --webui-port=8080 \
  --confirm-legal-notice
