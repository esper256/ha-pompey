#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail
# shellcheck source=/dev/null
source "$(command -v pompey-env)"

need_vpn() {
  POMPEY_STATUS_NEED_VPN=1 pompey_status.py vpn "Add your VPN configuration" 8 || true
}

# Stamp every wg-quick line. Home Assistant's app log otherwise shows a wall
# of untimed [#] commands, then one bashio ERROR much later.
log_wg_quick() {
  local out rc=0
  set +e
  out="$(PATH="/usr/local/bin/pompey-wg:${PATH}" "$@" 2>&1)"
  rc=$?
  set -e
  if [[ -n "${out}" ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
      bashio::log.info "[WireGuard] ${line}"
    done <<<"${out}"
  fi
  return "${rc}"
}

# wg-quick will delete wg0 if resolvconf or src_valid_mark fails on HAOS.
# PATH helpers no-op those two; runtime conf uses Table=off so sysctl is not
# called. VPN DNS is written after the iface is up.
wg_quick_up() {
  log_wg_quick wg-quick up wg0
}

bring_up_wg0() {
  wg-quick down wg0 >/dev/null 2>&1 || true
  bashio::log.info "Bringing up wg0"
  POMPEY_STATUS_NEED_VPN=0 pompey_status.py vpn "Connecting VPN" 10 || true
  if wg_quick_up; then
    return 0
  fi
  bashio::log.warning "Kernel WireGuard failed; trying wireguard-go"
  export WG_QUICK_USERSPACE_IMPLEMENTATION=wireguard-go
  wg_quick_up
}

mark_vpn_up() {
  mkdir -p "${POMPEY_READY}"
  touch "${POMPEY_READY}/vpn-up"
}

trap 'rm -f "${POMPEY_READY}/vpn-up"' EXIT
pompey-log start "WireGuard"

if [[ "${POMPEY_FAKE_VPN:-}" == "1" ]]; then
  bashio::log.info "Fake wg0 (agent/dev): not VPN"
  pompey_status.py vpn "Bringing up fake wg0" 10 || true
  pompey-dev-vpn up
  POMPEY_STATUS_NEED_VPN=0 pompey_status.py vpn "Fake wg0 is up" 15 || true
  wait-for-vpn 10
  mark_vpn_up
  while wait-for-vpn 1; do
    sleep 30
  done
  bashio::log.error "Fake wg0 went away"
  exit 1
fi

# Stay running while we wait. Ingress is Supervisor INPUT (not the kill
# switch). Exiting used to halt the whole container and take nginx with it.
# Restore the pre-tunnel resolver for endpoint hostname lookup after a lost
# tunnel. HAOS's LAN resolver remains allowed by the firewall.
if [[ -f "${POMPEY_READY}/bootstrap-resolv.conf" ]]; then
  cp "${POMPEY_READY}/bootstrap-resolv.conf" "${POMPEY_RESOLV}"
fi
until apply-vpn-config; do
  need_vpn
  sleep 2
done

until bring_up_wg0; do
  bashio::log.error "wg-quick could not bring up wg0; Ingress stays up. Retrying. Open the app log (do not send the VPN key)."
  POMPEY_STATUS_NEED_VPN=0 pompey_status.py vpn "VPN tunnel could not start" 10 "VPN connection failed. Check the app log." || true
  sleep 5
  exit 1 # Re-read a corrected configuration on the next supervised attempt.
done

pompey-wg-routes

# Filter tables sometimes appear only after the interface exists. Retry once.
if [[ "${POMPEY_FAKE_VPN:-}" != "1" ]]; then
  vpn-killswitch "${POMPEY_WG_CONF}"
fi

bashio::log.info "Waiting for VPN connection on wg0"
pompey_status.py vpn "Waiting for VPN connection" 15 || true
wait-for-vpn 45
mark_vpn_up

signature="$(sha256sum "${POMPEY_WG_FILE}")"
while wait-for-vpn 1; do
  [[ "$(sha256sum "${POMPEY_WG_FILE}")" == "${signature}" ]] || exit 1
  sleep 5
done
bashio::log.error "WireGuard handshake lost"
exit 1
