#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

if [[ "${POMPEY_FAKE_VPN:-}" == "1" ]]; then
  bashio::log.info "Fake wg0 (agent/dev): not Proton"
  pompey-status vpn "Bringing up fake wg0" 10 || true
  pompey-dev-vpn up
  pompey-status vpn "Fake wg0 is up" 15 || true
  wait-for-vpn 10
  while wait-for-vpn 1; do
    sleep 30
  done
  bashio::log.error "Fake wg0 went away"
  exit 1
fi

if [[ ! -f /etc/wireguard/wg0.conf ]]; then
  bashio::exit.nok "WireGuard config missing"
fi

bashio::log.info "Bringing up wg0"
pompey-status vpn "Bringing up the Proton tunnel" 10 || true
if ! wg-quick up wg0; then
  bashio::log.warning "Kernel WireGuard failed; trying wireguard-go"
  export WG_QUICK_USERSPACE_IMPLEMENTATION=wireguard-go
  wg-quick up wg0
fi

# wg-quick may rewrite resolv.conf; keep Proton tunnel DNS.
printf 'nameserver %s\n' "$(bashio::config 'wireguard_dns')" >/etc/resolv.conf

bashio::log.info "Waiting for Proton handshake on wg0"
pompey-status vpn "Waiting for Proton handshake" 15 || true
wait-for-vpn 45

# Stay in the foreground. A stale handshake is a crash (kill switch).
while wait-for-vpn 1; do
  sleep 30
done
bashio::log.error "WireGuard handshake lost"
exit 1
