#!/usr/bin/env python3
"""Write Recyclarr YAML from secrets and sync TRaSH profiles onto Arr.

Default = TRaSH HD (1080p WEB/Bluray). Max = TRaSH UHD (4K encodes) with 1080p
as a fallback so a Max request is not 4K-or-nothing. Remux stays off. Anything
is not Recyclarr's — Pompey keeps that profile. Secrets are never printed.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time

# TRaSH Guides quality-profile trash IDs (stable; Recyclarr names them Default/Max).
TRASH_RADARR_HD = "d1d67249d3890e49bc12e275d989a7e9"  # HD Bluray + WEB
TRASH_RADARR_UHD = "64fb5f9858489bdac2af690e27c8f42f"  # UHD Bluray + WEB
TRASH_SONARR_HD = "72dae194fc92bf828f32cde7744e51a1"  # WEB-1080p
TRASH_SONARR_UHD = "d1498e7d189fbe6c7110ceaabb7473e6"  # WEB-2160p


def env(name: str, default: str = "") -> str:
    return os.environ.get(name, default).strip()


def log(msg: str, level: str = "INFO") -> None:
    stamp = time.strftime("%H:%M:%S")
    print(f"[{stamp}] {level}: [recyclarr-sync] {msg}", flush=True)


def secrets_path() -> str:
    return env("POMPEY_SECRETS", "/data/pompey/secrets.json")


def app_data() -> str:
    return env("POMPEY_RECYCLARR_DATA") or os.path.join(
        env("POMPEY_DATA", "/data/pompey"), "recyclarr"
    )


def config_path() -> str:
    return os.path.join(app_data(), "recyclarr.yml")


def recyclarr_bin() -> str:
    override = env("POMPEY_RECYCLARR")
    if override:
        return override
    return os.path.join(env("POMPEY_ENGINES", "/data/engines"), "recyclarr")


def load_secrets() -> dict:
    with open(secrets_path(), encoding="utf-8") as fh:
        data = json.load(fh)
    if not isinstance(data, dict):
        raise RuntimeError("secrets.json is not an object")
    return data


def yaml_quote(value: str) -> str:
    return json.dumps(str(value), ensure_ascii=False)


def render_config(radarr_url: str, radarr_key: str, sonarr_url: str, sonarr_key: str) -> str:
    """Guide-backed Default/Max. Qualities on Max add 1080p under 4K; remux disabled."""
    return f"""# Generated by Pompey. Do not edit; rewritten on each sync.
# yaml-language-server: $schema=https://schemas.recyclarr.dev/v8/config-schema.json
radarr:
  movies:
    base_url: {yaml_quote(radarr_url)}
    api_key: {yaml_quote(radarr_key)}
    delete_old_custom_formats: false
    quality_definition:
      type: movie
    quality_profiles:
      - trash_id: {TRASH_RADARR_HD}
        name: Default
        reset_unmatched_scores:
          enabled: true
      - trash_id: {TRASH_RADARR_UHD}
        name: Max
        reset_unmatched_scores:
          enabled: true
        upgrade:
          allowed: true
          until_quality: Bluray-2160p
          until_score: 10000
        qualities:
          - name: Bluray-2160p
          - name: WEB 2160p
            qualities:
              - WEBRip-2160p
              - WEBDL-2160p
          - name: Bluray-1080p
          - name: WEB 1080p
            qualities:
              - WEBRip-1080p
              - WEBDL-1080p
          - name: Remux-2160p
            enabled: false
          - name: Remux-1080p
            enabled: false
sonarr:
  tv:
    base_url: {yaml_quote(sonarr_url)}
    api_key: {yaml_quote(sonarr_key)}
    delete_old_custom_formats: false
    quality_definition:
      type: series
    quality_profiles:
      - trash_id: {TRASH_SONARR_HD}
        name: Default
        reset_unmatched_scores:
          enabled: true
        upgrade:
          allowed: true
          until_quality: WEB 1080p
          until_score: 10000
        qualities:
          - name: WEB 1080p
            qualities:
              - WEBDL-1080p
              - WEBRip-1080p
          - name: Bluray-1080p
          - name: Bluray-720p
      - trash_id: {TRASH_SONARR_UHD}
        name: Max
        reset_unmatched_scores:
          enabled: true
        upgrade:
          allowed: true
          until_quality: WEB 2160p
          until_score: 10000
        qualities:
          - name: WEB 2160p
            qualities:
              - WEBRip-2160p
              - WEBDL-2160p
          - name: Bluray-2160p
          - name: WEB 1080p
            qualities:
              - WEBRip-1080p
              - WEBDL-1080p
          - name: Bluray-1080p
          - name: Bluray-2160p Remux
            enabled: false
          - name: Bluray-1080p Remux
            enabled: false
"""


def write_config(radarr_url: str, radarr_key: str, sonarr_url: str, sonarr_key: str) -> str:
    path = config_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    body = render_config(radarr_url, radarr_key, sonarr_url, sonarr_key)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(body)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    return path


def redact(text: str, secrets: dict) -> str:
    out = text or ""
    for value in secrets.values():
        if isinstance(value, str) and len(value) >= 8:
            out = out.replace(value, "***")
    return out


def main() -> int:
    binary = recyclarr_bin()
    if not os.path.isfile(binary) or not os.access(binary, os.X_OK):
        log("Recyclarr binary not on disk; Default/Max stay name stubs until Recyclarr can sync")
        return 2
    secrets = load_secrets()
    radarr_key = str(secrets.get("radarr_api_key") or "")
    sonarr_key = str(secrets.get("sonarr_api_key") or "")
    if not radarr_key or not sonarr_key:
        log("missing Arr API keys", "ERROR")
        return 1
    radarr = env("RADARR_URL", "http://127.0.0.1:7878").rstrip("/")
    sonarr = env("SONARR_URL", "http://127.0.0.1:8989").rstrip("/")
    path = write_config(radarr, radarr_key, sonarr, sonarr_key)
    data = app_data()
    cmd = [binary, "sync", "-c", path]
    log("syncing TRaSH Default/Max onto Radarr and Sonarr")
    child_env = os.environ.copy()
    child_env["RECYCLARR_CONFIG_DIR"] = data
    child_env["RECYCLARR_DATA_DIR"] = data
    child_env["NO_COLOR"] = "1"
    child_env.pop("RECYCLARR_APP_DATA", None)
    try:
        proc = subprocess.run(
            cmd,
            check=False,
            capture_output=True,
            text=True,
            timeout=int(env("POMPEY_RECYCLARR_TIMEOUT", "600") or "600"),
            env=child_env,
        )
    except subprocess.TimeoutExpired:
        log("Recyclarr timed out cloning or syncing TRaSH", "WARNING")
        return 1
    except OSError as exc:
        log(f"could not start Recyclarr: {exc}", "WARNING")
        return 1
    stdout = redact(proc.stdout or "", secrets).strip()
    stderr = redact(proc.stderr or "", secrets).strip()
    if stdout:
        for line in stdout.splitlines()[-40:]:
            log(line)
    if proc.returncode != 0:
        if stderr:
            for line in stderr.splitlines()[-20:]:
                log(line, "WARNING")
        log(f"Recyclarr sync failed (exit {proc.returncode})", "WARNING")
        return proc.returncode or 1
    log("TRaSH Default/Max applied")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:  # noqa: BLE001
        log(str(exc), "ERROR")
        raise SystemExit(1) from exc
