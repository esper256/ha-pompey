#!/usr/bin/env python3
"""Proxy Seerr and rewrite root-absolute URLs for Home Assistant Ingress.

Unused on the household path as of 0.2.16: Seerr is published on host
port 5055 so Next.js can keep its own URLs. Ingress nginx serves only
Pompey's wait/status UI. This module stays so we can prove the old
rewrite bugs in tests, not because the sidebar still iframes Seerr.
"""
from __future__ import annotations

import http.client
import os
import select
import socket
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit

def listen_url() -> str:
    return os.environ.get("POMPEY_INGRESS_PROXY", "http://127.0.0.1:8098")


def seerr_base() -> str:
    return os.environ.get("SEERR_URL", "http://127.0.0.1:5055").rstrip("/")

# Unique prefixes — safe to replace globally (Seerr's subfolder nginx example).
# Do not globally replace /login or /setup: those appear as JS regex literals
# (`/login/i`) in minified chunks. Prefixing them produces Invalid regular
# expression and the Plex button on the setup wizard does nothing.
REWRITE_PATHS = (
    "/_next",
    "/api/v1",
    "/login/plex/loading",
    "/images/",
    "/imageproxy/",
    "/avatarproxy/",
    "/android-",
    "/apple-",
    "/favicon",
    "/logo_",
    "/site.webmanifest",
)

# Short routes: only rewrite when they are quoted URL strings, not /login/i.
QUOTED_PATHS = (
    "/login",
    "/setup",
)

TEXT_TYPES = (
    "text/html",
    "text/css",
    "text/javascript",
    "application/javascript",
    "application/json",
    "application/manifest+json",
)


def ingress_prefix(headers) -> str:
    raw = (
        headers.get("X-Ingress-Path")
        or headers.get("X-Forwarded-Prefix")
        or os.environ.get("INGRESS_PATH")
        or ""
    )
    return raw.rstrip("/")


def _replace_unprefixed(text: str, old: str, new: str) -> str:
    """Replace old with new, skipping already-prefixed hits and escaped slashes.

    Next.js ships regexes like /^\\/_next\\/data\\//. A naive /_next replace
    turns that into /^\\/api/hassio_ingress/tok/_next\\/data\\// which is
    invalid (the regex ends at /api). Skip a match whose '/' is escaped so
    the later \\/_next pass can prefix it as a regex-safe path.
    """
    if not old or old == new:
        return text

    def replace_part(part: str) -> str:
        if not old.startswith("/"):
            return part.replace(old, new)
        out: list[str] = []
        i = 0
        n = len(old)
        while True:
            j = part.find(old, i)
            if j < 0:
                out.append(part[i:])
                return "".join(out)
            if j > 0 and part[j - 1] == "\\":
                out.append(part[i : j + n])
                i = j + n
                continue
            out.append(part[i:j])
            out.append(new)
            i = j + n

    return new.join(replace_part(part) for part in text.split(new))


def rewrite_seerr_body(text: str, prefix: str) -> str:
    prefix = (prefix or "").rstrip("/")
    if not prefix:
        return text
    escaped = prefix.replace("/", "\\/")
    out = text
    for path in REWRITE_PATHS:
        out = _replace_unprefixed(out, path, prefix + path)
        js_old = path.replace("/", "\\/")
        js_new = escaped + js_old
        out = _replace_unprefixed(out, js_old, js_new)
    for path in QUOTED_PATHS:
        for quote in ('"', "'", "`"):
            out = _replace_unprefixed(out, f"{quote}{path}", f"{quote}{prefix}{path}")
            js_old = quote + path.replace("/", "\\/")
            js_new = quote + escaped + path.replace("/", "\\/")
            out = _replace_unprefixed(out, js_old, js_new)
    out = _replace_unprefixed(out, 'href="/"', f'href="{prefix}/"')
    out = _replace_unprefixed(out, "href='/'", f"href='{prefix}/'")
    out = _replace_unprefixed(out, 'href:"/"', f'href:"{prefix}/"')
    return out


def rewrite_location(value: str, prefix: str) -> str:
    prefix = (prefix or "").rstrip("/")
    if not prefix or not value:
        return value
    if value.startswith(prefix):
        return value
    if value.startswith("/") and not value.startswith("//"):
        return prefix + value
    return value


def rewrite_set_cookie(value: str, prefix: str) -> str:
    """Scope Seerr's Path=/ cookie to the Ingress prefix on the HA origin."""
    prefix = (prefix or "").rstrip("/")
    if not prefix or not value:
        return value
    parts = []
    for part in value.split(";"):
        raw = part.strip()
        if raw.lower().startswith("path="):
            path = raw.split("=", 1)[1].strip() or "/"
            if path.startswith("/") and not path.startswith("//") and not path.startswith(prefix):
                path = prefix if path == "/" else prefix + path
            parts.append(f"Path={path}")
        else:
            parts.append(raw)
    return "; ".join(parts)


def _upstream() -> tuple[str, int]:
    parsed = urlsplit(seerr_base())
    host = parsed.hostname or "127.0.0.1"
    port = parsed.port or (443 if parsed.scheme == "https" else 80)
    return host, port


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt: str, *args) -> None:
        path = self.path.split("?", 1)[0]
        quiet = (
            path.startswith("/_next/static/")
            or path in {"/favicon.ico", "/logo.png", "/status.json", "/site.webmanifest"}
        )
        code = str(args[1]) if len(args) >= 2 else ""
        if quiet and code in {"200", "304"}:
            return
        stamp = time.strftime("%H:%M:%S")
        sys.stderr.write(f"[{stamp}] INFO: [pompey-ingress] {fmt % args}\n")

    def do_GET(self):
        self._proxy()

    def do_POST(self):
        self._proxy()

    def do_PUT(self):
        self._proxy()

    def do_PATCH(self):
        self._proxy()

    def do_DELETE(self):
        self._proxy()

    def do_HEAD(self):
        self._proxy()

    def do_OPTIONS(self):
        self._proxy()

    def _proxy(self) -> None:
        if (self.headers.get("Connection") or "").lower().find("upgrade") >= 0:
            self._websocket()
            return
        prefix = ingress_prefix(self.headers)
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else b""
        host, port = _upstream()
        conn = http.client.HTTPConnection(host, port, timeout=120)
        headers = {k: v for k, v in self.headers.items() if k.lower() not in {"host", "content-length"}}
        headers["Host"] = f"{host}:{port}"
        headers["Accept-Encoding"] = "identity"
        try:
            conn.request(self.command, self.path, body=body or None, headers=headers)
            resp = conn.getresponse()
            raw = resp.read()
        except OSError as exc:
            msg = f"upstream {seerr_base()}: {exc}".encode()
            self.send_response(502)
            self.send_header("Content-Type", "text/plain")
            self.send_header("Content-Length", str(len(msg)))
            self.end_headers()
            self.wfile.write(msg)
            return
        finally:
            conn.close()

        ctype = (resp.getheader("Content-Type") or "").split(";")[0].strip().lower()
        if prefix and any(ctype.startswith(t) for t in TEXT_TYPES):
            try:
                raw = rewrite_seerr_body(raw.decode("utf-8"), prefix).encode("utf-8")
            except UnicodeDecodeError:
                pass

        self.send_response(resp.status, resp.reason)
        hop = {"transfer-encoding", "connection", "content-length", "content-encoding"}
        for key, val in resp.getheaders():
            if key.lower() in hop:
                continue
            if key.lower() == "location":
                val = rewrite_location(val, prefix)
            elif key.lower() == "set-cookie":
                val = rewrite_set_cookie(val, prefix)
            self.send_header(key, val)
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(raw)

    def _websocket(self) -> None:
        host, port = _upstream()
        upstream = socket.create_connection((host, port), timeout=30)
        req = f"{self.command} {self.path} HTTP/1.1\r\n"
        for key, val in self.headers.items():
            req += f"{key}: {val}\r\n"
        req += "\r\n"
        upstream.sendall(req.encode("latin1"))
        self.connection.setblocking(False)
        upstream.setblocking(False)
        conns = [self.connection, upstream]
        try:
            while True:
                readable, _, err = select.select(conns, [], conns, 60)
                if err:
                    break
                if not readable:
                    continue
                for sock in readable:
                    other = upstream if sock is self.connection else self.connection
                    data = sock.recv(65536)
                    if not data:
                        return
                    other.sendall(data)
        finally:
            try:
                upstream.close()
            except OSError:
                pass


def main() -> int:
    parsed = urlsplit(listen_url())
    host = parsed.hostname or "127.0.0.1"
    port = parsed.port or 8098
    httpd = ThreadingHTTPServer((host, port), Handler)
    print(f"[{time.strftime('%H:%M:%S')}] INFO: [pompey-ingress] {listen_url()} -> {seerr_base()}", flush=True)
    httpd.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
