#!/command/with-contenv bashio
# shellcheck shell=bash
# Start/stop lines for the Home Assistant app log, plus qBittorrent log filter.
set -euo pipefail

log() {
  local level="$1"
  local msg="$2"
  if declare -F bashio::log.info >/dev/null 2>&1; then
    case "${level}" in
      warning) bashio::log.warning "${msg}" ;;
      error) bashio::log.error "${msg}" ;;
      *) bashio::log.info "${msg}" ;;
    esac
  else
    printf '[%s] %s\n' "${level}" "${msg}"
  fi
}

cmd="${1:-}"
name="${2:-service}"

case "${cmd}" in
  start)
    log info "Starting ${name}"
    ;;
  finish)
    code="${3:-0}"
    sig="${4:-0}"
    if [[ "${sig}" =~ ^[0-9]+$ ]] && [[ "${sig}" -gt 0 ]]; then
      if [[ "${sig}" -eq 15 || "${sig}" -eq 2 ]]; then
        log info "${name} stopped"
      else
        log warning "${name} killed (signal ${sig})"
      fi
    elif [[ "${code}" == "0" || "${code}" == "256" ]]; then
      log info "${name} stopped"
    else
      log warning "${name} exited (${code})"
    fi
    ;;
  qbit-line)
    line="${name}"
    if [[ "${line}" == *'(C)'* ]]; then
      log error "[qBittorrent] ${line}"
    elif [[ "${line}" == *'(W)'* ]] \
      || grep -qiE 'error|fail|denied|unable|timeout|permission' <<<"${line}"; then
      log warning "[qBittorrent] ${line}"
    fi
    ;;
  *)
    printf 'usage: pompey-svc start|finish NAME [exitcode] [signal]\n' >&2
    printf '       pompey-svc qbit-line LINE\n' >&2
    exit 2
    ;;
esac
