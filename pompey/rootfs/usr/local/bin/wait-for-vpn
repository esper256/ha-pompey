#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail
TRIES="${1:-60}"
for ((i=0; i<TRIES; i++)); do
  ts="$(wg show "${WG_IFACE:-wg0}" latest-handshakes 2>/dev/null | awk 'NR==1 {print $2}')" || ts=0
  if [[ "${ts:-0}" -gt 0 ]] && (( $(date +%s) - ts < ${WG_HANDSHAKE_MAX_AGE:-180} )); then exit 0; fi
  [[ "${TRIES}" -eq 1 ]] || sleep 2
done
exit 1
