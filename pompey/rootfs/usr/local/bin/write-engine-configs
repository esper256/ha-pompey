#!/command/with-contenv bashio
# shellcheck shell=bash
# Write engine configs before they start. Radarr/Sonarr/qbit stay localhost.
# Prowlarr is published on the host for indexer configuration.
# Seerr has no indexer settings.
set -euo pipefail
# shellcheck source=/dev/null
source "$(command -v pompey-env)"
pompey-secrets >/dev/null

exec python3 "$(command -v write_engine_configs.py)" "${POMPEY_SECRETS}" "${MEDIA_ROOT}"
