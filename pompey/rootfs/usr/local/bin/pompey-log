#!/command/with-contenv bashio
# shellcheck shell=bash
# Home Assistant's app log is this container's stdout. s6-overlay already
# multiplexes every service into that stream — do not add Vector/Fluent Bit.
# This helper adds start/stop, a service name on every line, and tails
# file-only loggers (qBittorrent) into the same format.
set -euo pipefail

log() {
  local level="$1"
  local msg="$2"
  if declare -F bashio::log.info >/dev/null 2>&1; then
    case "${level}" in
      warning) bashio::log.warning "${msg}" ;;
      error) bashio::log.error "${msg}" ;;
      *) bashio::log.info "${msg}" ;;
    esac
  else
    printf '[%s] %s\n' "${level}" "${msg}"
  fi
}

# Line-buffered stdin → tagged app log. Flush every line so a pipe to the
# Supervisor log does not sit in a libc buffer.
emit_py() {
  python3 "$(command -v pompey-log-emit)" "$@"
}

cmd="${1:-}"
name="${2:-service}"

case "${cmd}" in
  start)
    log info "Starting ${name}"
    ;;
  finish)
    code="${3:-0}"
    sig="${4:-0}"
    if [[ "${sig}" =~ ^[0-9]+$ ]] && [[ "${sig}" -gt 0 ]]; then
      if [[ "${sig}" -eq 15 || "${sig}" -eq 2 ]]; then
        log info "${name} stopped"
      else
        log warning "${name} killed (signal ${sig})"
      fi
    elif [[ "${code}" == "0" || "${code}" == "256" ]]; then
      log info "${name} stopped"
    else
      log warning "${name} exited (${code})"
    fi
    ;;
  line)
    emit_py "${name}" "${3:-}"
    ;;
  prefix)
    emit_py "${name}"
    ;;
  tail)
    file="${3:-}"
    if [[ -z "${file}" ]]; then
      printf 'usage: pompey-log tail NAME FILE\n' >&2
      exit 2
    fi
    waited=0
    while [[ ! -f "${file}" ]]; do
      sleep 2
      waited=$((waited + 2))
      if [[ "${waited}" -eq 60 ]]; then
        log warning "[${name}] log file not created yet (${file}); still waiting"
      fi
    done
    log info "${name} file log ${file}"
    tail -n +1 -F "${file}" 2>/dev/null | emit_py "${name}"
    ;;
  *)
    printf 'usage: pompey-log start|finish NAME [exitcode] [signal]\n' >&2
    printf '       pompey-log prefix NAME          # stdin → tagged app log\n' >&2
    printf '       pompey-log tail NAME FILE       # follow a file-only logger\n' >&2
    printf '       pompey-log line NAME TEXT\n' >&2
    exit 2
    ;;
esac
