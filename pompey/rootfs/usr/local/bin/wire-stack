#!/usr/bin/env python3
"""Wire localhost engines and Seerr. Idempotent. Secrets never logged.

Required (must succeed or this process exits non-zero so s6 retries, and
the wait screen does not claim search is ready): qBittorrent categories, Arr root
folders and download clients, Prowlarr↔Radarr/Sonarr apps, the operator
source indexer when a URL is configured, Seerr process up (GET /settings/public).
Seerr→Radarr/Sonarr is required after Seerr is initialized. Before that, the
Plex wizard has not created user id 1, so the API key 403s; we still mark
search ready (Seerr is on the published port, Ingress stays Pompey).

Optional (log and continue): Plex login/libraries when PLEX_URL/PLEX_TOKEN
are injected (household uses Seerr's wizard), Seerr local login (403 is
normal until the wizard creates a user), Seerr chrome settings (title,
trustProxy). No source URL yet is also optional — the household adds
sources in Prowlarr (Open sources, :9696).
"""
from __future__ import annotations

import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

EPISODE_KEY_RE = re.compile(r"(?i)S(\d{1,2})E(\d{1,3})")

def secrets_path() -> str:
    return os.environ.get("POMPEY_SECRETS", "/data/pompey/secrets.json")


def ready_dir() -> str:
    return os.environ.get("POMPEY_READY", "/tmp/pompey")


def wait_tries() -> int:
    return int(os.environ.get("POMPEY_WAIT_TRIES", "90"))


def wait_sleep() -> float:
    return float(os.environ.get("POMPEY_WAIT_SLEEP", "2"))


def env(name: str, default: str = "") -> str:
    return os.environ.get(name, default).strip()


def after_download() -> str:
    raw = env("AFTER_DOWNLOAD", "stop_sharing").lower().replace("-", "_").replace(" ", "_")
    if raw in {"share_to_ratio", "ratio"}:
        return "share_to_ratio"
    if raw in {"share_one_day", "one_day"}:
        return "share_one_day"
    return "stop_sharing"


def as_list(value):
    """HTTP JSON is usually an array of objects; stubs and error bodies often are not.

    Do not wrap an error object or a name-only dict as a one-item list.
    That made a failed GET look like "indexer already exists" and skipped setup.
    """
    if isinstance(value, list):
        return [item for item in value if isinstance(item, dict)]
    if isinstance(value, dict):
        if (value.get("message") or value.get("error")) and not any(
            key in value for key in ("id", "implementation", "path", "hostname")
        ):
            return []
        for key in ("results", "records", "data", "items"):
            inner = value.get(key)
            if isinstance(inner, list):
                return as_list(inner)
        if any(key in value for key in ("id", "hostname", "path", "implementation", "owned")):
            return [value]
        return []
    return []


def media_root() -> str:
    return env("MEDIA_ROOT", "/media/dlna").rstrip("/")


def library_dir(env_name: str, default: str) -> str:
    rel = env(env_name, default).replace("\\", "/").strip().strip("/")
    parts = [p for p in rel.split("/") if p]
    if not parts or any(p == ".." for p in parts):
        parts = [p for p in default.replace("\\", "/").strip().strip("/").split("/") if p]
    return f"{media_root()}/{'/'.join(parts)}"


def movies_dir() -> str:
    return library_dir("MEDIA_MOVIES", "Movies/Not Kid Friendly")


def movies_kid_dir() -> str:
    return library_dir("MEDIA_MOVIES_KID", "Movies/Kid Friendly")


def tv_dir() -> str:
    return library_dir("MEDIA_TV", "TV/Not Kid Friendly")


def tv_kid_dir() -> str:
    return library_dir("MEDIA_TV_KID", "TV/Kid Friendly")


def downloads_complete() -> str:
    return f"{media_root()}/downloads/complete"


def downloads_recycle() -> str:
    """Arr recycle bin. Upgrades move the old library file here instead of deleting it."""
    return f"{media_root()}/downloads/recycle"


def library_dirs() -> list[str]:
    return [movies_dir(), movies_kid_dir(), tv_dir(), tv_kid_dir()]


def resolved_path(path: str) -> str:
    full = os.path.normpath((path or "").strip())
    if not full:
        return ""
    if not os.path.isabs(full):
        full = os.path.normpath(os.path.join(media_root(), full))
    return os.path.realpath(full)


def paths_overlap(left: str, right: str) -> bool:
    a = resolved_path(left)
    b = resolved_path(right)
    if not a or not b:
        return False
    return a == b or a.startswith(b + os.sep) or b.startswith(a + os.sep)


def path_is_library(path: str) -> bool:
    full = resolved_path(path)
    if not full:
        return False
    for lib in library_dirs():
        base = resolved_path(lib)
        if full == base or full.startswith(base + os.sep):
            return True
    return False


def complete_overlaps_library() -> bool:
    """True when downloads/complete is a Plex library folder (or a library lives in it)."""
    complete = downloads_complete()
    return any(paths_overlap(complete, lib) for lib in library_dirs())


def safe_to_delete_complete_path(path: str) -> bool:
    """Only leftover files under downloads/complete. Never a Plex library path."""
    if not path or complete_overlaps_library():
        return False
    full = resolved_path(path)
    root = resolved_path(downloads_complete())
    if not full or not root or full == root:
        return False
    if not full.startswith(root + os.sep):
        return False
    if path_is_library(full):
        return False
    return True


def download_scan_paths(kind: str | None = None) -> list[str]:
    """Old qBittorrent categories used complete/radarr and complete/sonarr.

    New wiring sets the category save path to complete/ itself, so in-progress
    files sit in incomplete/ with no category folder. Arr's folder scan of
    complete/ can treat a leftover 'radarr' directory as a title name and never
    look inside it.
    """
    root = downloads_complete()
    paths = [root]
    if kind != "sonarr":
        paths.append(os.path.join(root, "radarr"))
    if kind != "radarr":
        paths.append(os.path.join(root, "sonarr"))
    return paths


def existing_download_scan_paths(kind: str | None = None) -> list[str]:
    if complete_overlaps_library():
        return []
    root = resolved_path(downloads_complete())
    found: list[str] = []
    for path in download_scan_paths(kind):
        if not os.path.isdir(path):
            continue
        full = resolved_path(path)
        if not full.startswith(root + os.sep) and full != root:
            continue
        if path_is_library(path):
            continue
        found.append(path)
    return found


def plex_url() -> str:
    # Not an HA option. Household finishes Plex in Seerr. Tests may inject.
    return env("PLEX_URL")


def plex_token() -> str:
    return env("PLEX_TOKEN")


def indexer_url() -> str:
    # Not an HA option. Household adds sources in Prowlarr. Integration injects.
    return env("INDEXER_URL")


def indexer_api_key() -> str:
    return env("INDEXER_API_KEY")


def qbit_url() -> str:
    return env("QBIT_URL", "http://127.0.0.1:8080").rstrip("/")


def sonarr_url() -> str:
    return env("SONARR_URL", "http://127.0.0.1:8989").rstrip("/")


def radarr_url() -> str:
    return env("RADARR_URL", "http://127.0.0.1:7878").rstrip("/")


def prowlarr_url() -> str:
    return env("PROWLARR_URL", "http://127.0.0.1:9696").rstrip("/")


def prowlarr_arr_url() -> str:
    """Radarr/Sonarr talk to Prowlarr through the title-search caps proxy."""
    return env("PROWLARR_ARR_URL", "http://127.0.0.1:9698").rstrip("/")


def seerr_url() -> str:
    return env("SEERR_URL", "http://127.0.0.1:5055").rstrip("/")


def seerr_config_dir() -> str:
    return env("SEERR_CONFIG") or os.path.join(env("POMPEY_CONFIG", "/config"), "seerr")


def seerr_api_key_from_disk() -> str:
    """Seerr writes main.apiKey on first start. That key is admin; /auth/local is not.

    POST /api/v1/auth/local only signs in an existing local user. The first admin is
    created by the Plex (or Jellyfin) setup wizard. A generated pompey@local password
    therefore 403s on a real Seerr, which is why the wait screen came back after 0.2.13.
    """
    path = os.path.join(seerr_config_dir(), "settings.json")
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError, TypeError):
        return ""
    if not isinstance(data, dict):
        return ""
    main = data.get("main") if isinstance(data.get("main"), dict) else data
    key = main.get("apiKey") if isinstance(main, dict) else None
    return key.strip() if isinstance(key, str) else ""


# Seerr: REQUEST + AUTO_APPROVE + AUTO_APPROVE_MOVIE + AUTO_APPROVE_TV + REQUEST_ADVANCED
# REQUEST_ADVANCED (8192) is what shows the quality-profile dropdown on a request.
SEERR_HOUSEHOLD_PERMS = 32 + 128 + 256 + 512 + 8192
SEERR_REQUEST_ADVANCED = 8192


def log(msg: str, level: str = "INFO") -> None:
    stamp = time.strftime("%H:%M:%S")
    print(f"[{stamp}] {level}: [wire-stack] {msg}", flush=True)


def _quiet_path() -> str:
    return os.path.join(ready_dir(), "log-quiet.json")


def _load_quiet() -> dict:
    try:
        with open(_quiet_path(), encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError, TypeError):
        return {}


def _save_quiet(state: dict) -> None:
    path = _quiet_path()
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(state, fh, sort_keys=True)
    os.replace(tmp, path)


def log_if_new(key: str, msg: str, level: str = "INFO") -> None:
    """Skip a housekeep line that has not changed since the last cycle.

    Housekeep is a new process every few minutes, so this is a small file
    under POMPEY_READY — not in-memory.
    """
    state = _load_quiet()
    if state.get(key) == msg:
        return
    state[key] = msg
    _save_quiet(state)
    log(msg, level)


def forget_quiet(key: str) -> None:
    state = _load_quiet()
    if key not in state:
        return
    state.pop(key, None)
    _save_quiet(state)


def mark_status(step: str, label: str, percent: int, error: str = "") -> None:
    script = shutil.which("pompey-status")
    if not script:
        sibling = os.path.join(os.path.dirname(os.path.abspath(__file__)), "pompey-status")
        if os.path.isfile(sibling):
            script = sibling
    if not script:
        return
    cmd = [sys.executable, script, step, label, str(percent)]
    if error:
        cmd.append(error)
    subprocess.run(cmd, check=False)


def load_secrets() -> dict:
    with open(secrets_path(), encoding="utf-8") as fh:
        return json.load(fh)


def http(method: str, url: str, body=None, headers=None, timeout=30):
    data = None
    hdrs = dict(headers or {})
    if body is not None:
        if isinstance(body, (bytes, bytearray)):
            data = body
            hdrs.setdefault("Content-Type", "application/x-www-form-urlencoded")
        elif isinstance(body, str):
            data = body.encode()
        else:
            data = json.dumps(body).encode()
            hdrs.setdefault("Content-Type", "application/json")
    attempts = 3
    last: Exception | None = None
    for attempt in range(attempts):
        req = urllib.request.Request(url, data=data, method=method, headers=hdrs)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                raw = resp.read()
                if not raw:
                    return None
                text = raw.decode(errors="replace")
                try:
                    return json.loads(text)
                except json.JSONDecodeError:
                    return text
        except urllib.error.HTTPError as exc:
            err = exc.read().decode(errors="replace")
            last = RuntimeError(f"{method} {url} -> {exc.code} {err[:300]}")
            if exc.code in {502, 503, 504} and attempt + 1 < attempts:
                time.sleep(wait_sleep())
                continue
            raise last from exc
        except urllib.error.URLError as exc:
            last = RuntimeError(f"{method} {url} -> {exc}")
            raise last from exc
    raise last or RuntimeError(f"{method} {url} failed")


def wait_http(url: str, tries: int | None = None):
    last = None
    n = wait_tries() if tries is None else tries
    for _ in range(n):
        try:
            req = urllib.request.Request(url, method="GET")
            with urllib.request.urlopen(req, timeout=10) as resp:
                return resp.read()
        except urllib.error.HTTPError as exc:
            if exc.code < 500:
                return b""
            last = exc
        except Exception as exc:  # noqa: BLE001
            last = exc
        time.sleep(wait_sleep())
    raise RuntimeError(f"timeout {url}: {last}")


def arr_headers(api_key: str) -> dict:
    return {"X-Api-Key": api_key, "Content-Type": "application/json"}


def ensure_root_folder(base: str, api_key: str, path: str) -> None:
    if paths_overlap(path, downloads_complete()):
        log(
            f"refusing Arr root folder that overlaps downloads/complete: {path}",
            "ERROR",
        )
        return
    existing = as_list(http("GET", f"{base}/rootfolder", headers=arr_headers(api_key)))
    if any(item.get("path", "").rstrip("/") == path.rstrip("/") for item in existing):
        return
    http("POST", f"{base}/rootfolder", {"path": path}, headers=arr_headers(api_key))
    log(f"root folder {path}")


def schema_impl(schema, name: str):
    for item in as_list(schema):
        if item.get("implementation") == name:
            return json.loads(json.dumps(item))
    raise RuntimeError(f"schema missing {name}")


def fill_fields(resource: dict, values: dict) -> dict:
    for field in resource.get("fields") or []:
        n = field.get("name")
        if n in values:
            field["value"] = values[n]
    return resource


def set_app_fields(resource: dict, values: dict) -> dict:
    """Set Prowlarr application fields, appending any the existing row omitted."""
    fill_fields(resource, values)
    fields = resource.get("fields")
    if not isinstance(fields, list):
        fields = []
        resource["fields"] = fields
    have = {field.get("name") for field in fields}
    for name, value in values.items():
        if name not in have:
            fields.append({"name": name, "value": value})
    return resource


# Newznab movie / TV buckets Prowlarr syncs into Radarr / Sonarr.
RADARR_SYNC_CATS = [2000, 2010, 2020, 2030, 2040, 2045, 2050, 2060, 2070, 2080, 2090]
SONARR_SYNC_CATS = [5000, 5010, 5020, 5030, 5040, 5045, 5050, 5060, 5070, 5080, 5090]
SEARCH_FLAGS = ("enableRss", "enableAutomaticSearch", "enableInteractiveSearch")


def app_field(app: dict, name: str):
    for field in app.get("fields") or []:
        if field.get("name") == name:
            return field.get("value")
    return None


def cats_match(value, want: list[int]) -> bool:
    if not isinstance(value, list):
        return False
    try:
        have = sorted(int(item) for item in value)
    except (TypeError, ValueError):
        return False
    return have == sorted(want)


def sync_cats_for(impl: str) -> list[int]:
    return list(RADARR_SYNC_CATS if impl == "Radarr" else SONARR_SYNC_CATS)


def qbit_client_values(secrets: dict, kind: str) -> tuple[str, dict]:
    cat = "radarr" if kind == "radarr" else "sonarr"
    return cat, {
        "host": "127.0.0.1",
        "port": 8080,
        "username": secrets["qbit_user"],
        "password": secrets["qbit_password"],
        "movieCategory": cat,
        "tvCategory": cat,
        "category": cat,
        "useSsl": False,
    }


def download_client_ready(item: dict, cat: str, remove: bool) -> bool:
    if item.get("removeCompletedDownloads") is not remove:
        return False
    if item.get("removeFailedDownloads") is not True:
        return False
    if item.get("enable") is not True:
        return False
    return cat in {
        app_field(item, "movieCategory"),
        app_field(item, "tvCategory"),
        app_field(item, "category"),
    }


def apply_download_client(item: dict, values: dict, remove: bool) -> dict:
    updated = json.loads(json.dumps(item))
    set_app_fields(updated, values)
    updated["enable"] = True
    updated["removeCompletedDownloads"] = remove
    updated["removeFailedDownloads"] = True
    return updated


def ensure_download_client(base: str, api_key: str, secrets: dict, kind: str) -> None:
    remove = after_download() == "stop_sharing"
    cat, values = qbit_client_values(secrets, kind)
    existing = as_list(http("GET", f"{base}/downloadclient", headers=arr_headers(api_key)))
    for item in existing:
        if item.get("implementation") != "QBittorrent" or item.get("id") is None:
            continue
        if download_client_ready(item, cat, remove):
            return
        updated = apply_download_client(item, values, remove)
        http(
            "PUT",
            f"{base}/downloadclient/{item['id']}",
            updated,
            headers=arr_headers(api_key),
        )
        log(f"{kind} download client category={cat} after_download={after_download()} remove={remove}")
        return
    schema = http("GET", f"{base}/downloadclient/schema", headers=arr_headers(api_key))
    client = apply_download_client(schema_impl(schema, "QBittorrent"), values, remove)
    client["name"] = "qBittorrent"
    client["priority"] = 1
    http("POST", f"{base}/downloadclient", client, headers=arr_headers(api_key))
    log(f"{kind} download client category={cat} after_download={after_download()} remove={remove}")


# Sonarr (and current Radarr) reject 0: "must be greater than or equal to 100".
# skipFreeSpaceCheckWhenImporting is what ignores a NAS that reports 0 bytes free.
MIN_IMPORT_FREE_SPACE = 100


def ensure_media_management(base: str, api_key: str, kind: str) -> None:
    """Import completed torrents into the library folder Seerr asked for.

    Network media shares (this house: /media/dlna) often report 0 free space, so
    Radarr/Sonarr skip import and the file sits in downloads/complete. Auto
    completed-download handling must stay on. Hardlinks do not work on CIFS, and
    the copy fallback is a slow second write — same-share rename (Move) is the
    household path. Do not fail the wait screen if this PUT 400s — quality
    profiles and Seerr still need to wire.
    """
    try:
        cfg = http("GET", f"{base}/config/mediamanagement", headers=arr_headers(api_key))
    except RuntimeError as exc:
        log(f"{kind} media management: {exc}", "WARNING")
        return
    if not isinstance(cfg, dict):
        log(f"{kind} media management missing", "WARNING")
        return
    want = {
        "enableCompletedDownloadHandling": True,
        "skipFreeSpaceCheckWhenImporting": True,
        "minimumFreeSpaceWhenImporting": MIN_IMPORT_FREE_SPACE,
        "copyUsingHardlinks": False,
        "importExtraFiles": True,
        "extraFileExtensions": "srt",
    }
    # Recycle bin is how Arr upgrades avoid permanently deleting a library file
    # (empty recycleBin + ManualImport/CDH upgrade = dest gone if the move fails).
    extra = {
        "recycleBin": downloads_recycle(),
        "recycleBinCleanupDays": 0,
        "deleteEmptyFolders": False,
        "useScriptImport": False,
        "autoUnmonitorPreviouslyDownloadedEpisodes": False,
        "autoUnmonitorPreviouslyDownloadedMovies": False,
    }
    for key, value in extra.items():
        if key in cfg:
            want[key] = value
    recycle = want.get("recycleBin")
    if recycle:
        try:
            os.makedirs(recycle, exist_ok=True)
        except OSError as exc:
            log(f"{kind} recycle folder: {exc}", "WARNING")
    if all(cfg.get(key) == value for key, value in want.items()):
        return
    updated = dict(cfg)
    updated.update(want)
    ident = cfg.get("id", 1)
    try:
        http(
            "PUT",
            f"{base}/config/mediamanagement/{ident}",
            updated,
            headers=arr_headers(api_key),
        )
    except RuntimeError as exc:
        log(f"{kind} media management: {exc}", "WARNING")
        return
    log(
        f"{kind} import into library folders (rename on the NAS, skip free-space check, "
        "old files go to downloads/recycle)"
    )


def tickle_seerr_availability() -> None:
    """Seerr marks requests available from Plex (recently-added ~5 min) and Arr.

    Import into the library folder is not enough by itself — Seerr has to notice
    Plex or Radarr/Sonarr. Ask those jobs to run now instead of waiting.
    """
    key = seerr_api_key_from_disk()
    if not key:
        return
    s = Seerr()
    s.api_key = key
    ran: list[str] = []
    for job in ("plex-recently-added-scan", "radarr-scan", "sonarr-scan"):
        try:
            s.call("POST", f"/api/v1/settings/jobs/{job}/run")
            ran.append(job)
        except RuntimeError as exc:
            if "403" in str(exc):
                return
            log(f"seerr {job}: {exc}", "WARNING")
    if ran:
        log_if_new(
            "seerr-tickle",
            "seerr checking Plex and Arr for titles that landed in the library",
        )


def ensure_download_client_handling(base: str, api_key: str, kind: str) -> None:
    """Keep completed-download handling on. Do not grab the same title again if
    a torrent was dropped before the file was renamed into the library.
    """
    try:
        cfg = http("GET", f"{base}/config/downloadclient", headers=arr_headers(api_key))
    except RuntimeError as exc:
        log(f"{kind} download-client config: {exc}", "WARNING")
        return
    if not isinstance(cfg, dict):
        log(f"{kind} download-client config missing", "WARNING")
        return
    want = {
        "enableCompletedDownloadHandling": True,
        "autoRedownloadFailed": False,
    }
    if "autoRedownloadFailedFromInteractiveSearch" in cfg:
        want["autoRedownloadFailedFromInteractiveSearch"] = False
    if all(cfg.get(key) == value for key, value in want.items()):
        return
    updated = dict(cfg)
    updated.update(want)
    ident = cfg.get("id", 1)
    try:
        http(
            "PUT",
            f"{base}/config/downloadclient/{ident}",
            updated,
            headers=arr_headers(api_key),
        )
    except RuntimeError as exc:
        log(f"{kind} download-client config: {exc}", "WARNING")
        return
    log(f"{kind} completed-download handling on (no auto re-download)")


def refresh_monitored_downloads(base: str, api_key: str, kind: str) -> None:
    http(
        "POST",
        f"{base}/command",
        {"name": "RefreshMonitoredDownloads"},
        headers=arr_headers(api_key),
    )
    key = f"check:{kind}"
    if count_complete_videos() == 0:
        forget_quiet(key)
        return
    log_if_new(key, f"{kind} checking completed downloads")


def log_stuck_imports(base: str, api_key: str, kind: str) -> None:
    """Arr only warns on a failed move. A finished torrent still in complete/ with
    status ok is the silent case: Seerr already handed Arr the library folder,
    qBittorrent never gets that path, and Arr has not started the import yet.
    """
    try:
        payload = http(
            "GET",
            f"{base}/queue?page=1&pageSize=50&includeUnknownMovieItems=true"
            "&includeUnknownSeriesItems=true",
            headers=arr_headers(api_key),
        )
    except RuntimeError as exc:
        log(f"{kind} queue: {exc}", "WARNING")
        return
    records = as_list(payload)
    shown = 0
    for item in records:
        if not queue_needs_import_log(item):
            continue
        bits = []
        for msg in item.get("statusMessages") or []:
            if isinstance(msg, dict):
                title = msg.get("title")
                messages = msg.get("messages") or []
                if title:
                    bits.append(str(title))
                bits.extend(str(part) for part in messages if part)
        extra = (
            "; ".join(bits)
            or item.get("errorMessage")
            or item.get("trackedDownloadState")
            or item.get("trackedDownloadStatus")
            or item.get("status")
            or "still in the download folder"
        )
        dest = item.get("outputPath") or ""
        where = f" qbit={dest}" if dest else ""
        msg = (
            f"{kind} download not in the library yet: {item.get('title')} ({extra}){where}"
        )
        log_if_new(f"stuck:{kind}:{item.get('title')}", msg, "WARNING")
        shown += 1
        if shown >= 15:
            break


def title_library_path(item: dict) -> str:
    path = item.get("path") or item.get("rootFolderPath") or ""
    if isinstance(path, str) and path.strip():
        return path.strip()
    return ""


def title_needs_library_file(item: dict, kind: str) -> bool:
    """True when a monitored title is still missing library video.

    Movies: hasFile is False. Series: monitored episodeCount is greater than
    episodeFileCount (a show with S01 on disk can still be waiting on S02).
    """
    if not isinstance(item, dict) or item.get("monitored") is not True:
        return False
    if kind == "radarr":
        return item.get("hasFile") is False
    stats = item.get("statistics") if isinstance(item.get("statistics"), dict) else {}
    try:
        files = int(stats.get("episodeFileCount") or 0)
        wanted = int(stats.get("episodeCount") or 0)
    except (TypeError, ValueError):
        files, wanted = 0, 0
    if not stats:
        return True
    return wanted > 0 and files < wanted


def log_titles_waiting_for_library(base: str, api_key: str, kind: str) -> None:
    """Show the folder Seerr/Arr already stored. Empty path means the handoff never landed."""
    endpoint = "movie" if kind == "radarr" else "series"
    try:
        rows = as_list(http("GET", f"{base}/{endpoint}", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"{kind} library list: {exc}", "WARNING")
        return
    waiting: list[str] = []
    for item in rows:
        if not title_needs_library_file(item, kind):
            continue
        dest = title_library_path(item) or "NO PATH (Seerr/Arr never stored a library folder)"
        waiting.append(f"{item.get('title')} -> {dest}")
        if len(waiting) >= 10:
            break
    if waiting:
        log_if_new(
            f"wait:{kind}",
            f"{kind} titles with no library file yet: {'; '.join(waiting)}",
            "WARNING",
        )


def parse_arr_time(raw) -> datetime.datetime | None:
    if not isinstance(raw, str) or not raw.strip():
        return None
    text = raw.strip().replace("Z", "+00:00")
    try:
        dt = datetime.datetime.fromisoformat(text)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=datetime.timezone.utc)
    return dt.astimezone(datetime.timezone.utc)


def age_label(raw, now: datetime.datetime | None = None) -> str:
    dt = parse_arr_time(raw)
    if dt is None:
        return ""
    now = now or datetime.datetime.now(datetime.timezone.utc)
    seconds = int((now - dt).total_seconds())
    if seconds < 0:
        seconds = 0
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    hours = seconds // 3600
    if hours < 48:
        return f"{hours}h"
    return f"{hours // 24}d"


def command_search_target(item: dict) -> str:
    body = item.get("body") if isinstance(item.get("body"), dict) else item
    if not isinstance(body, dict):
        return ""
    series = body.get("seriesTitle") or body.get("series")
    if isinstance(series, dict):
        series = series.get("title")
    bits = []
    if isinstance(series, str) and series.strip():
        bits.append(series.strip())
    season = body.get("seasonNumber")
    if season is not None:
        try:
            bits.append(f"S{int(season):02d}")
        except (TypeError, ValueError):
            bits.append(f"S{season}")
    ids = body.get("episodeIds")
    if isinstance(ids, list) and ids:
        bits.append(f"{len(ids)} episode(s)")
    movie = body.get("movieTitle") or body.get("movie")
    if isinstance(movie, dict):
        movie = movie.get("title")
    if isinstance(movie, str) and movie.strip():
        bits.append(movie.strip())
    return " ".join(bits)


def format_arr_command(item: dict, now: datetime.datetime | None = None) -> str:
    name = str(item.get("name") or item.get("commandName") or "command")
    status = str(item.get("status") or "unknown").lower()
    stamp = item.get("started") or item.get("queued") or ""
    age = age_label(stamp, now)
    target = command_search_target(item)
    priority = str(item.get("priority") or "").lower()
    bits = [status, name]
    if age:
        bits.append(age)
    if priority and priority != "normal":
        bits.append(priority)
    if target:
        bits.append(f"({target})")
    return " ".join(bits)


def summarize_arr_commands(rows: list, now: datetime.datetime | None = None) -> str:
    live = []
    for item in rows:
        if not isinstance(item, dict):
            continue
        status = str(item.get("status") or "").lower()
        if status in {"completed", "cancelled", "aborted"}:
            continue
        live.append(format_arr_command(item, now))
    if not live:
        return "none queued or started"
    live = live[:8]
    extra = "" if len(live) < 8 else " …"
    return "; ".join(live) + extra


def missing_episode_label(item: dict) -> str:
    series = item.get("series") if isinstance(item.get("series"), dict) else {}
    show = series.get("title") or item.get("seriesTitle") or item.get("title") or "episode"
    try:
        season = int(item.get("seasonNumber"))
        episode = int(item.get("episodeNumber"))
        return f"{show} S{season:02d}E{episode:02d}"
    except (TypeError, ValueError):
        return str(show)


def count_complete_videos() -> int:
    root = downloads_complete()
    if not os.path.isdir(root):
        return 0
    count = 0
    try:
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [name for name in dirnames if not name.startswith(".")]
            for name in filenames:
                if name.startswith("."):
                    continue
                if is_video_file(name):
                    count += 1
                    if count >= 50:
                        return count
    except OSError:
        return count
    return count


def log_arr_command_queue(base: str, api_key: str, kind: str) -> None:
    """Queue state *before* housekeeping posts more Refresh/Scan commands."""
    try:
        payload = http("GET", f"{base}/command", headers=arr_headers(api_key))
    except RuntimeError as exc:
        log(f"{kind} command queue: {exc}", "WARNING")
        return
    summary = summarize_arr_commands(as_list(payload))
    log(f"{kind} commands: {summary}")


def log_sonarr_missing(base: str, api_key: str) -> None:
    try:
        payload = http(
            "GET",
            f"{base}/wanted/missing?page=1&pageSize=20&sortKey=airDateUtc"
            "&sortDirection=descending",
            headers=arr_headers(api_key),
        )
    except RuntimeError as exc:
        log(f"sonarr wanted/missing: {exc}", "WARNING")
        return
    records = as_list(payload)
    total = len(records)
    if isinstance(payload, dict):
        try:
            total = int(payload.get("totalRecords") or total)
        except (TypeError, ValueError):
            pass
    labels = [missing_episode_label(item) for item in records[:8]]
    shown = ", ".join(labels) if labels else "none"
    extra = "" if total <= 8 else " …"
    log(f"sonarr wanted/missing: {total} ({shown}{extra})")


def log_search_diagnostics(radarr: str, rk: str, sonarr: str, sk: str) -> None:
    """Enough to tell a stalled EpisodeSearch from an empty complete/ scan flood.

    Read these lines *above* any 'checking completed downloads' / 'scanning'
    lines from the same housekeep. Refresh/Scan themselves are skipped when
    complete/ is empty or a search is already running.
    """
    videos = count_complete_videos()
    cap = "+" if videos >= 50 else ""
    log(f"complete/: {videos}{cap} video(s) on disk before Refresh/Scan")
    log_arr_command_queue(radarr, rk, "radarr")
    log_arr_command_queue(sonarr, sk, "sonarr")
    log_sonarr_missing(sonarr, sk)


def queue_needs_import_log(item: dict) -> bool:
    if not isinstance(item, dict):
        return False
    state = str(item.get("trackedDownloadState") or "")
    tracked = str(item.get("trackedDownloadStatus") or "").lower()
    if tracked in {"warning", "error"} or state in {
        "importPending",
        "importBlocked",
        "failed",
        "failedPending",
    }:
        return True
    output = str(item.get("outputPath") or "")
    if output.strip() and path_under_complete(output):
        return True
    return False


def first_profile(base: str, api_key: str):
    profiles = as_list(http("GET", f"{base}/qualityprofile", headers=arr_headers(api_key)))
    if not profiles:
        raise RuntimeError(f"no quality profiles at {base}")
    return int(profiles[0]["id"]), profiles[0].get("name") or "Default"


# Three Seerr-selectable names. Recyclarr/TRaSH owns Default and Max (qualities,
# sizes, scores). Pompey only creates those names if they are missing, and owns
# Anything (CAM allowed). Do not PUT Default/Max items — that was a second TRaSH.
PROFILE_DEFAULT = "Default"
PROFILE_MAX = "Max"
PROFILE_ANYTHING = "Anything"
PROFILE_NAMES = (PROFILE_DEFAULT, PROFILE_MAX, PROFILE_ANYTHING)
LEGACY_DEFAULT_NAMES = ("HD", "Any")
# Title CFs. Scores are per-profile; -10000 is a hard reject.
CUSTOM_FORMATS = (
    (
        "Pompey Reject CAM/TS",
        r"(CAMRip|HDCAM|TELESYNC|HDTS|TELECINE|HDTC|WORKPRINT|[-_.]CAM[-_.])",
    ),
    (
        "Pompey Reject Remux/DISK",
        r"\b(REMUX|BD[-_. ]?DISK|BRDISK|COMPLETE[-_. ]?BLURAY)\b",
    ),
    ("Pompey Prefer WEB-DL", r"\bWEB[-_. ]?DL\b"),
    ("Pompey Prefer x265", r"\b(x265|h265|HEVC)\b"),
    ("Pompey Prefer Proper", r"\b(PROPER|REPACK|RERIP)\b"),
    ("Pompey Prefer Remux", r"\bREMUX\b"),
    (
        "Pompey Prefer lossless audio",
        r"\b(TrueHD|TRUEHD|DTS[-_. ]?HD(?:MA)?|DTS[-_. ]?X|Atmos|ATMOS|FLAC|LPCM)\b",
    ),
    (
        "Pompey Dual Audio",
        r"\b(Dual[-_. ]Audio|DUAL[-_. ]AUDIO|DualAudio|Multi[-_. ]Audio)\b",
    ),
)

# Arr language id -2 is the title's original audio (TMDB / series metadata).
NOT_ORIGINAL_LANGUAGE = "Pompey Not Original Language"


def quality_catalog(profile: dict) -> dict:
    catalog = {}
    for item in profile.get("items") or []:
        if not isinstance(item, dict):
            continue
        q = item.get("quality")
        if isinstance(q, dict) and q.get("name"):
            catalog[str(q["name"])] = q
        for child in item.get("items") or []:
            if not isinstance(child, dict):
                continue
            cq = child.get("quality")
            if isinstance(cq, dict) and cq.get("name"):
                catalog[str(cq["name"])] = cq
    return catalog


def quality_id_of(value) -> int | None:
    if isinstance(value, dict):
        try:
            return int(value["id"])
        except (KeyError, TypeError, ValueError):
            return None
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def group_id_state(profiles: list[dict]) -> dict:
    """Arr rejects quality groups with id 0 ('Groups must have an ID'). Reuse ids."""
    by_name: dict[str, int] = {}
    used: set[int] = set()
    for profile in profiles:
        if not isinstance(profile, dict):
            continue
        for item in profile.get("items") or []:
            if not isinstance(item, dict) or isinstance(item.get("quality"), dict):
                continue
            gid = quality_id_of(item)
            if gid in (None, 0):
                continue
            used.add(gid)
            name = item.get("name")
            if name:
                by_name.setdefault(str(name), gid)
    nxt = 1000
    while nxt in used:
        nxt += 1
    return {"by_name": by_name, "used": used, "next": nxt}


def take_group_id(state: dict, name: str) -> int:
    have = state["by_name"].get(name)
    if have:
        return int(have)
    gid = int(state["next"])
    used = state["used"]
    while gid in used:
        gid += 1
    used.add(gid)
    state["by_name"][name] = gid
    state["next"] = gid + 1
    return gid


def rebuild_profile_items(
    catalog: dict,
    groups: tuple,
    allow_unlisted: bool = False,
    id_state: dict | None = None,
) -> list[dict]:
    used: set[str] = set()
    items: list[dict] = []
    grouped = {n for _name, names in groups for n in names}
    ids = id_state if id_state is not None else group_id_state([])
    for group_name, names in groups:
        present = [catalog[n] for n in names if n in catalog]
        if not present:
            continue
        used.update(n for n in names if n in catalog)
        if len(present) == 1 and present[0].get("name") == group_name:
            items.append({"quality": present[0], "items": [], "allowed": True})
            continue
        items.append(
            {
                "id": take_group_id(ids, group_name),
                "name": group_name,
                "allowed": True,
                "items": [{"quality": q, "items": [], "allowed": True} for q in present],
            }
        )
    for name, q in catalog.items():
        if name in used:
            continue
        allowed = allow_unlisted and name != "BR-DISK" and name not in grouped
        items.append({"quality": q, "items": [], "allowed": allowed})
    return items


def title_custom_format(name: str, regex: str) -> dict:
    return {
        "name": name,
        "includeCustomFormatWhenRenaming": False,
        "specifications": [
            {
                "name": name,
                "implementation": "ReleaseTitleSpecification",
                "negate": False,
                "required": True,
                "fields": [{"name": "value", "value": regex}],
            }
        ],
    }


def not_original_language_format() -> dict:
    """Arr-native original-audio filter (TRaSH Language: Not Original).

    Score -10000 on Default/Max so a French dub of an English title loses to
    the original, while a French film still matches its original audio. Anything
    does not use this reject. HA has no language picker — Seerr does not either.
    """
    return {
        "name": NOT_ORIGINAL_LANGUAGE,
        "includeCustomFormatWhenRenaming": False,
        "specifications": [
            {
                "name": "Not Original Language",
                "implementation": "LanguageSpecification",
                "negate": True,
                "required": False,
                "fields": [{"name": "value", "value": -2}],
            }
        ],
    }


def household_custom_formats() -> list[dict]:
    rows = [title_custom_format(name, regex) for name, regex in CUSTOM_FORMATS]
    rows.append(not_original_language_format())
    return rows


def household_format_scores(tier: str) -> dict[str, int]:
    """Per-profile CF scores. Default/Max scores are Recyclarr's once it syncs.

    On a name stub (Recyclarr missing) we only attach original-audio reject.
    Anything takes CAM; Prefer Proper is a mild tie-break.
    """
    if tier in {PROFILE_DEFAULT, PROFILE_MAX}:
        return {NOT_ORIGINAL_LANGUAGE: -10000}
    return {"Pompey Prefer Proper": 10}


def ensure_custom_formats(base: str, api_key: str) -> list[dict]:
    """Upsert household title CFs. Returns the Arr custom-format list (all of them)."""
    try:
        existing = as_list(http("GET", f"{base}/customformat", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"custom formats: {exc}", "WARNING")
        return []
    by_name = {item.get("name"): item for item in existing if item.get("name")}
    for payload in household_custom_formats():
        name = payload.get("name")
        have = by_name.get(name)
        try:
            if have and have.get("id") is not None:
                payload["id"] = have["id"]
                saved = http(
                    "PUT",
                    f"{base}/customformat/{have['id']}",
                    payload,
                    headers=arr_headers(api_key),
                )
            else:
                saved = http(
                    "POST",
                    f"{base}/customformat",
                    payload,
                    headers=arr_headers(api_key),
                )
            saved_id = (saved or {}).get("id") if isinstance(saved, dict) else None
            if saved_id is None and have:
                saved_id = have.get("id")
            if saved_id is not None:
                stored = dict(payload)
                stored["id"] = int(saved_id)
                by_name[name] = stored
        except RuntimeError as exc:
            log(f"custom format {name}: {exc}", "WARNING")
    try:
        latest = as_list(http("GET", f"{base}/customformat", headers=arr_headers(api_key)))
        if latest:
            return latest
    except RuntimeError as exc:
        log(f"custom formats after upsert: {exc}", "WARNING")
    return [item for item in by_name.values() if isinstance(item, dict)]


def format_items_for(tier: str, formats: list[dict]) -> list[dict]:
    """Arr requires every custom format on the profile, including score 0."""
    scores = household_format_scores(tier)
    items = []
    for fmt in formats:
        if not isinstance(fmt, dict):
            continue
        name = fmt.get("name")
        fid = fmt.get("id")
        if not name or fid is None:
            continue
        items.append({"format": int(fid), "name": str(name), "score": int(scores.get(name, 0))})
    return items


def top_level_cutoff_id(item: dict) -> int | None:
    """ValidCutoff matches top-level quality.id or group id, not nested children."""
    q = item.get("quality") if isinstance(item.get("quality"), dict) else None
    if q is not None:
        return quality_id_of(q)
    gid = quality_id_of(item)
    if gid in (None, 0):
        return None
    return gid


def cutoff_names_of(item: dict) -> list[str]:
    names: list[str] = []
    q = item.get("quality") if isinstance(item.get("quality"), dict) else None
    if q and q.get("name"):
        names.append(str(q["name"]))
        return names
    if item.get("name"):
        names.append(str(item["name"]))
    for child in item.get("items") or []:
        if not isinstance(child, dict):
            continue
        cq = child.get("quality") if isinstance(child.get("quality"), dict) else None
        if cq and cq.get("name"):
            names.append(str(cq["name"]))
    return names


def cutoff_id_from_items(items: list[dict], preferred: tuple[str, ...], fallback=None) -> int | None:
    allowed: list[tuple[list[str], int]] = []
    for item in items:
        if not isinstance(item, dict) or not item.get("allowed"):
            continue
        cid = top_level_cutoff_id(item)
        if cid is None:
            continue
        allowed.append((cutoff_names_of(item), cid))
    for want in preferred:
        for names, cid in allowed:
            if want in names:
                return cid
    fb = quality_id_of(fallback)
    if fb is not None and any(cid == fb for _names, cid in allowed):
        return fb
    if allowed:
        return allowed[0][1]
    return fb


def pick_default_profile(profiles: list[dict]) -> dict:
    by_name = {item.get("name"): item for item in profiles if item.get("name")}
    for name in (PROFILE_DEFAULT, *LEGACY_DEFAULT_NAMES):
        if name in by_name:
            return by_name[name]
    return profiles[0]


def quality_schema(base: str, api_key: str) -> dict | None:
    try:
        schema = http("GET", f"{base}/qualityprofile/schema", headers=arr_headers(api_key))
    except RuntimeError as exc:
        log(f"quality profile schema: {exc}", "WARNING")
        return None
    return schema if isinstance(schema, dict) else None


def quality_catalog_for(base: str, api_key: str, profiles: list[dict]) -> dict:
    catalog: dict = {}
    schema = quality_schema(base, api_key)
    if schema:
        catalog.update(quality_catalog(schema))
    for item in profiles:
        catalog.update(quality_catalog(item))
    return catalog


def profile_id_by_name(base: str, api_key: str, name: str) -> int | None:
    try:
        profiles = as_list(http("GET", f"{base}/qualityprofile", headers=arr_headers(api_key)))
    except RuntimeError:
        return None
    for item in profiles:
        if item.get("name") == name and item.get("id") is not None:
            try:
                return int(item["id"])
            except (TypeError, ValueError):
                return None
    return None


def profile_id_from_save(saved, name: str, base: str, api_key: str) -> int | None:
    if isinstance(saved, dict) and saved.get("id") is not None:
        try:
            return int(saved["id"])
        except (TypeError, ValueError):
            pass
    if isinstance(saved, int):
        return saved
    return profile_id_by_name(base, api_key, name)


def prepare_quality_payload(
    template: dict,
    name: str,
    items: list[dict],
    cutoff_id: int | None,
    format_items: list[dict],
    upgrade_allowed: bool,
) -> dict:
    payload = json.loads(json.dumps(template))
    payload.pop("id", None)
    payload["name"] = name
    payload["items"] = items
    payload["upgradeAllowed"] = upgrade_allowed
    if cutoff_id is not None:
        payload["cutoff"] = cutoff_id
    payload["minFormatScore"] = 0
    payload["cutoffFormatScore"] = 10000 if upgrade_allowed else 0
    payload["formatItems"] = format_items
    # Language CFs (original audio) only work when the profile language is Any.
    if "language" in payload:
        payload["language"] = {"id": -1, "name": "Any"}
    try:
        min_up = int(payload.get("minUpgradeFormatScore") or 0)
    except (TypeError, ValueError):
        min_up = 0
    payload["minUpgradeFormatScore"] = min_up if min_up >= 1 else 1
    return payload


def upsert_quality_profile(
    base: str,
    api_key: str,
    name: str,
    template: dict,
    items: list[dict],
    cutoff_id: int | None,
    format_items: list[dict],
    upgrade_allowed: bool,
    existing: dict | None,
) -> int:
    payload = prepare_quality_payload(
        template, name, items, cutoff_id, format_items, upgrade_allowed
    )
    if existing and existing.get("id") is not None:
        payload["id"] = existing["id"]
        try:
            http(
                "PUT",
                f"{base}/qualityprofile/{existing['id']}",
                payload,
                headers=arr_headers(api_key),
            )
            return int(existing["id"])
        except RuntimeError as exc:
            log(f"quality profile {name} PUT: {exc}", "WARNING")
            payload.pop("id", None)
    try:
        saved = http(
            "POST",
            f"{base}/qualityprofile",
            payload,
            headers=arr_headers(api_key),
        )
    except RuntimeError as exc:
        found = profile_id_by_name(base, api_key, name)
        if found is not None:
            log(f"quality profile {name} POST: {exc}; using existing id {found}", "WARNING")
            return found
        raise RuntimeError(f"quality profile {name}: {exc}") from exc
    saved_id = profile_id_from_save(saved, name, base, api_key)
    if saved_id is None:
        raise RuntimeError(f"quality profile {name} POST returned no id")
    return int(saved_id)


def drop_extra_quality_profiles(base: str, api_key: str) -> None:
    """Seerr lists every Arr profile in the request dropdown. Keep only the three."""
    try:
        profiles = as_list(http("GET", f"{base}/qualityprofile", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"quality profiles after upsert: {exc}", "WARNING")
        return
    have = {item.get("name") for item in profiles}
    if not set(PROFILE_NAMES) <= have:
        log(
            f"keeping leftover quality profiles until Max/Default/Anything all exist "
            f"(have {sorted(n for n in have if n)})",
            "WARNING",
        )
        return
    for item in profiles:
        name = item.get("name")
        pid = item.get("id")
        if name in PROFILE_NAMES or pid is None:
            continue
        try:
            http(
                "DELETE",
                f"{base}/qualityprofile/{pid}",
                headers=arr_headers(api_key),
            )
            log(f"removed leftover quality profile {name}")
        except RuntimeError as exc:
            log(f"could not remove quality profile {name}: {exc}", "WARNING")


def recyclarr_marker() -> str:
    return os.path.join(ready_dir(), "recyclarr")


def recyclarr_is_fresh() -> bool:
    """True when Recyclarr already synced recently. Skip a redundant sync."""
    path = recyclarr_marker()
    if not os.path.isfile(path):
        return False
    try:
        max_age = float(env("POMPEY_RECYCLARR_MAX_AGE", "86400") or "86400")
    except ValueError:
        max_age = 86400.0
    try:
        return (time.time() - os.path.getmtime(path)) < max_age
    except OSError:
        return False


def recyclarr_sync_script() -> str:
    override = env("POMPEY_RECYCLARR_SYNC")
    if override:
        return override
    here = os.path.dirname(os.path.abspath(__file__))
    sibling = os.path.join(here, "recyclarr-sync")
    if os.path.isfile(sibling):
        return sibling
    return "/usr/local/bin/recyclarr-sync"


def recyclarr_binary() -> str:
    override = env("POMPEY_RECYCLARR")
    if override:
        return override
    return os.path.join(env("POMPEY_ENGINES", "/data/engines"), "recyclarr")


def run_recyclarr(*, force: bool = False) -> bool:
    """Sync TRaSH onto Default/Max. Failures leave name stubs until Recyclarr can sync."""
    if not force and recyclarr_is_fresh():
        return True
    binary = recyclarr_binary()
    if not os.path.isfile(binary) or not os.access(binary, os.X_OK):
        log_if_new(
            "recyclarr-missing",
            "Recyclarr binary not on disk; Default/Max stay name stubs until Recyclarr can sync",
        )
        return False
    script = recyclarr_sync_script()
    if not os.path.isfile(script):
        log(
            "Recyclarr sync script missing; Default/Max stay name stubs until Recyclarr can sync",
            "WARNING",
        )
        return False
    try:
        proc = subprocess.run(
            [sys.executable, script],
            check=False,
            timeout=int(env("POMPEY_RECYCLARR_TIMEOUT", "600") or "600"),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        log(f"Recyclarr: {exc}", "WARNING")
        return False
    if proc.returncode != 0:
        return False
    os.makedirs(ready_dir(), exist_ok=True)
    marker = recyclarr_marker()
    with open(marker, "w", encoding="utf-8") as fh:
        fh.write("ok\n")
    return True


def profile_id_of(item: dict) -> int | None:
    try:
        if item.get("id") is not None:
            return int(item["id"])
    except (TypeError, ValueError):
        return None
    return None


def household_quality_profile(base: str, api_key: str, kind: str):
    """Max (4K encode), Default (1080p encode), Anything (take what exists)."""
    try:
        return apply_household_quality_profiles(base, api_key, kind)
    except RuntimeError as exc:
        log(f"{kind} quality profiles: {exc}", "WARNING")
        return first_profile(base, api_key)


def ensure_seerr_profile_name(
    base: str,
    api_key: str,
    name: str,
    template: dict,
    formats: list[dict],
    existing: dict | None,
) -> int | None:
    """Create Default/Max if missing. Never PUT items — Recyclarr owns those."""
    pid = profile_id_of(existing or {})
    if pid is not None:
        return pid
    items = json.loads(json.dumps(template.get("items") or []))
    if not items:
        raise RuntimeError(f"quality profile {name}: template has no items")
    cutoff = cutoff_id_from_items(items, (), template.get("cutoff"))
    return upsert_quality_profile(
        base,
        api_key,
        name,
        template,
        items,
        cutoff,
        format_items_for(name, formats),
        True,
        None,
    )


def apply_household_quality_profiles(base: str, api_key: str, kind: str):
    profiles = as_list(http("GET", f"{base}/qualityprofile", headers=arr_headers(api_key)))
    if not profiles:
        raise RuntimeError(f"no quality profiles at {base}")
    template = pick_default_profile(profiles)
    catalog = quality_catalog_for(base, api_key, profiles)
    if not catalog:
        catalog = quality_catalog(template)
        if not catalog:
            for item in profiles:
                catalog = quality_catalog(item)
                if catalog:
                    template = item
                    break
    if not catalog:
        log(f"{kind} quality profile has no qualities listed; leaving defaults", "WARNING")
        return int(template["id"]), template.get("name") or PROFILE_DEFAULT

    formats = ensure_custom_formats(base, api_key)
    by_name = {item.get("name"): item for item in profiles if item.get("name")}
    ids = group_id_state(profiles + ([template] if template else []))

    default_id = None
    stubbed: list[str] = []
    try:
        had_default = PROFILE_DEFAULT in by_name
        default_id = ensure_seerr_profile_name(
            base,
            api_key,
            PROFILE_DEFAULT,
            template,
            formats,
            by_name.get(PROFILE_DEFAULT),
        )
        if not had_default and default_id is not None:
            stubbed.append(PROFILE_DEFAULT)
    except RuntimeError as exc:
        log(f"{kind} quality profile {PROFILE_DEFAULT}: {exc}", "WARNING")
    try:
        had_max = PROFILE_MAX in by_name
        max_id = ensure_seerr_profile_name(
            base,
            api_key,
            PROFILE_MAX,
            template,
            formats,
            by_name.get(PROFILE_MAX),
        )
        if not had_max and max_id is not None:
            stubbed.append(PROFILE_MAX)
    except RuntimeError as exc:
        log(f"{kind} quality profile {PROFILE_MAX}: {exc}", "WARNING")
    if stubbed:
        log(
            f"{kind} quality profile name stub(s) {', '.join(stubbed)} until Recyclarr can sync"
        )
    elif PROFILE_DEFAULT in by_name and PROFILE_MAX in by_name:
        log(f"{kind} quality profiles {PROFILE_DEFAULT}/{PROFILE_MAX} left to Recyclarr")

    anything_items = rebuild_profile_items(catalog, (), allow_unlisted=True, id_state=ids)
    try:
        upsert_quality_profile(
            base,
            api_key,
            PROFILE_ANYTHING,
            template,
            anything_items,
            cutoff_id_from_items(
                anything_items,
                ("CAM", "WEBDL-480p", "WEBDL-720p", "WEBDL-1080p"),
                template.get("cutoff"),
            ),
            format_items_for(PROFILE_ANYTHING, formats),
            False,
            by_name.get(PROFILE_ANYTHING),
        )
    except RuntimeError as exc:
        log(f"{kind} quality profile {PROFILE_ANYTHING}: {exc}", "WARNING")
    drop_extra_quality_profiles(base, api_key)
    try:
        now = as_list(http("GET", f"{base}/qualityprofile", headers=arr_headers(api_key)))
    except RuntimeError:
        now = []
    have = {item.get("name") for item in now}
    if default_id is None:
        default_id = profile_id_by_name(base, api_key, PROFILE_DEFAULT)
    if set(PROFILE_NAMES) <= have:
        log(
            f"{kind} quality profiles: {PROFILE_MAX} (4K encode), "
            f"{PROFILE_DEFAULT} (1080p encode), {PROFILE_ANYTHING} (take anything)"
        )
    else:
        log(
            f"{kind} quality profiles incomplete (have {sorted(n for n in have if n)})",
            "WARNING",
        )
    if default_id is None:
        return first_profile(base, api_key)
    return default_id, PROFILE_DEFAULT


def language_profile_id(_base: str, _api_key: str):
    # Sonarr v4 dropped language profiles. GET /languageprofile is deprecated and
    # warned on every wire retry (Python-urllib) while doing no work for our 4.0.x.
    return None


def ensure_prowlarr_app(prowlarr: str, pkey: str, name: str, impl: str, base_url: str, api_key: str) -> None:
    want = prowlarr_arr_url()
    want_cats = sync_cats_for(impl)
    values = {
        "prowlarrUrl": want,
        "baseUrl": base_url,
        "apiKey": api_key,
        "syncCategories": want_cats,
    }
    apps = as_list(http("GET", f"{prowlarr}/api/v1/applications", headers=arr_headers(pkey)))
    for existing in apps:
        if existing.get("name") != name:
            continue
        current = str(app_field(existing, "prowlarrUrl") or "").rstrip("/")
        current_cats = app_field(existing, "syncCategories")
        if current == want and cats_match(current_cats, want_cats):
            return
        if existing.get("id") is None:
            return
        updated = json.loads(json.dumps(existing))
        set_app_fields(updated, {"prowlarrUrl": want, "syncCategories": want_cats})
        http(
            "PUT",
            f"{prowlarr}/api/v1/applications/{existing['id']}",
            updated,
            headers=arr_headers(pkey),
        )
        log(f"prowlarr app {name} Arr URL {want} cats {want_cats[0]}s")
        return
    schema = http("GET", f"{prowlarr}/api/v1/applications/schema", headers=arr_headers(pkey))
    app = schema_impl(schema, impl)
    set_app_fields(app, values)
    app["name"] = name
    app["syncLevel"] = "fullSync"
    app["tags"] = []
    http("POST", f"{prowlarr}/api/v1/applications", app, headers=arr_headers(pkey))
    log(f"prowlarr app {name}")


def ensure_indexer(prowlarr: str, pkey: str) -> None:
    if not indexer_url():
        log("no source URL configured yet")
        return
    indexers = as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
    if indexers:
        return
    schema = http("GET", f"{prowlarr}/api/v1/indexer/schema", headers=arr_headers(pkey))
    impl = "Newznab" if "newznab" in indexer_url().lower() else "Torznab"
    try:
        indexer = schema_impl(schema, impl)
    except RuntimeError:
        indexer = schema_impl(schema, "Newznab" if impl == "Torznab" else "Torznab")
    fill_fields(
        indexer,
        {
            "baseUrl": indexer_url().rstrip("/"),
            "apiPath": "/api",
            "apiKey": indexer_api_key(),
        },
    )
    indexer["name"] = "Source"
    indexer["enable"] = True
    indexer["enableRss"] = True
    indexer["enableAutomaticSearch"] = True
    indexer["enableInteractiveSearch"] = True
    indexer["priority"] = 25
    indexer["appProfileId"] = 1
    indexer["tags"] = []
    http("POST", f"{prowlarr}/api/v1/indexer", indexer, headers=arr_headers(pkey))
    log("added source")


def sync_prowlarr_indexers(prowlarr: str, pkey: str) -> None:
    """Push every enabled Prowlarr source into Radarr/Sonarr and say how many exist.

    Pompey does not pick which indexer to query — Arr asks Prowlarr, and Prowlarr
    fans out to every source that is enabled for that search type and category.
    Household sources are added in Prowlarr's UI; we still sync so Arr sees them.
    Enabled sources with search switched off would be skipped on the next request.
    """
    indexers = as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
    for item in indexers:
        if not item.get("enable") or item.get("id") is None:
            continue
        if all(item.get(key) is True for key in SEARCH_FLAGS):
            continue
        detail = item
        try:
            fetched = http(
                "GET",
                f"{prowlarr}/api/v1/indexer/{item['id']}",
                headers=arr_headers(pkey),
            )
            if isinstance(fetched, dict) and fetched.get("id") is not None:
                detail = fetched
        except RuntimeError:
            pass
        if all(detail.get(key) is True for key in SEARCH_FLAGS):
            continue
        for key in SEARCH_FLAGS:
            detail[key] = True
        name = detail.get("name") or item.get("name") or "unnamed"
        try:
            http(
                "PUT",
                f"{prowlarr}/api/v1/indexer/{item['id']}",
                detail,
                headers=arr_headers(pkey),
            )
            log(f"Prowlarr source {name} search flags turned on")
        except RuntimeError as exc:
            log(f"Prowlarr source {name} could not enable search: {exc}", "WARNING")
    indexers = as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
    enabled = [item for item in indexers if item.get("enable")]
    log(f"Prowlarr sources: {len(enabled)} enabled / {len(indexers)} total")
    for item in indexers:
        name = item.get("name") or "unnamed"
        on = "on" if item.get("enable") else "off"
        rss, auto, interactive = (item.get(key) for key in SEARCH_FLAGS)
        if item.get("enable") and any(flag is not True for flag in (rss, auto, interactive)):
            try:
                fetched = http(
                    "GET",
                    f"{prowlarr}/api/v1/indexer/{item['id']}",
                    headers=arr_headers(pkey),
                )
                if isinstance(fetched, dict):
                    rss, auto, interactive = (fetched.get(key) for key in SEARCH_FLAGS)
            except RuntimeError:
                pass
        log(
            f"Prowlarr source {name} {on} "
            f"rss={rss} auto={auto} interactive={interactive}"
        )
    http(
        "POST",
        f"{prowlarr}/api/v1/command",
        {"name": "ApplicationIndexerSync"},
        headers=arr_headers(pkey),
    )
    log("prowlarr sync")


def log_arr_vs_prowlarr_indexers(
    radarr: str, radarr_key: str, sonarr: str, sonarr_key: str, prowlarr: str, pkey: str
) -> None:
    """Warn when Prowlarr sync left Radarr/Sonarr with fewer sources than Prowlarr has."""
    try:
        enabled = [
            item
            for item in as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
            if item.get("enable")
        ]
    except RuntimeError as exc:
        log(f"could not list Prowlarr sources after sync: {exc}", "WARNING")
        return
    names = {(item.get("name") or "").strip() for item in enabled if item.get("name")}
    for kind, base, key in (("Radarr", radarr, radarr_key), ("Sonarr", sonarr, sonarr_key)):
        try:
            arr = as_list(http("GET", f"{base}/indexer", headers=arr_headers(key)))
        except RuntimeError as exc:
            log(f"could not list {kind} indexers: {exc}", "WARNING")
            continue
        active = [item for item in arr if item.get("enable") is not False]
        log(f"{kind} indexers: {len(active)} (Prowlarr enabled {len(enabled)})")
        arr_names = {(item.get("name") or "").strip() for item in active if item.get("name")}
        missing = sorted(name for name in names if name not in arr_names)
        extra = sorted(name for name in arr_names if name not in names)
        if missing:
            log(
                f"{kind} is missing Prowlarr source(s): {', '.join(missing)}. "
                "Those sources will not run for Seerr requests (Prowlarr often refuses "
                "to sync when a category test returns top100 / CloudFlare).",
                "WARNING",
            )
        if extra:
            log(f"{kind} extra indexer(s) not in Prowlarr: {', '.join(extra)}")


def history_data_map(record: dict) -> dict[str, str]:
    raw = record.get("data") if isinstance(record, dict) else None
    if not isinstance(raw, dict):
        return {}
    out: dict[str, str] = {}
    for key, val in raw.items():
        if val is None or val == "":
            continue
        out[str(key).lower()] = str(val)
    return out


def describe_prowlarr_history_row(record: dict, indexer_names: dict | None = None) -> str:
    """Say whether History Query was empty because of IMDb/TMDB, RSS, or a true blank."""
    names = indexer_names or {}
    indexer = record.get("indexer") if isinstance(record, dict) else None
    if isinstance(indexer, dict) and indexer.get("name"):
        name = str(indexer.get("name"))
    else:
        idx = record.get("indexerId") if isinstance(record, dict) else None
        try:
            name = names.get(int(idx)) or f"indexer {idx}"
        except (TypeError, ValueError):
            name = str(indexer or "indexer")
    event = record.get("eventType") if isinstance(record, dict) else None
    event_s = str(event or "").lower()
    data = history_data_map(record if isinstance(record, dict) else {})
    query = (data.get("query") or "").strip()
    qtype = (data.get("querytype") or "").strip() or "search"
    source = (data.get("source") or "").strip()
    ids = []
    if data.get("imdbid"):
        ids.append(f"IMDb {data['imdbid']}")
    if data.get("tmdbid"):
        ids.append(f"TMDb {data['tmdbid']}")
    if data.get("tvdbid"):
        ids.append(f"TVDb {data['tvdbid']}")
    id_bit = " ".join(ids)
    via = f" via {source}" if source else ""
    url = (data.get("url") or "").lower()
    if "top100" in url or "top-100" in url or "top_100" in url:
        return f"{name}{via} browse/top100 (not the Seerr title)"
    if event in (3, "indexerRss", "IndexerRss") or event_s == "indexerrss":
        return f"{name}{via} RSS (no title term)"
    if id_bit and not query:
        return f"{name}{via} {qtype} {id_bit} (Query empty — ID search)"
    if id_bit and query:
        return f"{name}{via} {qtype} {id_bit} q={query!r}"
    if query:
        return f"{name}{via} {qtype} q={query!r}"
    return f"{name}{via} {qtype} empty query (no IDs)"


def log_recent_prowlarr_searches(prowlarr: str, pkey: str) -> None:
    """Dump recent History rows so an empty Query is not mistaken for a blank search."""
    try:
        indexers = as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
        names = {}
        for item in indexers:
            try:
                names[int(item["id"])] = item.get("name") or f"indexer {item['id']}"
            except (TypeError, ValueError, KeyError):
                continue
        payload = http(
            "GET",
            f"{prowlarr}/api/v1/history?page=1&pageSize=40&sortKey=date&sortDirection=descending",
            headers=arr_headers(pkey),
        )
        records = as_list(payload)
        shown = 0
        for record in records:
            event = record.get("eventType")
            event_s = str(event or "").lower()
            if event not in (2, 3, "indexerQuery", "indexerRss", "IndexerQuery", "IndexerRss") and event_s not in {
                "indexerquery",
                "indexerrss",
            }:
                continue
            log(f"Prowlarr history {describe_prowlarr_history_row(record, names)}")
            shown += 1
            if shown >= 20:
                break
        if shown:
            log(
                f"Prowlarr history: {shown} recent search(es). "
                "Empty Query plus IMDb/TMDb is ID search (keep it). "
                "Empty Query with no IDs is RSS or a true blank."
            )
    except RuntimeError as exc:
        log(f"could not read Prowlarr history: {exc}", "WARNING")


SEARCH_COMMAND_NAMES = {
    "EpisodeSearch",
    "MoviesSearch",
    "SeasonSearch",
    "SeriesSearch",
}


def arr_search_in_flight(base: str, api_key: str) -> bool:
    try:
        rows = as_list(http("GET", f"{base}/command", headers=arr_headers(api_key)))
    except RuntimeError:
        return False
    for item in rows:
        if not isinstance(item, dict):
            continue
        if item.get("name") not in SEARCH_COMMAND_NAMES:
            continue
        if str(item.get("status") or "").lower() in {"started", "queued"}:
            return True
    return False


def retry_unfilled_titles(radarr: str, radarr_key: str, sonarr: str, sonarr_key: str) -> None:
    """Search monitored titles that still have no file. Seerr already handed off.

    A request that searched too few indexers stays approved in Seerr; Arr will
    not try again until RSS or a missing-search cycle unless we ask.
    One poke per missing-id set so housekeep does not re-search every 5 minutes.
    """
    if arr_search_in_flight(radarr, radarr_key) or arr_search_in_flight(sonarr, sonarr_key):
        return
    try:
        movies = as_list(http("GET", f"{radarr}/movie", headers=arr_headers(radarr_key)))
        movie_ids = [
            int(item["id"])
            for item in movies
            if item.get("monitored") is True
            and item.get("hasFile") is False
            and item.get("id") is not None
        ][:8]
        token = ",".join(str(i) for i in movie_ids)
        if movie_ids and _load_quiet().get("retry-movies") != token:
            http(
                "POST",
                f"{radarr}/command",
                {"name": "MoviesSearch", "movieIds": movie_ids},
                headers=arr_headers(radarr_key),
            )
            state = _load_quiet()
            state["retry-movies"] = token
            _save_quiet(state)
            log(f"searching again for {len(movie_ids)} movie(s) still missing a file")
    except RuntimeError as exc:
        log(f"could not retry movie search: {exc}", "WARNING")
    try:
        missing = http(
            "GET",
            f"{sonarr}/wanted/missing?pageSize=8",
            headers=arr_headers(sonarr_key),
        )
        records = as_list(missing)
        episode_ids = [
            int(item["id"])
            for item in records
            if item.get("id") is not None
        ][:8]
        token = ",".join(str(i) for i in episode_ids)
        if episode_ids and _load_quiet().get("retry-episodes") != token:
            http(
                "POST",
                f"{sonarr}/command",
                {"name": "EpisodeSearch", "episodeIds": episode_ids},
                headers=arr_headers(sonarr_key),
            )
            state = _load_quiet()
            state["retry-episodes"] = token
            _save_quiet(state)
            log(f"searching again for {len(episode_ids)} missing episode(s)")
    except RuntimeError as exc:
        if "404" not in str(exc):
            log(f"could not retry episode search: {exc}", "WARNING")


def qbit_category(name: str, save_path: str) -> None:
    data = urllib.parse.urlencode({"category": name, "savePath": save_path}).encode()
    try:
        http("POST", f"{qbit_url()}/api/v2/torrents/createCategory", data)
        log(f"qbit category {name} -> {save_path}")
    except RuntimeError as exc:
        # 409 = category already exists. Point it at complete/ anyway.
        if "409" in str(exc) or "already" in str(exc).lower():
            http("POST", f"{qbit_url()}/api/v2/torrents/editCategory", data)
            return
        raise


def qbit_torrents_url() -> str:
    return f"{qbit_url()}/api/v2/torrents/{'info'}"


def qbit_delete_url() -> str:
    return f"{qbit_url()}/api/v2/torrents/delete"


def qbit_stop_url() -> str:
    return f"{qbit_url()}/api/v2/torrents/{'stop'}"


def qbit_pause_url() -> str:
    return f"{qbit_url()}/api/v2/torrents/{'pause'}"


# Recheck/move is transient. missingFiles means the payload left (Arr import or a
# hand move). Leaving that torrent in qBittorrent is what re-downloads it.
QBIT_TRANSIENT = {
    "moving",
    "checkingDL",
    "checkingUP",
    "checkingResumeData",
    "allocating",
    "metaDL",
}
QBIT_STOPPED = {
    "pausedUP",
    "pausedDL",
    "stoppedUP",
    "stoppedDL",
}


VIDEO_EXTENSIONS = {
    ".mkv",
    ".mp4",
    ".avi",
    ".m4v",
    ".ts",
    ".m2ts",
    ".wmv",
    ".mov",
    ".webm",
    ".iso",
}


def is_video_file(name: str) -> bool:
    return os.path.splitext(name)[1].lower() in VIDEO_EXTENSIONS


def video_episode_key(name: str) -> str:
    match = EPISODE_KEY_RE.search(name or "")
    if not match:
        return ""
    return f"S{int(match.group(1)):02d}E{int(match.group(2)):02d}"


def library_has_this_release(dest: str, source_name: str) -> bool:
    """True when the library folder already has this movie or this SxxExx."""
    if not dest or not os.path.isdir(dest):
        return False
    key = video_episode_key(source_name)
    try:
        for dirpath, dirnames, filenames in os.walk(dest):
            dirnames[:] = [name for name in dirnames if not name.startswith(".")]
            for name in filenames:
                if name.startswith(".") or not is_video_file(name):
                    continue
                if key:
                    if video_episode_key(name) == key:
                        return True
                    continue
                return True
    except OSError:
        return False
    return False


def path_has_video(path: str) -> bool:
    """True when a movie/episode file is still on disk (sidecars do not count)."""
    if not os.path.exists(path):
        return False
    if os.path.isfile(path):
        return is_video_file(os.path.basename(path))
    try:
        for dirpath, dirnames, filenames in os.walk(path):
            dirnames[:] = [name for name in dirnames if not name.startswith(".")]
            for name in filenames:
                if name.startswith("."):
                    continue
                if is_video_file(name):
                    return True
    except OSError:
        return True
    return False


def qbit_payload_gone(item: dict) -> bool:
    """True when the torrent's video is not on disk (moved into the library).

    Leftover .srt/.nfo/.txt next to an already-imported title do not keep the
    torrent alive — those extras are not the library file.
    """
    path = item.get("content_path")
    if not isinstance(path, str) or not path.strip():
        return str(item.get("state") or "") == "missingFiles"
    path = path.strip()
    if not os.path.exists(path):
        return True
    return not path_has_video(path)


def qbit_is_finished(item: dict) -> bool:
    try:
        progress = float(item.get("progress") or 0)
    except (TypeError, ValueError):
        progress = 0.0
    try:
        left = float(item.get("amount_left") or 1)
    except (TypeError, ValueError):
        left = 1.0
    return progress >= 0.999 or left == 0


def qbit_should_forget(item: dict, gone: bool | None = None) -> bool:
    """Drop the qBittorrent row only. Never delete files (library may be a hardlink)."""
    if not isinstance(item, dict):
        return False
    state = str(item.get("state") or "")
    if state in QBIT_TRANSIENT:
        return False
    if gone is None:
        gone = qbit_payload_gone(item)
    if state == "missingFiles":
        return True
    return bool(gone and qbit_is_finished(item))


def path_under_complete(path: str) -> bool:
    root = os.path.normpath(downloads_complete())
    full = os.path.normpath(path.strip())
    if not os.path.isabs(full):
        full = os.path.normpath(os.path.join(root, full))
    return full == root or full.startswith(root + os.sep)


def qbit_should_unlock(item: dict) -> bool:
    """Stop a finished torrent whose files still sit in complete/ so Arr can rename."""
    if not isinstance(item, dict):
        return False
    state = str(item.get("state") or "")
    if state in QBIT_TRANSIENT or state in QBIT_STOPPED:
        return False
    if state == "missingFiles" or qbit_payload_gone(item):
        return False
    if not qbit_is_finished(item):
        return False
    path = item.get("content_path") or item.get("save_path") or ""
    if not isinstance(path, str) or not path.strip():
        return False
    return path_under_complete(path)


def qbit_forget_torrents(hashes: list[str]) -> None:
    if not hashes:
        return
    data = urllib.parse.urlencode(
        {"hashes": "|".join(hashes), "deleteFiles": "false"}
    ).encode()
    http("POST", qbit_delete_url(), data)


def qbit_stop_torrents(hashes: list[str]) -> None:
    """qBittorrent 5 uses stop; 4.x still has pause. Never delete files."""
    if not hashes:
        return
    data = urllib.parse.urlencode({"hashes": "|".join(hashes)}).encode()
    try:
        http("POST", qbit_stop_url(), data)
        return
    except RuntimeError:
        http("POST", qbit_pause_url(), data)


def unlock_completed_torrents() -> None:
    """Release the CIFS lock on finished files so Arr can rename them into the library."""
    try:
        payload = http("GET", qbit_torrents_url())
    except RuntimeError as exc:
        log(f"qbit torrents: {exc}", "WARNING")
        return
    rows = payload if isinstance(payload, list) else []
    hashes: list[str] = []
    for item in rows:
        if not qbit_should_unlock(item):
            continue
        digest = item.get("hash")
        if digest:
            hashes.append(str(digest))
    if not hashes:
        return
    try:
        qbit_stop_torrents(hashes)
    except RuntimeError as exc:
        log(f"qbit stop completed: {exc}", "WARNING")
        return
    log(
        f"qbit stopped {len(hashes)} finished torrent(s) so Arr can rename "
        "into the library (torrent kept; files kept)"
    )


def forget_moved_torrents() -> None:
    """If the file already left complete/, drop the torrent so it cannot re-download."""
    try:
        payload = http("GET", qbit_torrents_url())
    except RuntimeError as exc:
        log(f"qbit torrents: {exc}", "WARNING")
        return
    rows = payload if isinstance(payload, list) else []
    hashes: list[str] = []
    for item in rows:
        if not isinstance(item, dict) or not qbit_should_forget(item):
            continue
        digest = item.get("hash")
        if digest:
            hashes.append(str(digest))
    if not hashes:
        return
    try:
        qbit_forget_torrents(hashes)
    except RuntimeError as exc:
        log(f"qbit forget moved: {exc}", "WARNING")
        return
    log(
        f"qbit dropped {len(hashes)} torrent(s) whose files were already moved "
        "(torrent only; library files kept)"
    )


def scan_download_drop(base: str, api_key: str, kind: str) -> None:
    """Import files Arr can match to a title it already has (Seerr's library folder).

    Destination is the movie/series path on Arr, not a guess from the filename.
    Kid vs Not Kid was stored when Seerr added the title.
    """
    name = "DownloadedMoviesScan" if kind == "radarr" else "DownloadedEpisodesScan"
    for path in existing_download_scan_paths(kind):
        try:
            http(
                "POST",
                f"{base}/command",
                {"name": name, "path": path, "importMode": "Move"},
                headers=arr_headers(api_key),
            )
            scan_key = f"scan:{kind}:{path}"
            if count_complete_videos() == 0:
                forget_quiet(scan_key)
            else:
                log_if_new(
                    scan_key,
                    f"{kind} scanning {path} for files that already have an Arr library folder",
                )
        except RuntimeError as exc:
            log(f"{kind} complete-folder scan {path}: {exc}", "WARNING")


def import_rejection_text(item: dict) -> str:
    bits = []
    for rej in item.get("rejections") or []:
        if isinstance(rej, dict):
            bits.append(str(rej.get("reason") or rej.get("message") or rej))
        elif rej:
            bits.append(str(rej))
    return "; ".join(bit for bit in bits if bit)


def nested_arr_record(item: dict, kind: str) -> dict:
    key = "movie" if kind == "radarr" else "series"
    nested = item.get(key)
    return nested if isinstance(nested, dict) else {}


def arr_record_id(item: dict, kind: str):
    nested = nested_arr_record(item, kind)
    if kind == "radarr":
        return item.get("movieId") or nested.get("id")
    return item.get("seriesId") or nested.get("id")


def episode_ids_of(item: dict) -> list:
    wanted = item.get("episodeIds")
    if not isinstance(wanted, list):
        wanted = [
            ep.get("id")
            for ep in item.get("episodes") or []
            if isinstance(ep, dict) and ep.get("id")
        ]
    return [eid for eid in wanted if eid]


def fetch_arr_record(base: str, api_key: str, kind: str, ident):
    path = "movie" if kind == "radarr" else "series"
    return http("GET", f"{base}/{path}/{ident}", headers=arr_headers(api_key))


def each_arr(radarr: str, rk: str, sonarr: str, sk: str):
    return (("radarr", radarr, rk), ("sonarr", sonarr, sk))


def arr_import_destination(item: dict, kind: str) -> str:
    """Library folder Arr already has (Seerr's Kid / Not Kid choice), not the filename."""
    return title_library_path(nested_arr_record(item, kind))


def arr_already_has_library_file(item: dict, kind: str) -> bool:
    """True when Arr already assigned a library file. Do not ManualImport again.

    Re-importing a title that hasFile deletes the library copy (no recycle bin)
    and the subtitle extras that came with it.
    """
    if kind == "radarr":
        return nested_arr_record(item, kind).get("hasFile") is True
    episodes = item.get("episodes") if isinstance(item.get("episodes"), list) else []
    if not episodes:
        return False
    return all(isinstance(ep, dict) and ep.get("hasFile") is True for ep in episodes)


def lookup_arr_has_file(base: str, api_key: str, kind: str, item: dict) -> bool:
    """GET /manualimport often omits hasFile even after CDH already imported."""
    if arr_already_has_library_file(item, kind):
        return True
    ident = arr_record_id(item, kind)
    if not ident:
        return False
    try:
        if kind == "radarr":
            row = fetch_arr_record(base, api_key, kind, ident)
            return isinstance(row, dict) and row.get("hasFile") is True
        rows = as_list(
            http(
                "GET",
                f"{base}/episode?seriesId={ident}",
                headers=arr_headers(api_key),
            )
        )
        wanted_ids = set(episode_ids_of(item))
        if not wanted_ids:
            return False
        matched = [
            ep
            for ep in rows
            if isinstance(ep, dict) and ep.get("id") in wanted_ids
        ]
        return bool(matched) and all(ep.get("hasFile") is True for ep in matched)
    except RuntimeError:
        return False


EXPECTED_CROSS_KIND_REJECT = ("unknown series", "unknown movie")


def is_expected_cross_kind_reject(reason: str) -> bool:
    low = reason.strip().lower()
    return any(low == bit or low.startswith(bit) for bit in EXPECTED_CROSS_KIND_REJECT)


def release_dir_under_complete(path: str) -> str:
    """Torrent folder under complete/ (or complete/radarr), not complete/ itself."""
    root = os.path.normpath(downloads_complete())
    full = os.path.normpath(path.strip())
    if os.path.isfile(full) or (
        not os.path.isdir(full) and os.path.splitext(full)[1]
    ):
        full = os.path.dirname(full)
    if not path_under_complete(full) or full == root:
        return ""
    category = {
        os.path.normpath(os.path.join(root, "radarr")),
        os.path.normpath(os.path.join(root, "sonarr")),
    }
    while True:
        parent = os.path.dirname(full)
        if parent == root or parent in category:
            return full
        if parent == full:
            return ""
        full = parent


def library_dir_has_video(path: str) -> bool:
    return bool(path) and os.path.isdir(path) and path_has_video(path)


def remove_complete_release(release_dir: str, reason: str) -> None:
    if not release_dir or not os.path.isdir(release_dir):
        return
    if not safe_to_delete_complete_path(release_dir):
        return
    try:
        shutil.rmtree(release_dir)
    except OSError as exc:
        log(f"could not remove leftover complete/ folder: {exc}", "WARNING")
        return
    log(f"removed leftover complete/ folder ({reason})")


def remove_complete_leftover(path: str, reason: str) -> None:
    """Drop a leftover video sitting loose in complete/, or its torrent folder."""
    if not path:
        return
    full = os.path.normpath(path.strip())
    if not safe_to_delete_complete_path(full):
        return
    root = os.path.normpath(downloads_complete())
    if os.path.isfile(full):
        try:
            os.remove(full)
        except OSError as exc:
            log(f"could not remove leftover complete/ file: {exc}", "WARNING")
            return
        log(f"removed leftover complete/ file ({reason}): {os.path.basename(full)}")
        parent = os.path.dirname(full)
        if parent != root and os.path.isdir(parent) and not path_has_video(parent):
            remove_complete_release(parent, reason)
        return
    remove_complete_release(release_dir_under_complete(full) or full, reason)


def prune_complete_extras() -> None:
    """Arr imports the video (+ srt) into the library folder, not the torrent dump."""
    root = downloads_complete()
    if not os.path.isdir(root) or complete_overlaps_library():
        return
    removed = 0

    def consider(folder: str) -> None:
        nonlocal removed
        if not os.path.isdir(folder):
            return
        if not safe_to_delete_complete_path(folder):
            return
        if path_has_video(folder):
            return
        try:
            shutil.rmtree(folder)
        except OSError:
            return
        removed += 1

    try:
        names = [name for name in os.listdir(root) if not name.startswith(".")]
    except OSError:
        return
    for name in names:
        full = os.path.join(root, name)
        if name in ("radarr", "sonarr") and os.path.isdir(full):
            try:
                children = [
                    child for child in os.listdir(full) if not child.startswith(".")
                ]
            except OSError:
                continue
            for child in children:
                consider(os.path.join(full, child))
            continue
        consider(full)
    if removed:
        log(
            f"removed {removed} leftover complete/ folder(s) "
            "(extras only; library files kept)"
        )


def lookup_arr_library_path(base: str, api_key: str, kind: str, row: dict) -> str:
    ident = arr_record_id(row, kind)
    if not ident:
        return ""
    try:
        rec = fetch_arr_record(base, api_key, kind, ident)
        return title_library_path(rec if isinstance(rec, dict) else {})
    except RuntimeError:
        return ""


def manual_import_file(item: dict, kind: str) -> dict | None:
    path = item.get("path")
    if not isinstance(path, str) or not path.strip():
        return None
    quality = item.get("quality")
    if not isinstance(quality, dict):
        return None
    languages = item.get("languages") if isinstance(item.get("languages"), list) else []
    row = {
        "path": path,
        "quality": quality,
        "languages": languages,
        "downloadId": item.get("downloadId") or "",
        "releaseGroup": item.get("releaseGroup") or "",
    }
    if kind == "radarr":
        movie_id = arr_record_id(item, kind)
        if not movie_id:
            return None
        row["movieId"] = movie_id
        return row
    series_id = arr_record_id(item, kind)
    episode_ids = episode_ids_of(item)
    if not series_id or not episode_ids:
        return None
    row["seriesId"] = series_id
    row["episodeIds"] = episode_ids
    return row


def import_matched_drop(base: str, api_key: str, kind: str) -> None:
    """Rename matched files Arr already approved. Log why the rest stay in complete/."""
    seen: set[str] = set()
    files: list[dict] = []
    for folder in existing_download_scan_paths(kind):
        query = urllib.parse.urlencode(
            {"folder": folder, "filterExistingFiles": "false"}
        )
        try:
            payload = http(
                "GET",
                f"{base}/manualimport?{query}",
                headers=arr_headers(api_key),
            )
        except RuntimeError as exc:
            log(f"{kind} manual import list {folder}: {exc}", "WARNING")
            continue
        for item in as_list(payload):
            path = item.get("path")
            if not isinstance(path, str) or path in seen:
                continue
            seen.add(path)
            rejected = import_rejection_text(item)
            if rejected:
                if not is_expected_cross_kind_reject(rejected):
                    log(
                        f"{kind} will not import {os.path.basename(path)}: {rejected}",
                        "WARNING",
                    )
                continue
            dest = arr_import_destination(item, kind) or lookup_arr_library_path(
                base, api_key, kind, item
            )
            if path_is_library(path) or not path_under_complete(path):
                log(
                    f"{kind} skipped import of {path} "
                    "(not a leftover under downloads/complete)",
                    "WARNING",
                )
                continue
            if dest and library_has_this_release(dest, os.path.basename(path)):
                log_if_new(
                    f"hasfile:{kind}:{os.path.basename(path)}",
                    f"{kind} already has a library file for "
                    f"{os.path.basename(path)} -> {dest} "
                    "(not re-importing leftover complete/ files)",
                )
                remove_complete_leftover(path, "title already in the library")
                continue
            if lookup_arr_has_file(base, api_key, kind, item):
                dest = dest or "Arr title path"
                log(
                    f"{kind} marks hasFile for {os.path.basename(path)} but "
                    f"{dest} does not have this video; importing leftover"
                )
            row = manual_import_file(item, kind)
            if not row:
                log_if_new(
                    f"nomatch:{kind}:{os.path.basename(path)}",
                    f"{kind} no library match for {os.path.basename(path)} "
                    "(not guessing Kid vs Not Kid from the name)",
                    "WARNING",
                )
                continue
            dest = dest or lookup_arr_library_path(base, api_key, kind, row)
            dest = dest or "Arr title path"
            log(
                f"{kind} importing {os.path.basename(path)} into {dest} "
                "(Arr record from Seerr, not the filename)"
            )
            files.append(row)
    if not files:
        return
    try:
        http(
            "POST",
            f"{base}/command",
            {"name": "ManualImport", "files": files, "importMode": "Move"},
            headers=arr_headers(api_key),
        )
        log(f"{kind} renaming {len(files)} file(s) into the library")
    except RuntimeError as exc:
        log(f"{kind} manual import: {exc}", "WARNING")


def log_complete_drop_contents() -> None:
    """Warn only when a video is still under complete/. Sidecars are not the title."""
    root = downloads_complete()
    if not os.path.isdir(root):
        log(f"complete folder is missing: {root}", "WARNING")
        return
    videos: list[str] = []
    extras = 0
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [name for name in dirnames if not name.startswith(".")]
        for name in filenames:
            if name.startswith("."):
                continue
            if not is_video_file(name):
                extras += 1
                continue
            full = os.path.join(dirpath, name)
            rel = os.path.relpath(full, root)
            try:
                size = os.path.getsize(full)
            except OSError:
                size = -1
            videos.append(f"{rel} ({size} bytes)")
            if len(videos) >= 20:
                break
        if len(videos) >= 20:
            break
    if videos:
        extra = " …" if len(videos) >= 20 else ""
        log_if_new(
            "complete-videos",
            f"still in complete/: {'; '.join(videos)}{extra}",
            "WARNING",
        )
        return
    if extras:
        log(
            f"complete/ leftovers are extras only ({extras} srt/nfo/txt file(s)); "
            "titles already in the library"
        )
        return
    try:
        names = [name for name in os.listdir(root) if not name.startswith(".")]
    except OSError as exc:
        log(f"complete folder unreadable: {exc}", "WARNING")
        return
    if names:
        log(f"complete/ has folders but no files yet: {', '.join(names[:20])}", "WARNING")


class Seerr:
    def __init__(self, base: str | None = None):
        self.base = (base or seerr_url()).rstrip("/")
        self.cookie = ""
        self.api_key = ""

    def _headers(self) -> dict:
        headers = {"Content-Type": "application/json"}
        if self.cookie:
            headers["Cookie"] = self.cookie
        if self.api_key:
            headers["X-API-Key"] = self.api_key
        return headers

    def call(self, method: str, path: str, body=None):
        req = urllib.request.Request(
            self.base + path,
            data=None if body is None else json.dumps(body).encode(),
            method=method,
            headers=self._headers(),
        )
        try:
            with urllib.request.urlopen(req, timeout=45) as resp:
                cookies = []
                if hasattr(resp.headers, "get_all"):
                    cookies = resp.headers.get_all("Set-Cookie") or []
                elif resp.headers.get("Set-Cookie"):
                    cookies = [resp.headers.get("Set-Cookie")]
                for cookie in cookies:
                    self.cookie = cookie.split(";", 1)[0]
                raw = resp.read()
                if not raw:
                    return None
                text = raw.decode(errors="replace")
                try:
                    return json.loads(text)
                except json.JSONDecodeError:
                    return text
        except urllib.error.HTTPError as exc:
            err = exc.read().decode(errors="replace")
            raise RuntimeError(f"seerr {method} {path} -> {exc.code} {err[:400]}") from exc


def parse_plex(url: str):
    u = urllib.parse.urlparse(url)
    host = u.hostname or "127.0.0.1"
    port = u.port or (443 if u.scheme == "https" else 32400)
    ssl = u.scheme == "https"
    return host, port, ssl


def pick_plex_server(servers, host: str):
    candidates = []
    for srv in as_list(servers):
        provides = srv.get("provides") or []
        if isinstance(provides, str):
            provides = [provides]
        if "server" not in provides and provides:
            continue
        candidates.append(srv)
    owned = [s for s in candidates if s.get("owned")]
    pool = owned or candidates
    host_l = (host or "").lower()
    for srv in pool:
        for conn in as_list(srv.get("connection") or srv.get("connections")):
            addr = (conn.get("address") or "").lower()
            if addr == host_l:
                return srv
    return pool[0] if pool else None


def configure_seerr(secrets: dict, radarr_profile, sonarr_profile, sonarr_lang) -> None:
    s = Seerr()
    for _ in range(wait_tries()):
        try:
            s.call("GET", "/api/v1/settings/public")
            break
        except Exception:  # noqa: BLE001
            time.sleep(wait_sleep())
    else:
        raise RuntimeError("Seerr never became ready")

    s.api_key = seerr_api_key_from_disk()
    have_plex = bool(plex_url() and plex_token())
    if not have_plex:
        log("Plex URL/token missing; Seerr setup wizard will be used for Plex")

    if have_plex:
        try:
            s.call("POST", "/api/v1/auth/plex", {"authToken": plex_token()})
            log("seerr signed in with Plex token")
        except RuntimeError as exc:
            log(f"seerr plex login: {exc}", "WARNING")
            have_plex = False

    email = secrets.get("seerr_email") or "pompey@local"
    password = secrets.get("seerr_password") or ""
    # Disk API key is admin. POST /auth/local with the generated pompey@local
    # password 403s and Seerr logs "invalid Seerr password" on every wire retry.
    if password and not s.cookie and not s.api_key:
        try:
            s.call(
                "POST",
                "/api/v1/auth/local",
                {"email": email, "password": password, "name": "Pompey"},
            )
            log("seerr signed in with local account")
        except RuntimeError as exc:
            # Real Seerr: no local user until the wizard (or a later password). 403 is expected.
            log(f"seerr local login: {exc}", "WARNING")

    if not s.api_key:
        try:
            main = s.call("GET", "/api/v1/settings/main") or {}
            if isinstance(main, dict) and main.get("apiKey"):
                s.api_key = main["apiKey"]
        except RuntimeError as exc:
            log(f"seerr api key: {exc}", "WARNING")
        if not s.api_key:
            s.api_key = seerr_api_key_from_disk()

    def public_initialized() -> bool:
        public = s.call("GET", "/api/v1/settings/public") or {}
        return isinstance(public, dict) and bool(public.get("initialized"))

    initialized = public_initialized()

    if have_plex:
        host, port, ssl = parse_plex(plex_url())
        try:
            servers = as_list(s.call("GET", "/api/v1/settings/plex/devices/servers"))
            chosen = pick_plex_server(servers, host)
            payload = {
                "ip": host,
                "port": port,
                "useSsl": ssl,
                "webAppUrl": plex_url().rstrip("/"),
            }
            if chosen:
                payload["name"] = chosen.get("name") or "Plex"
                payload["machineId"] = chosen.get("clientIdentifier") or ""
            else:
                payload["name"] = "Plex"
                payload["machineId"] = "unknown"
            s.call("POST", "/api/v1/settings/plex", payload)
            log("plex settings")
        except RuntimeError as exc:
            log(f"plex settings: {exc}", "WARNING")

        try:
            s.call("POST", "/api/v1/settings/plex/library/sync")
            libs = as_list(s.call("GET", "/api/v1/settings/plex/library"))
            for lib in libs:
                lib_id = lib.get("id")
                if not lib_id:
                    continue
                try:
                    s.call("PUT", f"/api/v1/settings/plex/library/{lib_id}", {"enabled": True})
                except RuntimeError as exc:
                    log(f"plex library {lib_id}: {exc}", "WARNING")
            log("plex libraries enabled")
        except RuntimeError as exc:
            log(f"plex libraries: {exc}", "WARNING")

    radarr_id, radarr_name = radarr_profile
    sonarr_id, sonarr_name = sonarr_profile
    radarr_payload = {
        "name": "Radarr",
        "hostname": "127.0.0.1",
        "port": 7878,
        "apiKey": secrets["radarr_api_key"],
        "useSsl": False,
        "activeProfileId": radarr_id,
        "activeProfileName": radarr_name,
        "activeDirectory": movies_dir(),
        "isDefault": True,
        "is4k": False,
        "minimumAvailability": "released",
        "syncEnabled": True,
        "preventSearch": False,
        "tagRequests": True,
        "urlBase": "",
        "externalUrl": "",
        "tags": [],
    }
    sonarr_payload = {
        "name": "Sonarr",
        "hostname": "127.0.0.1",
        "port": 8989,
        "apiKey": secrets["sonarr_api_key"],
        "useSsl": False,
        "activeProfileId": sonarr_id,
        "activeProfileName": sonarr_name,
        "activeDirectory": tv_dir(),
        "isDefault": True,
        "is4k": False,
        "enableSeasonFolders": True,
        "syncEnabled": True,
        "preventSearch": False,
        "tagRequests": True,
        "urlBase": "",
        "externalUrl": "",
        "tags": [],
    }
    if sonarr_lang is not None:
        sonarr_payload["activeLanguageProfileId"] = sonarr_lang

    def upsert_arr(kind: str, payload: dict) -> bool:
        path = f"/api/v1/settings/{kind}"
        try:
            existing = as_list(s.call("GET", path))
            match = next(
                (item for item in existing if item.get("hostname") == "127.0.0.1"),
                None,
            )
            if match:
                want = (payload.get("activeDirectory") or "").rstrip("/")
                have = (match.get("activeDirectory") or "").rstrip("/")
                server_id = match.get("id")
                dir_changed = bool(want and want != have)
                profile_changed = (
                    match.get("activeProfileId") != payload.get("activeProfileId")
                    or (match.get("activeProfileName") or "") != (payload.get("activeProfileName") or "")
                )
                if server_id is not None and (dir_changed or profile_changed):
                    update = dict(match)
                    update.update(payload)
                    # Seerr OpenAPI marks id read-only; it belongs in the URL.
                    update.pop("id", None)
                    s.call("PUT", f"{path}/{server_id}", update)
                    if dir_changed:
                        log(f"seerr {kind} directory {want}")
                    if profile_changed:
                        log(f"seerr {kind} profile {payload.get('activeProfileName')}")
                return True
            s.call("POST", path, payload)
            log(f"seerr {kind}")
            return True
        except RuntimeError as exc:
            # API key impersonates user id 1. That row does not exist until the
            # wizard creates the first admin, so settings 403. Hand off anyway.
            if "403" in str(exc) and not initialized:
                log(f"seerr {kind} waits until the Plex wizard creates the first admin")
                return False
            if "403" in str(exc):
                raise RuntimeError("seerr has no Radarr/Sonarr after initialize") from exc
            raise

    wired_arr = upsert_arr("radarr", radarr_payload)
    wired_arr = upsert_arr("sonarr", sonarr_payload) or wired_arr
    if wired_arr:
        open(os.path.join(ready_dir(), "seerr-arr"), "w").close()
    elif initialized:
        raise RuntimeError("seerr has no Radarr/Sonarr after initialize")

    try:
        s.call(
            "POST",
            "/api/v1/settings/main",
            {
                "applicationTitle": "Pompey",
                "applicationUrl": "",
                "defaultPermissions": SEERR_HOUSEHOLD_PERMS,
                "hideAvailable": False,
                "localLogin": True,
                "newPlexLogin": True,
            },
        )
    except RuntimeError as exc:
        log(f"seerr main settings: {exc}", "WARNING")

    try:
        users = s.call("GET", "/api/v1/user") or {}
        rows = as_list(users)
        if isinstance(users, dict) and not rows:
            rows = as_list(users.get("results") or users.get("users") or [])
        for user in rows:
            uid = user.get("id")
            if uid is None:
                continue
            try:
                perms = int(user.get("permissions") or 0)
            except (TypeError, ValueError):
                continue
            if perms & SEERR_REQUEST_ADVANCED:
                continue
            update = dict(user)
            update["permissions"] = perms | SEERR_REQUEST_ADVANCED
            try:
                s.call("PUT", f"/api/v1/user/{uid}", update)
            except RuntimeError as exc:
                log(f"seerr user {uid} permissions: {exc}", "WARNING")
    except RuntimeError as exc:
        log(f"seerr users: {exc}", "WARNING")

    try:
        s.call("POST", "/api/v1/settings/network", {"trustProxy": False})
    except RuntimeError as exc:
        log(f"seerr network: {exc}", "WARNING")

    public = s.call("GET", "/api/v1/settings/public") or {}
    already = isinstance(public, dict) and public.get("initialized")
    if already:
        return
    if have_plex:
        s.call("POST", "/api/v1/settings/initialize")
        log("seerr initialized")
    else:
        log("seerr left uninitialized so the Plex setup wizard can run")


def main() -> int:
    secrets = load_secrets()
    wait_http(f"{qbit_url()}/api/v2/app/version")
    wait_http(f"{prowlarr_url()}/ping")
    wait_http(f"{sonarr_url()}/ping")
    wait_http(f"{radarr_url()}/ping")

    sonarr = f"{sonarr_url()}/api/v3"
    radarr = f"{radarr_url()}/api/v3"
    prowlarr = prowlarr_url()
    sk, rk, pk = secrets["sonarr_api_key"], secrets["radarr_api_key"], secrets["prowlarr_api_key"]

    complete = downloads_complete()
    qbit_category("sonarr", complete)
    qbit_category("radarr", complete)
    ensure_root_folder(sonarr, sk, tv_dir())
    ensure_root_folder(sonarr, sk, tv_kid_dir())
    ensure_root_folder(radarr, rk, movies_dir())
    ensure_root_folder(radarr, rk, movies_kid_dir())
    ensure_download_client(sonarr, sk, secrets, "sonarr")
    ensure_download_client(radarr, rk, secrets, "radarr")
    # Recyclarr writes Default/Max before we create name stubs, so a successful
    # sync is not overwritten by a stock Arr clone. Quality still runs before
    # import settings so a Sonarr media-management 400 cannot leave Seerr on
    # stock Any / HD-720p and hang the wait screen.
    run_recyclarr()
    sp = household_quality_profile(sonarr, sk, "sonarr")
    rp = household_quality_profile(radarr, rk, "radarr")
    for kind, base, key in each_arr(radarr, rk, sonarr, sk):
        ensure_media_management(base, key, kind)
        ensure_download_client_handling(base, key, kind)
    ensure_prowlarr_app(prowlarr, pk, "Sonarr", "Sonarr", sonarr_url(), sk)
    ensure_prowlarr_app(prowlarr, pk, "Radarr", "Radarr", radarr_url(), rk)
    ensure_indexer(prowlarr, pk)
    sync_prowlarr_indexers(prowlarr, pk)
    log_arr_vs_prowlarr_indexers(radarr, rk, sonarr, sk, prowlarr, pk)
    import_finished_downloads(radarr, rk, sonarr, sk)
    log_recent_prowlarr_searches(prowlarr, pk)

    sl = language_profile_id(sonarr, sk)

    os.makedirs(ready_dir(), exist_ok=True)
    open(os.path.join(ready_dir(), "arr-wired"), "w").close()

    configure_seerr(secrets, rp, sp, sl)
    tickle_seerr_availability()
    port = os.environ.get("SEERR_PORT", "5055")
    sources = os.environ.get("PROWLARR_PORT", "9696")
    log(f"search is on 0.0.0.0:{port}; sources on 0.0.0.0:{sources}; Ingress stays Pompey")
    mark_status("ready", "Ready", 100)
    open(os.path.join(ready_dir(), "wired"), "w").close()
    log("done")
    return 0


def import_finished_downloads(radarr: str, rk: str, sonarr: str, sk: str) -> None:
    """Stop finished torrents, rename into the library, drop leftover complete/ files.

    Same path for movies and TV. Destination is the Arr title folder Seerr stored.
    Refresh is skipped when complete/ is empty or a search is already running —
    those commands are higher priority than EpisodeSearch and starve the rest
    of a season. Missing-title retry runs after import so housekeep also pokes.
    """
    log_search_diagnostics(radarr, rk, sonarr, sk)
    unlock_completed_torrents()
    engines = each_arr(radarr, rk, sonarr, sk)
    if complete_overlaps_library():
        log(
            "downloads/complete overlaps a library folder; "
            "not scanning or deleting leftovers (Plex library kept)",
            "ERROR",
        )
        for kind, base, key in engines:
            log_stuck_imports(base, key, kind)
            log_titles_waiting_for_library(base, key, kind)
        retry_unfilled_titles(radarr, rk, sonarr, sk)
        return
    videos = count_complete_videos()
    searching = arr_search_in_flight(radarr, rk) or arr_search_in_flight(sonarr, sk)
    if videos:
        if searching:
            log_if_new(
                "skip-refresh-search",
                "not refreshing completed downloads while a search is running",
            )
        else:
            for kind, base, key in engines:
                refresh_monitored_downloads(base, key, kind)
        for kind, base, key in engines:
            scan_download_drop(base, key, kind)
        for kind, base, key in engines:
            import_matched_drop(base, key, kind)
    forget_moved_torrents()
    prune_complete_extras()
    log_complete_drop_contents()
    for kind, base, key in engines:
        log_stuck_imports(base, key, kind)
        log_titles_waiting_for_library(base, key, kind)
    retry_unfilled_titles(radarr, rk, sonarr, sk)


def housekeep() -> int:
    """Stop finished torrents, rename into the library, forget rows whose files left."""
    secrets = load_secrets()
    wait_http(f"{qbit_url()}/api/v2/app/version")
    wait_http(f"{sonarr_url()}/ping")
    wait_http(f"{radarr_url()}/ping")
    sonarr = f"{sonarr_url()}/api/v3"
    radarr = f"{radarr_url()}/api/v3"
    sk, rk = secrets["sonarr_api_key"], secrets["radarr_api_key"]
    run_recyclarr()
    import_finished_downloads(radarr, rk, sonarr, sk)
    tickle_seerr_availability()
    return 0


if __name__ == "__main__":
    try:
        if len(sys.argv) > 1 and sys.argv[1] == "housekeep":
            raise SystemExit(housekeep())
        raise SystemExit(main())
    except Exception as exc:  # noqa: BLE001
        log(str(exc), "ERROR")
        mark_status(
            "wire",
            "Could not finish connecting search",
            80,
            str(exc)[:240],
        )
        raise SystemExit(1)
