#!/usr/bin/env python3
"""Wire localhost engines and Seerr. Idempotent. Secrets never logged.

Required (must succeed or this process exits non-zero so s6 retries, and
the wait screen does not claim search is ready): qBittorrent categories, Arr root
folders and download clients, Prowlarr's own qBittorrent client (Search → Grab),
Prowlarr↔Radarr/Sonarr apps, the operator source indexer when a URL is
configured, Seerr process up (GET /settings/public).
Seerr→Radarr/Sonarr is required after Seerr is initialized. Before that, the
Plex wizard has not created user id 1, so the API key 403s; we still mark
search ready (Seerr is on the published port, Ingress stays Pompey).

Optional (log and continue): Plex login/libraries when PLEX_URL/PLEX_TOKEN
are injected (household uses Seerr's wizard), Seerr local login (403 is
normal until the wizard creates a user), Seerr chrome settings (title,
trustProxy). No source URL yet is also optional — the household adds
sources in Prowlarr (Open sources, :9696).
"""
from __future__ import annotations

import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

EPISODE_KEY_RE = re.compile(r"(?i)S(\d{1,2})E(\d{1,3})")
SEASON_FOLDER_RE = re.compile(r"(?i)^season[ .\-_]*(\d{1,2})$")
SEASON_TOKEN_RE = re.compile(r"(?i)(?:^|[.\s_-])S(\d{1,2})(?:[.\s_-]|$)")
SPECIALS_FOLDER_RE = re.compile(r"(?i)^(?:specials|season[ .\-_]*0+)$")
SPECIAL_NAME_RE = re.compile(
    r"(?i)(?:^|[.\s_-])(?:(?:christmas|holiday|halloween|thanksgiving)[.\s_-]+)?"
    r"specials?(?:[.\s_-]|$)"
)
NOT_SPECIAL_RE = re.compile(r"(?i)special[.\s_-]+(?:features?|editions?)")
SAMPLE_NAME_RE = re.compile(r"(?i)(?:^|[.\s_\-/])samples?(?:[.\s_\-/]|$)")
EXTRA_SUFFIX_RE = re.compile(
    r"(?i)[-_.](behindthescenes|deleted|featurette|interview|scene|short|trailer|other)$"
)
QUALITY_TAIL_RE = re.compile(
    r"(?i)[.\s_-]+(?:\d{3,4}p|4k|uhd|web-?dl|webrip|bluray|blu-?ray|hdtv|"
    r"x26[45]|h\.?26[45]|hevc|avc|hdr10(?:plus)?|\bhdr\b|\bdv\b|proper|repack).*$"
)
WWW_PREFIX_RE = re.compile(r"(?i)^www\.[^\s]+?\s*-\s*")
YEAR_SUFFIX_RE = re.compile(r"\s*\(\d{4}\)\s*$")

