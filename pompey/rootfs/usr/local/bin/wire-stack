    ("Remux-1080p", ("Remux-1080p",)),
    ("HDTV-2160p", ("HDTV-2160p",)),
    ("WEB 2160p", ("WEBDL-2160p", "WEBRip-2160p")),
    ("Bluray-2160p", ("Bluray-2160p",)),
    ("Remux-2160p", ("Remux-2160p",)),
)
