SUBTITLE_EXTENSIONS = {".srt", ".ass", ".ssa", ".sub", ".idx"}

def secrets_path() -> str:
    return os.environ.get("POMPEY_SECRETS", "/data/pompey/secrets.json")


def ready_dir() -> str:
    return os.environ.get("POMPEY_READY", "/tmp/pompey")


def wait_tries() -> int:
    return int(os.environ.get("POMPEY_WAIT_TRIES", "90"))


def wait_sleep() -> float:
    return float(os.environ.get("POMPEY_WAIT_SLEEP", "2"))


def env(name: str, default: str = "") -> str:
    return os.environ.get(name, default).strip()


def after_download() -> str:
    raw = env("AFTER_DOWNLOAD", "stop_sharing").lower().replace("-", "_").replace(" ", "_")
    if raw in {"share_to_ratio", "ratio"}:
        return "share_to_ratio"
    if raw in {"share_one_day", "one_day"}:
        return "share_one_day"
    return "stop_sharing"


def simultaneous_downloads() -> int:
    raw = env("SIMULTANEOUS_DOWNLOADS", "8")
    try:
        number = int(raw)
    except ValueError:
        number = 8
    return max(1, min(number, 20))


def qbit_queue_preferences(active: int | None = None) -> dict:
    """WebUI names for the same queue policy write-engine-configs stamps in conf."""
    if active is None:
        active = simultaneous_downloads()
    return {
        "queueing_enabled": True,
        "max_active_downloads": active,
        "max_active_uploads": active,
        "max_active_torrents": max(active + 16, 20),
        "dont_count_slow_torrents": True,
        "slow_torrent_dl_rate_threshold": 2,
        "slow_torrent_ul_rate_threshold": 2,
        "slow_torrent_inactive_timer": 180,
    }


def qbit_set_preferences_url() -> str:
    return f"{qbit_url()}/api/v2/app/setPreferences"


def apply_qbit_queue() -> None:
    """Restamp queue prefs on a running client (existing installs + Debug UI)."""
    prefs = qbit_queue_preferences()
    data = urllib.parse.urlencode({"json": json.dumps(prefs)}).encode()
    http("POST", qbit_set_preferences_url(), data)
    log(
        f"qbit queue max_active_downloads={prefs['max_active_downloads']} "
        f"max_active_torrents={prefs['max_active_torrents']} ignore_slow=true"
    )


def parse_int(value) -> int | None:
    if value in (None, "", 0, "0"):
        return None
    try:
        number = int(value)
    except (TypeError, ValueError):
        return None
    return number if number > 0 else None


def as_list(value):
    """HTTP JSON is usually an array of objects; stubs and error bodies often are not.

    Do not wrap an error object or a name-only dict as a one-item list.
    That made a failed GET look like "indexer already exists" and skipped setup.
    """
    if isinstance(value, list):
        return [item for item in value if isinstance(item, dict)]
    if isinstance(value, dict):
        if (value.get("message") or value.get("error")) and not any(
            key in value for key in ("id", "implementation", "path", "hostname")
        ):
            return []
        for key in ("results", "records", "data", "items"):
            inner = value.get(key)
            if isinstance(inner, list):
                return as_list(inner)
        if any(key in value for key in ("id", "hostname", "path", "implementation", "owned")):
            return [value]
        return []
    return []


def media_root() -> str:
    return env("MEDIA_ROOT", "/media/dlna").rstrip("/")


def library_dir(env_name: str, default: str) -> str:
    rel = env(env_name, default).replace("\\", "/").strip().strip("/")
    parts = [p for p in rel.split("/") if p]
    if not parts or any(p == ".." for p in parts):
        parts = [p for p in default.replace("\\", "/").strip().strip("/").split("/") if p]
    return f"{media_root()}/{'/'.join(parts)}"


def movies_dir() -> str:
    return library_dir("MEDIA_MOVIES", "Movies/Not Kid Friendly")


def movies_kid_dir() -> str:
    return library_dir("MEDIA_MOVIES_KID", "Movies/Kid Friendly")


def tv_dir() -> str:
    return library_dir("MEDIA_TV", "TV/Not Kid Friendly")


def tv_kid_dir() -> str:
    return library_dir("MEDIA_TV_KID", "TV/Kid Friendly")


AUTO_FOLDER = "By Rating"


def sibling_auto_dir(library_path: str) -> str:
    """Staging root Seerr uses for 'sort by rating'. Not a Plex library."""
    parent = library_path.rstrip("/").rsplit("/", 1)[0]
    return f"{parent}/{AUTO_FOLDER}"


def movies_auto_dir() -> str:
    return sibling_auto_dir(movies_dir())


def tv_auto_dir() -> str:
    return sibling_auto_dir(tv_dir())


def downloads_complete() -> str:
    return f"{media_root()}/downloads/complete"


def downloads_manual() -> str:
    """Prowlarr Search → Grab. Not an Arr root folder and not complete/."""
    return f"{media_root()}/downloads/manual"


def download_drop_roots() -> list[str]:
    """Finished-torrent folders housekeep may import from.

    complete/ is Arr (radarr / sonarr categories). manual/ is Prowlarr Grab.
    Library roots are never in this list.
    """
    return [downloads_complete(), downloads_manual()]


def downloads_recycle() -> str:
    """Arr recycle bin. Upgrades move the old library file here instead of deleting it."""
    return f"{media_root()}/downloads/recycle"


def library_dirs() -> list[str]:
    return [movies_dir(), movies_kid_dir(), tv_dir(), tv_kid_dir()]


def resolved_path(path: str) -> str:
    full = os.path.normpath((path or "").strip())
    if not full:
        return ""
    if not os.path.isabs(full):
        full = os.path.normpath(os.path.join(media_root(), full))
    return os.path.realpath(full)


def paths_overlap(left: str, right: str) -> bool:
    a = resolved_path(left)
    b = resolved_path(right)
    if not a or not b:
        return False
    return a == b or a.startswith(b + os.sep) or b.startswith(a + os.sep)


def path_is_library(path: str) -> bool:
    full = resolved_path(path)
    if not full:
        return False
    for lib in library_dirs():
        base = resolved_path(lib)
        if full == base or full.startswith(base + os.sep):
            return True
    return False


def complete_overlaps_library() -> bool:
    """True when downloads/complete is a Plex library folder (or a library lives in it)."""
    complete = downloads_complete()
    return any(paths_overlap(complete, lib) for lib in library_dirs())


def manual_overlaps_library() -> bool:
    """True when downloads/manual is a Plex library folder (or a library lives in it)."""
    manual = downloads_manual()
    return any(paths_overlap(manual, lib) for lib in library_dirs())


def path_under_root(path: str, root: str) -> bool:
    root_n = os.path.normpath(root or "")
    full = os.path.normpath((path or "").strip())
    if not full or not root_n:
        return False
    if not os.path.isabs(full):
        full = os.path.normpath(os.path.join(root_n, full))
    return full == root_n or full.startswith(root_n + os.sep)


def safe_to_delete_complete_path(path: str) -> bool:
    """Leftover under downloads/complete or downloads/manual. Never a Plex library path."""
    if not path:
        return False
    full = resolved_path(path)
    if not full or path_is_library(full):
        return False
    for root_fn, blocked in (
        (downloads_complete, complete_overlaps_library),
        (downloads_manual, manual_overlaps_library),
    ):
        if blocked():
            continue
        root = resolved_path(root_fn())
        if not root or full == root:
            continue
        if full.startswith(root + os.sep):
            return True
    return False


def download_scan_paths(kind: str | None = None) -> list[str]:
    """Old qBittorrent categories used complete/radarr and complete/sonarr.

    Arr categories now save into complete/ itself. Prowlarr Grab saves into
    downloads/manual so a human pick is not mixed with Arr completed-download
    handling. Arr's folder scan of complete/ can treat a leftover 'radarr'
    directory as a title name and never look inside it.
    """
    root = downloads_complete()
    paths = [root]
    if kind != "sonarr":
        paths.append(os.path.join(root, "radarr"))
    if kind != "radarr":
        paths.append(os.path.join(root, "sonarr"))
    paths.append(downloads_manual())
    return paths


def existing_download_scan_paths(kind: str | None = None) -> list[str]:
    found: list[str] = []
    allowed = []
    complete = resolved_path(downloads_complete())
    manual = resolved_path(downloads_manual())
    if complete and not complete_overlaps_library():
        allowed.append(complete)
    if manual and not manual_overlaps_library():
        allowed.append(manual)
    if not allowed:
        return found
    for path in download_scan_paths(kind):
        if not os.path.isdir(path):
            continue
        full = resolved_path(path)
        if not any(full == root or full.startswith(root + os.sep) for root in allowed):
            continue
        if path_is_library(path):
            continue
        found.append(path)
    return found


