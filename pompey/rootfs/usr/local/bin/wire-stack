def quality_catalog(profile: dict) -> dict:
    catalog = {}
    for item in profile.get("items") or []:
        if not isinstance(item, dict):
            continue
        q = item.get("quality")
        if isinstance(q, dict) and q.get("name"):
            catalog[str(q["name"])] = q
        for child in item.get("items") or []:
            if not isinstance(child, dict):
                continue
            cq = child.get("quality")
            if isinstance(cq, dict) and cq.get("name"):
                catalog[str(cq["name"])] = cq
    return catalog


def quality_id_of(value) -> int | None:
    if isinstance(value, dict):
        try:
            return int(value["id"])
        except (KeyError, TypeError, ValueError):
            return None
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def rebuild_profile_items(catalog: dict, groups: tuple, allow_unlisted: bool = False) -> list[dict]:
    used: set[str] = set()
    items: list[dict] = []
    grouped = {n for _name, names in groups for n in names}
    for group_name, names in groups:
        present = [catalog[n] for n in names if n in catalog]
        if not present:
            continue
        used.update(n for n in names if n in catalog)
        if len(present) == 1 and present[0].get("name") == group_name:
            items.append({"quality": present[0], "items": [], "allowed": True})
            continue
        items.append(
            {
                "name": group_name,
                "allowed": True,
                "items": [{"quality": q, "items": [], "allowed": True} for q in present],
            }
        )
    for name, q in catalog.items():
        if name in used:
            continue
        allowed = allow_unlisted and name != "BR-DISK" and name not in grouped
        items.append({"quality": q, "items": [], "allowed": allowed})
    return items


def rebuild_hd_items(catalog: dict) -> list[dict]:
    """Default profile items: 1080p/720p encodes, no remux/4K/CAM."""
    return rebuild_profile_items(catalog, DEFAULT_GROUPS, allow_unlisted=False)


def title_custom_format(name: str, regex: str) -> dict:
    return {
        "name": name,
        "includeCustomFormatWhenRenaming": False,
        "specifications": [
            {
                "name": name,
                "implementation": "ReleaseTitleSpecification",
                "negate": False,
                "required": True,
                "fields": [{"name": "value", "value": regex}],
            }
        ],
    }


def household_format_scores(tier: str) -> dict[str, int]:
    """Per-profile CF scores. Household language options apply to every tier."""
    scores: dict[str, int] = {}
    if tier == PROFILE_DEFAULT:
        scores = {
            "Pompey Reject CAM/TS": -10000,
            "Pompey Reject Remux/DISK": -10000,
            "Pompey Prefer WEB-DL": 150,
            "Pompey Prefer x265": 80,
            "Pompey Prefer Proper": 25,
        }
    elif tier == PROFILE_MAX:
        scores = {
            "Pompey Reject CAM/TS": -10000,
            "Pompey Prefer Remux": 200,
            "Pompey Prefer lossless audio": 150,
            "Pompey Prefer WEB-DL": 80,
            "Pompey Prefer Proper": 25,
        }
    else:
        scores = {"Pompey Prefer Proper": 10}

    audio = anime_audio()
    if audio == "dual_audio":
        scores["Pompey Dual Audio"] = 200
    elif audio == "english":
        scores["Pompey English dub"] = 150
        scores["Pompey Dual Audio"] = 50
    # original: dual-audio is neither preferred nor rejected

    if preferred_language() == "english" and audio != "original":
        scores.setdefault("Pompey English dub", 80)

    if subtitles_pref() == "english":
        scores["Pompey English subs"] = 50
    return scores


def ensure_custom_formats(base: str, api_key: str) -> dict[str, int]:
    """Upsert household title CFs. Returns name -> Arr id."""
    try:
        existing = as_list(http("GET", f"{base}/customformat", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"custom formats: {exc}", "WARNING")
        return {}
    by_name = {item.get("name"): item for item in existing if item.get("name")}
    ids: dict[str, int] = {}
    for name, regex in CUSTOM_FORMATS:
        payload = title_custom_format(name, regex)
        have = by_name.get(name)
        try:
            if have and have.get("id") is not None:
                payload["id"] = have["id"]
                saved = http(
                    "PUT",
                    f"{base}/customformat/{have['id']}",
                    payload,
                    headers=arr_headers(api_key),
                )
            else:
                saved = http(
                    "POST",
                    f"{base}/customformat",
                    payload,
                    headers=arr_headers(api_key),
                )
            saved_id = (saved or {}).get("id") if isinstance(saved, dict) else None
            if saved_id is None and have:
                saved_id = have.get("id")
            if saved_id is not None:
                ids[name] = int(saved_id)
        except RuntimeError as exc:
            log(f"custom format {name}: {exc}", "WARNING")
    return ids


def format_items_for(tier: str, cf_ids: dict[str, int]) -> list[dict]:
    items = []
    for name, score in household_format_scores(tier).items():
        cf_id = cf_ids.get(name)
        if cf_id is None:
            continue
        items.append({"format": cf_id, "name": name, "score": score})
    return items


def apply_quality_sizes(base: str, api_key: str, sizes: dict) -> None:
    try:
        defs = as_list(http("GET", f"{base}/qualitydefinition", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"quality sizes: {exc}", "WARNING")
        return
    for item in defs:
        if not isinstance(item, dict) or item.get("id") is None:
            continue
        q = item.get("quality") if isinstance(item.get("quality"), dict) else {}
        name = q.get("name") if isinstance(q, dict) else None
        want = sizes.get(name)
        if not want:
            continue
        min_s, pref_s, max_s = want
        if (
            item.get("minSize") == min_s
            and item.get("preferredSize") == pref_s
            and item.get("maxSize") == max_s
        ):
            continue
        updated = json.loads(json.dumps(item))
        updated["minSize"] = min_s
        updated["preferredSize"] = pref_s
        updated["maxSize"] = max_s
        try:
            http(
                "PUT",
                f"{base}/qualitydefinition/{item['id']}",
                updated,
                headers=arr_headers(api_key),
            )
        except RuntimeError as exc:
            log(f"quality size {name}: {exc}", "WARNING")


def cutoff_id_for(catalog: dict, names: tuple[str, ...], fallback=None) -> int | None:
    for name in names:
        found = quality_id_of(catalog.get(name))
        if found is not None:
            return found
    return quality_id_of(fallback)


def pick_default_profile(profiles: list[dict]) -> dict:
    by_name = {item.get("name"): item for item in profiles if item.get("name")}
    for name in (PROFILE_DEFAULT, *LEGACY_DEFAULT_NAMES):
        if name in by_name:
            return by_name[name]
    return profiles[0]


def upsert_quality_profile(
    base: str,
    api_key: str,
    name: str,
    template: dict,
    items: list[dict],
    cutoff_id: int | None,
    format_items: list[dict],
    upgrade_allowed: bool,
    existing: dict | None,
) -> int:
    payload = json.loads(json.dumps(template))
    payload.pop("id", None)
    payload["name"] = name
    payload["items"] = items
    payload["upgradeAllowed"] = upgrade_allowed
    if cutoff_id is not None:
        payload["cutoff"] = cutoff_id
    payload["minFormatScore"] = 0
    payload["cutoffFormatScore"] = 10000 if upgrade_allowed else 0
    payload["formatItems"] = format_items
    if existing and existing.get("id") is not None:
        payload["id"] = existing["id"]
        http(
            "PUT",
            f"{base}/qualityprofile/{existing['id']}",
            payload,
            headers=arr_headers(api_key),
        )
        return int(existing["id"])
    saved = http(
        "POST",
        f"{base}/qualityprofile",
        payload,
        headers=arr_headers(api_key),
    )
    saved_id = (saved or {}).get("id") if isinstance(saved, dict) else None
    if saved_id is None:
        raise RuntimeError(f"quality profile {name} POST returned no id")
    return int(saved_id)


def drop_extra_quality_profiles(base: str, api_key: str) -> None:
    """Seerr lists every Arr profile in the request dropdown. Keep only the three."""
    try:
        profiles = as_list(http("GET", f"{base}/qualityprofile", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"quality profiles after upsert: {exc}", "WARNING")
        return
    for item in profiles:
        name = item.get("name")
        pid = item.get("id")
        if name in PROFILE_NAMES or pid is None:
            continue
        try:
            http(
                "DELETE",
                f"{base}/qualityprofile/{pid}",
                headers=arr_headers(api_key),
            )
            log(f"removed leftover quality profile {name}")
        except RuntimeError as exc:
            log(f"could not remove quality profile {name}: {exc}", "WARNING")


def household_quality_profile(base: str, api_key: str, kind: str):
    """Max (remux/4K), Default (1080p encode), Anything (take what exists)."""
    profiles = as_list(http("GET", f"{base}/qualityprofile", headers=arr_headers(api_key)))
    if not profiles:
        raise RuntimeError(f"no quality profiles at {base}")
    template = pick_default_profile(profiles)
    catalog = quality_catalog(template)
    if not catalog:
        for item in profiles:
            catalog = quality_catalog(item)
            if catalog:
                template = item
                break
    if not catalog:
        log(f"{kind} quality profile has no qualities listed; leaving defaults", "WARNING")
        return int(template["id"]), template.get("name") or PROFILE_DEFAULT

    cf_ids = ensure_custom_formats(base, api_key)
    by_name = {item.get("name"): item for item in profiles if item.get("name")}
    default_existing = pick_default_profile(profiles)

    default_id = upsert_quality_profile(
        base,
        api_key,
        PROFILE_DEFAULT,
        template,
        rebuild_profile_items(catalog, DEFAULT_GROUPS),
        cutoff_id_for(catalog, ("Bluray-1080p", "WEBDL-1080p", "Bluray-720p"), template.get("cutoff")),
        format_items_for(PROFILE_DEFAULT, cf_ids),
        True,
        default_existing,
    )
    upsert_quality_profile(
        base,
        api_key,
        PROFILE_MAX,
        template,
        rebuild_profile_items(catalog, MAX_GROUPS),
        cutoff_id_for(catalog, ("Remux-2160p", "Remux-1080p", "Bluray-1080p"), template.get("cutoff")),
        format_items_for(PROFILE_MAX, cf_ids),
        True,
        by_name.get(PROFILE_MAX),
    )
    upsert_quality_profile(
        base,
        api_key,
        PROFILE_ANYTHING,
        template,
        rebuild_profile_items(catalog, (), allow_unlisted=True),
        cutoff_id_for(catalog, ("CAM", "WEBDL-480p", "WEBDL-720p", "WEBDL-1080p"), template.get("cutoff")),
        format_items_for(PROFILE_ANYTHING, cf_ids),
        False,
        by_name.get(PROFILE_ANYTHING),
    )
    drop_extra_quality_profiles(base, api_key)
    sizes = QUALITY_SIZES_MOVIE if kind == "radarr" else QUALITY_SIZES_SERIES
    apply_quality_sizes(base, api_key, sizes)
    log(
        f"{kind} quality profiles: {PROFILE_MAX} (remux/4K), "
        f"{PROFILE_DEFAULT} (1080p encode), {PROFILE_ANYTHING} (take anything)"
    )
    return default_id, PROFILE_DEFAULT


def language_profile_id(_base: str, _api_key: str):
    # Sonarr v4 dropped language profiles. GET /languageprofile is deprecated and
    # warned on every wire retry (Python-urllib) while doing no work for our 4.0.x.
    return None


def ensure_prowlarr_app(prowlarr: str, pkey: str, name: str, impl: str, base_url: str, api_key: str) -> None:
    want = prowlarr_arr_url()
    want_cats = sync_cats_for(impl)
    values = {
        "prowlarrUrl": want,
        "baseUrl": base_url,
        "apiKey": api_key,
        "syncCategories": want_cats,
    }
    apps = as_list(http("GET", f"{prowlarr}/api/v1/applications", headers=arr_headers(pkey)))
    for existing in apps:
        if existing.get("name") != name:
            continue
        current = str(app_field(existing, "prowlarrUrl") or "").rstrip("/")
        current_cats = app_field(existing, "syncCategories")
        if current == want and cats_match(current_cats, want_cats):
            return
        if existing.get("id") is None:
            return
        updated = json.loads(json.dumps(existing))
        set_app_fields(updated, {"prowlarrUrl": want, "syncCategories": want_cats})
        http(
            "PUT",
            f"{prowlarr}/api/v1/applications/{existing['id']}",
            updated,
            headers=arr_headers(pkey),
        )
        log(f"prowlarr app {name} Arr URL {want} cats {want_cats[0]}s")
        return
    schema = http("GET", f"{prowlarr}/api/v1/applications/schema", headers=arr_headers(pkey))
    app = schema_impl(schema, impl)
    set_app_fields(app, values)
    app["name"] = name
    app["syncLevel"] = "fullSync"
    app["tags"] = []
    http("POST", f"{prowlarr}/api/v1/applications", app, headers=arr_headers(pkey))
    log(f"prowlarr app {name}")


def ensure_indexer(prowlarr: str, pkey: str) -> None:
    if not indexer_url():
        log("no source URL configured yet")
        return
    indexers = as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
    if indexers:
        return
    schema = http("GET", f"{prowlarr}/api/v1/indexer/schema", headers=arr_headers(pkey))
    impl = "Newznab" if "newznab" in indexer_url().lower() else "Torznab"
    try:
        indexer = schema_impl(schema, impl)
    except RuntimeError:
        indexer = schema_impl(schema, "Newznab" if impl == "Torznab" else "Torznab")
    fill_fields(
        indexer,
        {
            "baseUrl": indexer_url().rstrip("/"),
            "apiPath": "/api",
            "apiKey": indexer_api_key(),
        },
    )
    indexer["name"] = "Source"
    indexer["enable"] = True
    indexer["enableRss"] = True
    indexer["enableAutomaticSearch"] = True
    indexer["enableInteractiveSearch"] = True
    indexer["priority"] = 25
    indexer["appProfileId"] = 1
    indexer["tags"] = []
    http("POST", f"{prowlarr}/api/v1/indexer", indexer, headers=arr_headers(pkey))
    log("added source")


def sync_prowlarr_indexers(prowlarr: str, pkey: str) -> None:
    """Push every enabled Prowlarr source into Radarr/Sonarr and say how many exist.

    Pompey does not pick which indexer to query — Arr asks Prowlarr, and Prowlarr
    fans out to every source that is enabled for that search type and category.
    Household sources are added in Prowlarr's UI; we still sync so Arr sees them.
    Enabled sources with search switched off would be skipped on the next request.
    """
    indexers = as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
    for item in indexers:
        if not item.get("enable") or item.get("id") is None:
            continue
        if all(item.get(key) is True for key in SEARCH_FLAGS):
            continue
        detail = item
        try:
            fetched = http(
                "GET",
                f"{prowlarr}/api/v1/indexer/{item['id']}",
                headers=arr_headers(pkey),
            )
            if isinstance(fetched, dict) and fetched.get("id") is not None:
                detail = fetched
        except RuntimeError:
            pass
        if all(detail.get(key) is True for key in SEARCH_FLAGS):
            continue
        for key in SEARCH_FLAGS:
            detail[key] = True
        name = detail.get("name") or item.get("name") or "unnamed"
        try:
            http(
                "PUT",
                f"{prowlarr}/api/v1/indexer/{item['id']}",
                detail,
                headers=arr_headers(pkey),
            )
            log(f"Prowlarr source {name} search flags turned on")
        except RuntimeError as exc:
            log(f"Prowlarr source {name} could not enable search: {exc}", "WARNING")
    indexers = as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
    enabled = [item for item in indexers if item.get("enable")]
    log(f"Prowlarr sources: {len(enabled)} enabled / {len(indexers)} total")
    for item in indexers:
        name = item.get("name") or "unnamed"
        on = "on" if item.get("enable") else "off"
        rss, auto, interactive = (item.get(key) for key in SEARCH_FLAGS)
        if item.get("enable") and any(flag is not True for flag in (rss, auto, interactive)):
            try:
                fetched = http(
                    "GET",
                    f"{prowlarr}/api/v1/indexer/{item['id']}",
                    headers=arr_headers(pkey),
                )
                if isinstance(fetched, dict):
                    rss, auto, interactive = (fetched.get(key) for key in SEARCH_FLAGS)
            except RuntimeError:
                pass
        log(
            f"Prowlarr source {name} {on} "
            f"rss={rss} auto={auto} interactive={interactive}"
        )
    http(
        "POST",
        f"{prowlarr}/api/v1/command",
        {"name": "ApplicationIndexerSync"},
        headers=arr_headers(pkey),
    )
    log("prowlarr sync")


def log_arr_vs_prowlarr_indexers(
    radarr: str, radarr_key: str, sonarr: str, sonarr_key: str, prowlarr: str, pkey: str
) -> None:
    """Warn when Prowlarr sync left Radarr/Sonarr with fewer sources than Prowlarr has."""
    try:
        enabled = [
            item
            for item in as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
            if item.get("enable")
        ]
    except RuntimeError as exc:
        log(f"could not list Prowlarr sources after sync: {exc}", "WARNING")
        return
    names = {(item.get("name") or "").strip() for item in enabled if item.get("name")}
    for kind, base, key in (("Radarr", radarr, radarr_key), ("Sonarr", sonarr, sonarr_key)):
        try:
            arr = as_list(http("GET", f"{base}/indexer", headers=arr_headers(key)))
        except RuntimeError as exc:
            log(f"could not list {kind} indexers: {exc}", "WARNING")
            continue
        active = [item for item in arr if item.get("enable") is not False]
        log(f"{kind} indexers: {len(active)} (Prowlarr enabled {len(enabled)})")
        arr_names = {(item.get("name") or "").strip() for item in active if item.get("name")}
        missing = sorted(name for name in names if name not in arr_names)
        extra = sorted(name for name in arr_names if name not in names)
        if missing:
            log(
                f"{kind} is missing Prowlarr source(s): {', '.join(missing)}. "
                "Those sources will not run for Seerr requests (Prowlarr often refuses "
                "to sync when a category test returns top100 / CloudFlare).",
                "WARNING",
            )
        if extra:
            log(f"{kind} extra indexer(s) not in Prowlarr: {', '.join(extra)}")


def history_data_map(record: dict) -> dict[str, str]:
    raw = record.get("data") if isinstance(record, dict) else None
    if not isinstance(raw, dict):
        return {}
    out: dict[str, str] = {}
    for key, val in raw.items():
        if val is None or val == "":
            continue
        out[str(key).lower()] = str(val)
    return out


def describe_prowlarr_history_row(record: dict, indexer_names: dict | None = None) -> str:
    """Say whether History Query was empty because of IMDb/TMDB, RSS, or a true blank."""
    names = indexer_names or {}
    indexer = record.get("indexer") if isinstance(record, dict) else None
    if isinstance(indexer, dict) and indexer.get("name"):
        name = str(indexer.get("name"))
    else:
        idx = record.get("indexerId") if isinstance(record, dict) else None
        try:
            name = names.get(int(idx)) or f"indexer {idx}"
        except (TypeError, ValueError):
            name = str(indexer or "indexer")
    event = record.get("eventType") if isinstance(record, dict) else None
    event_s = str(event or "").lower()
    data = history_data_map(record if isinstance(record, dict) else {})
    query = (data.get("query") or "").strip()
    qtype = (data.get("querytype") or "").strip() or "search"
    source = (data.get("source") or "").strip()
    ids = []
    if data.get("imdbid"):
        ids.append(f"IMDb {data['imdbid']}")
    if data.get("tmdbid"):
        ids.append(f"TMDb {data['tmdbid']}")
    if data.get("tvdbid"):
        ids.append(f"TVDb {data['tvdbid']}")
    id_bit = " ".join(ids)
    via = f" via {source}" if source else ""
    url = (data.get("url") or "").lower()
    if "top100" in url or "top-100" in url or "top_100" in url:
        return f"{name}{via} browse/top100 (not the Seerr title)"
    if event in (3, "indexerRss", "IndexerRss") or event_s == "indexerrss":
        return f"{name}{via} RSS (no title term)"
    if id_bit and not query:
        return f"{name}{via} {qtype} {id_bit} (Query empty — ID search)"
    if id_bit and query:
        return f"{name}{via} {qtype} {id_bit} q={query!r}"
    if query:
        return f"{name}{via} {qtype} q={query!r}"
    return f"{name}{via} {qtype} empty query (no IDs)"


def log_recent_prowlarr_searches(prowlarr: str, pkey: str) -> None:
    """Dump recent History rows so an empty Query is not mistaken for a blank search."""
    try:
        indexers = as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
        names = {}
        for item in indexers:
            try:
                names[int(item["id"])] = item.get("name") or f"indexer {item['id']}"
            except (TypeError, ValueError, KeyError):
                continue
        payload = http(
            "GET",
            f"{prowlarr}/api/v1/history?page=1&pageSize=40&sortKey=date&sortDirection=descending",
            headers=arr_headers(pkey),
        )
        records = as_list(payload)
        shown = 0
        for record in records:
            event = record.get("eventType")
            event_s = str(event or "").lower()
            if event not in (2, 3, "indexerQuery", "indexerRss", "IndexerQuery", "IndexerRss") and event_s not in {
                "indexerquery",
                "indexerrss",
            }:
                continue
            log(f"Prowlarr history {describe_prowlarr_history_row(record, names)}")
            shown += 1
            if shown >= 20:
                break
        if shown:
            log(
                f"Prowlarr history: {shown} recent search(es). "
                "Empty Query plus IMDb/TMDb is ID search (keep it). "
                "Empty Query with no IDs is RSS or a true blank."
            )
    except RuntimeError as exc:
        log(f"could not read Prowlarr history: {exc}", "WARNING")


def retry_unfilled_titles(radarr: str, radarr_key: str, sonarr: str, sonarr_key: str) -> None:
    """Search monitored titles that still have no file. Seerr already handed off.

    A request that searched too few indexers stays approved in Seerr; Arr will
    not try again until RSS or a missing-search cycle unless we ask.
    """
    try:
        movies = as_list(http("GET", f"{radarr}/movie", headers=arr_headers(radarr_key)))
        movie_ids = [
            int(item["id"])
            for item in movies
            if item.get("monitored") is True
            and item.get("hasFile") is False
            and item.get("id") is not None
        ][:20]
        if movie_ids:
            http(
                "POST",
                f"{radarr}/command",
                {"name": "MoviesSearch", "movieIds": movie_ids},
                headers=arr_headers(radarr_key),
            )
            log(f"searching again for {len(movie_ids)} movie(s) still missing a file")
    except RuntimeError as exc:
        log(f"could not retry movie search: {exc}", "WARNING")
    try:
        missing = http(
            "GET",
            f"{sonarr}/wanted/missing?pageSize=20",
            headers=arr_headers(sonarr_key),
        )
        records = as_list(missing)
        if isinstance(missing, dict) and not records:
            records = as_list(missing.get("records"))
        episode_ids = [
            int(item["id"])
            for item in records
            if item.get("id") is not None
        ][:20]
        if episode_ids:
            http(
                "POST",
                f"{sonarr}/command",
                {"name": "EpisodeSearch", "episodeIds": episode_ids},
                headers=arr_headers(sonarr_key),
            )
            log(f"searching again for {len(episode_ids)} missing episode(s)")
    except RuntimeError as exc:
        if "404" not in str(exc):
            log(f"could not retry episode search: {exc}", "WARNING")


def qbit_category(name: str, save_path: str) -> None:
    data = urllib.parse.urlencode({"category": name, "savePath": save_path}).encode()
    try:
        http("POST", f"{qbit_url()}/api/v2/torrents/createCategory", data)
        log(f"qbit category {name} -> {save_path}")
    except RuntimeError as exc:
        # 409 = category already exists. Point it at complete/ anyway.
        if "409" in str(exc) or "already" in str(exc).lower():
            http("POST", f"{qbit_url()}/api/v2/torrents/editCategory", data)
            return
        raise


def qbit_torrents_url() -> str:
    return f"{qbit_url()}/api/v2/torrents/{'info'}"


def qbit_delete_url() -> str:
    return f"{qbit_url()}/api/v2/torrents/delete"


# Recheck/move is transient. missingFiles means the payload left (Arr import or a
# hand move). Leaving that torrent in qBittorrent is what re-downloads it.
QBIT_TRANSIENT = {
    "moving",
    "checkingDL",
    "checkingUP",
    "checkingResumeData",
    "allocating",
    "metaDL",
}


def qbit_payload_gone(item: dict) -> bool:
    """True when the torrent's files are not on disk (moved into the library)."""
    path = item.get("content_path")
    if not isinstance(path, str) or not path.strip():
        return str(item.get("state") or "") == "missingFiles"
    path = path.strip()
    if not os.path.exists(path):
        return True
    if os.path.isdir(path):
        try:
            with os.scandir(path) as entries:
                return next(entries, None) is None
        except OSError:
            return False
    return False


def qbit_should_forget(item: dict, gone: bool | None = None) -> bool:
    """Drop the qBittorrent row only. Never delete files (library may be a hardlink)."""
    if not isinstance(item, dict):
        return False
    state = str(item.get("state") or "")
    if state in QBIT_TRANSIENT:
        return False
    if gone is None:
        gone = qbit_payload_gone(item)
    if state == "missingFiles":
        return True
    try:
        progress = float(item.get("progress") or 0)
    except (TypeError, ValueError):
        progress = 0.0
    try:
        left = float(item.get("amount_left") or 1)
    except (TypeError, ValueError):
        left = 1.0
    finished = progress >= 0.999 or left == 0
    return bool(gone and finished)


def qbit_forget_torrents(hashes: list[str]) -> None:
    if not hashes:
        return
    data = urllib.parse.urlencode(
        {"hashes": "|".join(hashes), "deleteFiles": "false"}
    ).encode()
    http("POST", qbit_delete_url(), data)


def forget_moved_torrents() -> None:
    """If the file already left complete/, drop the torrent so it cannot re-download."""
    try:
        payload = http("GET", qbit_torrents_url())
    except RuntimeError as exc:
        log(f"qbit torrents: {exc}", "WARNING")
        return
    rows = payload if isinstance(payload, list) else []
    hashes: list[str] = []
    for item in rows:
        if not isinstance(item, dict) or not qbit_should_forget(item):
            continue
        digest = item.get("hash")
        if digest:
            hashes.append(str(digest))
    if not hashes:
        return
    try:
        qbit_forget_torrents(hashes)
    except RuntimeError as exc:
        log(f"qbit forget moved: {exc}", "WARNING")
        return
    log(
        f"qbit dropped {len(hashes)} torrent(s) whose files were already moved "
        "(torrent only; library files kept)"
    )


def scan_download_drop(base: str, api_key: str, kind: str) -> None:
    """Import anything sitting in complete/ even if qBittorrent already forgot it."""
    name = "DownloadedMoviesScan" if kind == "radarr" else "DownloadedEpisodesScan"
    try:
        http(
            "POST",
            f"{base}/command",
            {"name": name, "path": downloads_complete(), "importMode": "Move"},
            headers=arr_headers(api_key),
        )
        log(f"{kind} scanning complete folder for files to import")
    except RuntimeError as exc:
        log(f"{kind} complete-folder scan: {exc}", "WARNING")


class Seerr:
    def __init__(self, base: str | None = None):
        self.base = (base or seerr_url()).rstrip("/")
        self.cookie = ""
        self.api_key = ""

    def _headers(self) -> dict:
        headers = {"Content-Type": "application/json"}
        if self.cookie:
            headers["Cookie"] = self.cookie
        if self.api_key:
            headers["X-API-Key"] = self.api_key
        return headers

    def call(self, method: str, path: str, body=None):
        req = urllib.request.Request(
            self.base + path,
            data=None if body is None else json.dumps(body).encode(),
            method=method,
            headers=self._headers(),
        )
        try:
            with urllib.request.urlopen(req, timeout=45) as resp:
                cookies = []
                if hasattr(resp.headers, "get_all"):
                    cookies = resp.headers.get_all("Set-Cookie") or []
                elif resp.headers.get("Set-Cookie"):
                    cookies = [resp.headers.get("Set-Cookie")]
                for cookie in cookies:
                    self.cookie = cookie.split(";", 1)[0]
                raw = resp.read()
                if not raw:
                    return None
                text = raw.decode(errors="replace")
                try:
                    return json.loads(text)
                except json.JSONDecodeError:
                    return text
        except urllib.error.HTTPError as exc:
            err = exc.read().decode(errors="replace")
            raise RuntimeError(f"seerr {method} {path} -> {exc.code} {err[:400]}") from exc


def parse_plex(url: str):
    u = urllib.parse.urlparse(url)
    host = u.hostname or "127.0.0.1"
    port = u.port or (443 if u.scheme == "https" else 32400)
    ssl = u.scheme == "https"
    return host, port, ssl


def pick_plex_server(servers, host: str):
    candidates = []
    for srv in as_list(servers):
        provides = srv.get("provides") or []
        if isinstance(provides, str):
            provides = [provides]
        if "server" not in provides and provides:
            continue
        candidates.append(srv)
    owned = [s for s in candidates if s.get("owned")]
    pool = owned or candidates
    host_l = (host or "").lower()
    for srv in pool:
        for conn in as_list(srv.get("connection") or srv.get("connections")):
            addr = (conn.get("address") or "").lower()
            if addr == host_l:
                return srv
    return pool[0] if pool else None


def configure_seerr(secrets: dict, radarr_profile, sonarr_profile, sonarr_lang) -> None:
    s = Seerr()
    for _ in range(wait_tries()):
        try:
            s.call("GET", "/api/v1/settings/public")
            break
        except Exception:  # noqa: BLE001
            time.sleep(wait_sleep())
    else:
        raise RuntimeError("Seerr never became ready")

    s.api_key = seerr_api_key_from_disk()
    have_plex = bool(plex_url() and plex_token())
    if not have_plex:
        log("Plex URL/token missing; Seerr setup wizard will be used for Plex")

    if have_plex:
        try:
            s.call("POST", "/api/v1/auth/plex", {"authToken": plex_token()})
            log("seerr signed in with Plex token")
        except RuntimeError as exc:
            log(f"seerr plex login: {exc}", "WARNING")
            have_plex = False

    email = secrets.get("seerr_email") or "pompey@local"
    password = secrets.get("seerr_password") or ""
    # Disk API key is admin. POST /auth/local with the generated pompey@local
    # password 403s and Seerr logs "invalid Seerr password" on every wire retry.
    if password and not s.cookie and not s.api_key:
        try:
            s.call(
                "POST",
                "/api/v1/auth/local",
                {"email": email, "password": password, "name": "Pompey"},
            )
            log("seerr signed in with local account")
        except RuntimeError as exc:
            # Real Seerr: no local user until the wizard (or a later password). 403 is expected.
            log(f"seerr local login: {exc}", "WARNING")

    if not s.api_key:
        try:
            main = s.call("GET", "/api/v1/settings/main") or {}
            if isinstance(main, dict) and main.get("apiKey"):
                s.api_key = main["apiKey"]
        except RuntimeError as exc:
            log(f"seerr api key: {exc}", "WARNING")
        if not s.api_key:
            s.api_key = seerr_api_key_from_disk()

    def public_initialized() -> bool:
        public = s.call("GET", "/api/v1/settings/public") or {}
        return isinstance(public, dict) and bool(public.get("initialized"))

    initialized = public_initialized()

    if have_plex:
        host, port, ssl = parse_plex(plex_url())
        try:
            servers = as_list(s.call("GET", "/api/v1/settings/plex/devices/servers"))
            chosen = pick_plex_server(servers, host)
            payload = {
                "ip": host,
                "port": port,
                "useSsl": ssl,
                "webAppUrl": plex_url().rstrip("/"),
            }
            if chosen:
                payload["name"] = chosen.get("name") or "Plex"
                payload["machineId"] = chosen.get("clientIdentifier") or ""
            else:
                payload["name"] = "Plex"
                payload["machineId"] = "unknown"
            s.call("POST", "/api/v1/settings/plex", payload)
            log("plex settings")
        except RuntimeError as exc:
            log(f"plex settings: {exc}", "WARNING")

        try:
            s.call("POST", "/api/v1/settings/plex/library/sync")
            libs = as_list(s.call("GET", "/api/v1/settings/plex/library"))
            for lib in libs:
                lib_id = lib.get("id")
                if not lib_id:
                    continue
                try:
                    s.call("PUT", f"/api/v1/settings/plex/library/{lib_id}", {"enabled": True})
                except RuntimeError as exc:
                    log(f"plex library {lib_id}: {exc}", "WARNING")
            log("plex libraries enabled")
        except RuntimeError as exc:
            log(f"plex libraries: {exc}", "WARNING")

    radarr_id, radarr_name = radarr_profile
    sonarr_id, sonarr_name = sonarr_profile
    radarr_payload = {
        "name": "Radarr",
        "hostname": "127.0.0.1",
        "port": 7878,
        "apiKey": secrets["radarr_api_key"],
        "useSsl": False,
        "activeProfileId": radarr_id,
        "activeProfileName": radarr_name,
        "activeDirectory": movies_dir(),
        "isDefault": True,
        "is4k": False,
        "minimumAvailability": "released",
        "syncEnabled": True,
        "preventSearch": False,
        "tagRequests": True,
        "urlBase": "",
        "externalUrl": "",
        "tags": [],
    }
    sonarr_payload = {
        "name": "Sonarr",
        "hostname": "127.0.0.1",
        "port": 8989,
        "apiKey": secrets["sonarr_api_key"],
        "useSsl": False,
        "activeProfileId": sonarr_id,
        "activeProfileName": sonarr_name,
        "activeDirectory": tv_dir(),
        "isDefault": True,
        "is4k": False,
        "enableSeasonFolders": True,
        "syncEnabled": True,
        "preventSearch": False,
        "tagRequests": True,
        "urlBase": "",
        "externalUrl": "",
        "tags": [],
    }
    if sonarr_lang is not None:
        sonarr_payload["activeLanguageProfileId"] = sonarr_lang

    def upsert_arr(kind: str, payload: dict) -> bool:
        path = f"/api/v1/settings/{kind}"
        try:
            existing = as_list(s.call("GET", path))
            match = next(
                (item for item in existing if item.get("hostname") == "127.0.0.1"),
                None,
            )
            if match:
                want = (payload.get("activeDirectory") or "").rstrip("/")
                have = (match.get("activeDirectory") or "").rstrip("/")
                server_id = match.get("id")
                dir_changed = bool(want and want != have)
                profile_changed = (
                    match.get("activeProfileId") != payload.get("activeProfileId")
                    or (match.get("activeProfileName") or "") != (payload.get("activeProfileName") or "")
                )
                if server_id is not None and (dir_changed or profile_changed):
                    update = dict(match)
                    update.update(payload)
                    # Seerr OpenAPI marks id read-only; it belongs in the URL.
                    update.pop("id", None)
                    s.call("PUT", f"{path}/{server_id}", update)
                    if dir_changed:
                        log(f"seerr {kind} directory {want}")
                    if profile_changed:
                        log(f"seerr {kind} profile {payload.get('activeProfileName')}")
                return True
            s.call("POST", path, payload)
            log(f"seerr {kind}")
            return True
        except RuntimeError as exc:
            # API key impersonates user id 1. That row does not exist until the
            # wizard creates the first admin, so settings 403. Hand off anyway.
            if "403" in str(exc) and not initialized:
                log(f"seerr {kind} waits until the Plex wizard creates the first admin")
                return False
            if "403" in str(exc):
                raise RuntimeError("seerr has no Radarr/Sonarr after initialize") from exc
            raise

    wired_arr = upsert_arr("radarr", radarr_payload)
    wired_arr = upsert_arr("sonarr", sonarr_payload) or wired_arr
    if wired_arr:
        open(os.path.join(ready_dir(), "seerr-arr"), "w").close()
    elif initialized:
        raise RuntimeError("seerr has no Radarr/Sonarr after initialize")

    try:
        s.call(
            "POST",
            "/api/v1/settings/main",
            {
                "applicationTitle": "Pompey",
                "applicationUrl": "",
                "defaultPermissions": SEERR_HOUSEHOLD_PERMS,
                "hideAvailable": False,
                "localLogin": True,
                "newPlexLogin": True,
            },
        )
    except RuntimeError as exc:
        log(f"seerr main settings: {exc}", "WARNING")

    try:
        users = s.call("GET", "/api/v1/user") or {}
        rows = as_list(users)
        if isinstance(users, dict) and not rows:
            rows = as_list(users.get("results") or users.get("users") or [])
        for user in rows:
            uid = user.get("id")
            if uid is None:
                continue
            try:
                perms = int(user.get("permissions") or 0)
            except (TypeError, ValueError):
                continue
            if perms & SEERR_REQUEST_ADVANCED:
                continue
            update = dict(user)
            update["permissions"] = perms | SEERR_REQUEST_ADVANCED
            try:
                s.call("PUT", f"/api/v1/user/{uid}", update)
            except RuntimeError as exc:
                log(f"seerr user {uid} permissions: {exc}", "WARNING")
    except RuntimeError as exc:
        log(f"seerr users: {exc}", "WARNING")

    try:
        s.call("POST", "/api/v1/settings/network", {"trustProxy": False})
    except RuntimeError as exc:
        log(f"seerr network: {exc}", "WARNING")

    public = s.call("GET", "/api/v1/settings/public") or {}
    already = isinstance(public, dict) and public.get("initialized")
    if already:
        return
    if have_plex:
        s.call("POST", "/api/v1/settings/initialize")
        log("seerr initialized")
    else:
        log("seerr left uninitialized so the Plex setup wizard can run")


def main() -> int:
    secrets = load_secrets()
    wait_http(f"{qbit_url()}/api/v2/app/version")
    wait_http(f"{prowlarr_url()}/ping")
    wait_http(f"{sonarr_url()}/ping")
    wait_http(f"{radarr_url()}/ping")

    sonarr = f"{sonarr_url()}/api/v3"
    radarr = f"{radarr_url()}/api/v3"
    prowlarr = prowlarr_url()
    sk, rk, pk = secrets["sonarr_api_key"], secrets["radarr_api_key"], secrets["prowlarr_api_key"]

    complete = downloads_complete()
    qbit_category("sonarr", complete)
    qbit_category("radarr", complete)
    ensure_root_folder(sonarr, sk, tv_dir())
    ensure_root_folder(sonarr, sk, tv_kid_dir())
    ensure_root_folder(radarr, rk, movies_dir())
    ensure_root_folder(radarr, rk, movies_kid_dir())
    ensure_download_client(sonarr, sk, secrets, "sonarr")
    ensure_download_client(radarr, rk, secrets, "radarr")
    ensure_media_management(sonarr, sk, "sonarr")
    ensure_media_management(radarr, rk, "radarr")
    ensure_prowlarr_app(prowlarr, pk, "Sonarr", "Sonarr", sonarr_url(), sk)
    ensure_prowlarr_app(prowlarr, pk, "Radarr", "Radarr", radarr_url(), rk)
    ensure_indexer(prowlarr, pk)
    sync_prowlarr_indexers(prowlarr, pk)
    log_arr_vs_prowlarr_indexers(radarr, rk, sonarr, sk, prowlarr, pk)
    sp = household_quality_profile(sonarr, sk, "sonarr")
    rp = household_quality_profile(radarr, rk, "radarr")
    retry_unfilled_titles(radarr, rk, sonarr, sk)
    refresh_monitored_downloads(radarr, rk, "radarr")
    refresh_monitored_downloads(sonarr, sk, "sonarr")
    scan_download_drop(radarr, rk, "radarr")
    scan_download_drop(sonarr, sk, "sonarr")
    forget_moved_torrents()
    log_stuck_imports(radarr, rk, "radarr")
    log_stuck_imports(sonarr, sk, "sonarr")
    log_recent_prowlarr_searches(prowlarr, pk)

    sl = language_profile_id(sonarr, sk)

    os.makedirs(ready_dir(), exist_ok=True)
    open(os.path.join(ready_dir(), "arr-wired"), "w").close()

    configure_seerr(secrets, rp, sp, sl)
    port = os.environ.get("SEERR_PORT", "5055")
    sources = os.environ.get("PROWLARR_PORT", "9696")
    log(f"search is on 0.0.0.0:{port}; sources on 0.0.0.0:{sources}; Ingress stays Pompey")
    mark_status("ready", "Ready", 100)
    open(os.path.join(ready_dir(), "wired"), "w").close()
    log("done")
    return 0


def housekeep() -> int:
    """Keep hidden qBittorrent empty of torrents whose files already left."""
    secrets = load_secrets()
    wait_http(f"{qbit_url()}/api/v2/app/version")
    wait_http(f"{sonarr_url()}/ping")
    wait_http(f"{radarr_url()}/ping")
    sonarr = f"{sonarr_url()}/api/v3"
    radarr = f"{radarr_url()}/api/v3"
    sk, rk = secrets["sonarr_api_key"], secrets["radarr_api_key"]
    refresh_monitored_downloads(radarr, rk, "radarr")
    refresh_monitored_downloads(sonarr, sk, "sonarr")
    scan_download_drop(radarr, rk, "radarr")
    scan_download_drop(sonarr, sk, "sonarr")
    forget_moved_torrents()
    log_stuck_imports(radarr, rk, "radarr")
    log_stuck_imports(sonarr, sk, "sonarr")
    return 0


if __name__ == "__main__":
    try:
        if len(sys.argv) > 1 and sys.argv[1] == "housekeep":
            raise SystemExit(housekeep())
        raise SystemExit(main())
    except Exception as exc:  # noqa: BLE001
        log(str(exc), "ERROR")
        mark_status(
            "wire",
            "Could not finish connecting search",
            80,
            str(exc)[:240],
        )
        raise SystemExit(1)
