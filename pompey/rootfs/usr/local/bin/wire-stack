#!/usr/bin/env python3
"""Wire localhost engines and Seerr. Idempotent. Secrets never logged.

Required (must succeed or this process exits non-zero so s6 retries, and
the wait screen does not claim search is ready): qBittorrent categories, Arr root
folders and download clients, Prowlarr↔Radarr/Sonarr apps, the operator
source indexer when a URL is configured, Seerr process up (GET /settings/public).
Seerr→Radarr/Sonarr is required after Seerr is initialized. Before that, the
Plex wizard has not created user id 1, so the API key 403s; we still mark
search ready (Seerr is on the published port, Ingress stays Pompey).

Optional (log and continue): Plex login/libraries when PLEX_URL/PLEX_TOKEN
are injected (household uses Seerr's wizard), Seerr local login (403 is
normal until the wizard creates a user), Seerr chrome settings (title,
trustProxy). No source URL yet is also optional — the household adds
sources in Prowlarr (Open sources, :9696).
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

def secrets_path() -> str:
    return os.environ.get("POMPEY_SECRETS", "/data/pompey/secrets.json")


def ready_dir() -> str:
    return os.environ.get("POMPEY_READY", "/tmp/pompey")


def wait_tries() -> int:
    return int(os.environ.get("POMPEY_WAIT_TRIES", "90"))


def wait_sleep() -> float:
    return float(os.environ.get("POMPEY_WAIT_SLEEP", "2"))


def env(name: str, default: str = "") -> str:
    return os.environ.get(name, default).strip()


def after_download() -> str:
    raw = env("AFTER_DOWNLOAD", "stop_sharing").lower().replace("-", "_").replace(" ", "_")
    if raw in {"share_to_ratio", "ratio"}:
        return "share_to_ratio"
    if raw in {"share_one_day", "one_day"}:
        return "share_one_day"
    return "stop_sharing"


def preferred_language() -> str:
    raw = env("PREFERRED_LANGUAGE", "english").lower().replace("-", "_").replace(" ", "_")
    if raw in {"original", "orig", "native"}:
        return "original"
    return "english"


def anime_audio() -> str:
    raw = env("ANIME_AUDIO", "dual_audio").lower().replace("-", "_").replace(" ", "_")
    if raw in {"original", "orig", "japanese", "ja"}:
        return "original"
    if raw in {"english", "eng", "dub", "english_dub"}:
        return "english"
    return "dual_audio"


def subtitles_pref() -> str:
    raw = env("SUBTITLES", "english").lower().replace("-", "_").replace(" ", "_")
    if raw in {"none", "off", "no", "no_subs"}:
        return "none"
    return "english"


def as_list(value):
    """HTTP JSON is usually an array of objects; stubs and error bodies often are not.

    Do not wrap an error object or a name-only dict as a one-item list.
    That made a failed GET look like "indexer already exists" and skipped setup.
    """
    if isinstance(value, list):
        return [item for item in value if isinstance(item, dict)]
    if isinstance(value, dict):
        if (value.get("message") or value.get("error")) and not any(
            key in value for key in ("id", "implementation", "path", "hostname")
        ):
            return []
        for key in ("results", "records", "data", "items"):
            inner = value.get(key)
            if isinstance(inner, list):
                return as_list(inner)
        if any(key in value for key in ("id", "hostname", "path", "implementation", "owned")):
            return [value]
        return []
    return []


def media_root() -> str:
    return env("MEDIA_ROOT", "/media/dlna").rstrip("/")


def library_dir(env_name: str, default: str) -> str:
    rel = env(env_name, default).replace("\\", "/").strip().strip("/")
    parts = [p for p in rel.split("/") if p]
    if not parts or any(p == ".." for p in parts):
        parts = [p for p in default.replace("\\", "/").strip().strip("/").split("/") if p]
    return f"{media_root()}/{'/'.join(parts)}"


def movies_dir() -> str:
    return library_dir("MEDIA_MOVIES", "Movies/Not Kid Friendly")


def movies_kid_dir() -> str:
    return library_dir("MEDIA_MOVIES_KID", "Movies/Kid Friendly")


def tv_dir() -> str:
    return library_dir("MEDIA_TV", "TV/Not Kid Friendly")


def tv_kid_dir() -> str:
    return library_dir("MEDIA_TV_KID", "TV/Kid Friendly")


def downloads_complete() -> str:
    return f"{media_root()}/downloads/complete"


def plex_url() -> str:
    # Not an HA option. Household finishes Plex in Seerr. Tests may inject.
    return env("PLEX_URL")


def plex_token() -> str:
    return env("PLEX_TOKEN")


def indexer_url() -> str:
    # Not an HA option. Household adds sources in Prowlarr. Integration injects.
    return env("INDEXER_URL")


def indexer_api_key() -> str:
    return env("INDEXER_API_KEY")


def qbit_url() -> str:
    return env("QBIT_URL", "http://127.0.0.1:8080").rstrip("/")


def sonarr_url() -> str:
    return env("SONARR_URL", "http://127.0.0.1:8989").rstrip("/")


def radarr_url() -> str:
    return env("RADARR_URL", "http://127.0.0.1:7878").rstrip("/")


def prowlarr_url() -> str:
    return env("PROWLARR_URL", "http://127.0.0.1:9696").rstrip("/")


def prowlarr_arr_url() -> str:
    """Radarr/Sonarr talk to Prowlarr through the title-search caps proxy."""
    return env("PROWLARR_ARR_URL", "http://127.0.0.1:9698").rstrip("/")


def seerr_url() -> str:
    return env("SEERR_URL", "http://127.0.0.1:5055").rstrip("/")


def seerr_config_dir() -> str:
    return env("SEERR_CONFIG") or os.path.join(env("POMPEY_CONFIG", "/config"), "seerr")


def seerr_api_key_from_disk() -> str:
    """Seerr writes main.apiKey on first start. That key is admin; /auth/local is not.

    POST /api/v1/auth/local only signs in an existing local user. The first admin is
    created by the Plex (or Jellyfin) setup wizard. A generated pompey@local password
    therefore 403s on a real Seerr, which is why the wait screen came back after 0.2.13.
    """
    path = os.path.join(seerr_config_dir(), "settings.json")
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError, TypeError):
        return ""
    if not isinstance(data, dict):
        return ""
    main = data.get("main") if isinstance(data.get("main"), dict) else data
    key = main.get("apiKey") if isinstance(main, dict) else None
    return key.strip() if isinstance(key, str) else ""


# Seerr: REQUEST + AUTO_APPROVE + AUTO_APPROVE_MOVIE + AUTO_APPROVE_TV + REQUEST_ADVANCED
# REQUEST_ADVANCED (8192) is what shows the quality-profile dropdown on a request.
SEERR_HOUSEHOLD_PERMS = 32 + 128 + 256 + 512 + 8192
SEERR_REQUEST_ADVANCED = 8192


def log(msg: str, level: str = "INFO") -> None:
    stamp = time.strftime("%H:%M:%S")
    print(f"[{stamp}] {level}: [wire-stack] {msg}", flush=True)


def mark_status(step: str, label: str, percent: int, error: str = "") -> None:
    script = shutil.which("pompey-status")
    if not script:
        sibling = os.path.join(os.path.dirname(os.path.abspath(__file__)), "pompey-status")
        if os.path.isfile(sibling):
            script = sibling
    if not script:
        return
    cmd = [sys.executable, script, step, label, str(percent)]
    if error:
        cmd.append(error)
    subprocess.run(cmd, check=False)


def load_secrets() -> dict:
    with open(secrets_path(), encoding="utf-8") as fh:
        return json.load(fh)


def http(method: str, url: str, body=None, headers=None, timeout=30):
    data = None
    hdrs = dict(headers or {})
    if body is not None:
        if isinstance(body, (bytes, bytearray)):
            data = body
            hdrs.setdefault("Content-Type", "application/x-www-form-urlencoded")
        elif isinstance(body, str):
            data = body.encode()
        else:
            data = json.dumps(body).encode()
            hdrs.setdefault("Content-Type", "application/json")
    attempts = 3
    last: Exception | None = None
    for attempt in range(attempts):
        req = urllib.request.Request(url, data=data, method=method, headers=hdrs)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                raw = resp.read()
                if not raw:
                    return None
                text = raw.decode(errors="replace")
                try:
                    return json.loads(text)
                except json.JSONDecodeError:
                    return text
        except urllib.error.HTTPError as exc:
            err = exc.read().decode(errors="replace")
            last = RuntimeError(f"{method} {url} -> {exc.code} {err[:300]}")
            if exc.code in {502, 503, 504} and attempt + 1 < attempts:
                time.sleep(wait_sleep())
                continue
            raise last from exc
        except urllib.error.URLError as exc:
            last = RuntimeError(f"{method} {url} -> {exc}")
            raise last from exc
    raise last or RuntimeError(f"{method} {url} failed")


def wait_http(url: str, tries: int | None = None):
    last = None
    n = wait_tries() if tries is None else tries
    for _ in range(n):
        try:
            req = urllib.request.Request(url, method="GET")
            with urllib.request.urlopen(req, timeout=10) as resp:
                return resp.read()
        except urllib.error.HTTPError as exc:
            if exc.code < 500:
                return b""
            last = exc
        except Exception as exc:  # noqa: BLE001
            last = exc
        time.sleep(wait_sleep())
    raise RuntimeError(f"timeout {url}: {last}")


def arr_headers(api_key: str) -> dict:
    return {"X-Api-Key": api_key, "Content-Type": "application/json"}


def ensure_root_folder(base: str, api_key: str, path: str) -> None:
    existing = as_list(http("GET", f"{base}/rootfolder", headers=arr_headers(api_key)))
    if any(item.get("path", "").rstrip("/") == path.rstrip("/") for item in existing):
        return
    http("POST", f"{base}/rootfolder", {"path": path}, headers=arr_headers(api_key))
    log(f"root folder {path}")


def schema_impl(schema, name: str):
    for item in as_list(schema):
        if item.get("implementation") == name:
            return json.loads(json.dumps(item))
    raise RuntimeError(f"schema missing {name}")


def fill_fields(resource: dict, values: dict) -> dict:
    for field in resource.get("fields") or []:
        n = field.get("name")
        if n in values:
            field["value"] = values[n]
    return resource


def set_app_fields(resource: dict, values: dict) -> dict:
    """Set Prowlarr application fields, appending any the existing row omitted."""
    fill_fields(resource, values)
    fields = resource.get("fields")
    if not isinstance(fields, list):
        fields = []
        resource["fields"] = fields
    have = {field.get("name") for field in fields}
    for name, value in values.items():
        if name not in have:
            fields.append({"name": name, "value": value})
    return resource


# Newznab movie / TV buckets Prowlarr syncs into Radarr / Sonarr.
RADARR_SYNC_CATS = [2000, 2010, 2020, 2030, 2040, 2045, 2050, 2060, 2070, 2080, 2090]
SONARR_SYNC_CATS = [5000, 5010, 5020, 5030, 5040, 5045, 5050, 5060, 5070, 5080, 5090]
SEARCH_FLAGS = ("enableRss", "enableAutomaticSearch", "enableInteractiveSearch")


def app_field(app: dict, name: str):
    for field in app.get("fields") or []:
        if field.get("name") == name:
            return field.get("value")
    return None


def cats_match(value, want: list[int]) -> bool:
    if not isinstance(value, list):
        return False
    try:
        have = sorted(int(item) for item in value)
    except (TypeError, ValueError):
        return False
    return have == sorted(want)


def sync_cats_for(impl: str) -> list[int]:
    return list(RADARR_SYNC_CATS if impl == "Radarr" else SONARR_SYNC_CATS)


def qbit_client_values(secrets: dict, kind: str) -> tuple[str, dict]:
    cat = "radarr" if kind == "radarr" else "sonarr"
    return cat, {
        "host": "127.0.0.1",
        "port": 8080,
        "username": secrets["qbit_user"],
        "password": secrets["qbit_password"],
        "movieCategory": cat,
        "tvCategory": cat,
        "category": cat,
        "useSsl": False,
    }


def download_client_ready(item: dict, cat: str, remove: bool) -> bool:
    if item.get("removeCompletedDownloads") is not remove:
        return False
    if item.get("removeFailedDownloads") is not True:
        return False
    if item.get("enable") is not True:
        return False
    return cat in {
        app_field(item, "movieCategory"),
        app_field(item, "tvCategory"),
        app_field(item, "category"),
    }


def apply_download_client(item: dict, values: dict, remove: bool) -> dict:
    updated = json.loads(json.dumps(item))
    set_app_fields(updated, values)
    updated["enable"] = True
    updated["removeCompletedDownloads"] = remove
    updated["removeFailedDownloads"] = True
    return updated


def ensure_download_client(base: str, api_key: str, secrets: dict, kind: str) -> None:
    remove = after_download() == "stop_sharing"
    cat, values = qbit_client_values(secrets, kind)
    existing = as_list(http("GET", f"{base}/downloadclient", headers=arr_headers(api_key)))
    for item in existing:
        if item.get("implementation") != "QBittorrent" or item.get("id") is None:
            continue
        if download_client_ready(item, cat, remove):
            return
        updated = apply_download_client(item, values, remove)
        http(
            "PUT",
            f"{base}/downloadclient/{item['id']}",
            updated,
            headers=arr_headers(api_key),
        )
        log(f"{kind} download client category={cat} after_download={after_download()} remove={remove}")
        return
    schema = http("GET", f"{base}/downloadclient/schema", headers=arr_headers(api_key))
    client = apply_download_client(schema_impl(schema, "QBittorrent"), values, remove)
    client["name"] = "qBittorrent"
    client["priority"] = 1
    http("POST", f"{base}/downloadclient", client, headers=arr_headers(api_key))
    log(f"{kind} download client category={cat} after_download={after_download()} remove={remove}")


def ensure_media_management(base: str, api_key: str, kind: str) -> None:
    """Import completed torrents into the library folder Seerr asked for.

    Network media shares (this house: /media/dlna) often report 0 free space, so
    Radarr/Sonarr skip import and the file sits in downloads/complete. Auto
    completed-download handling must stay on.
    """
    cfg = http("GET", f"{base}/config/mediamanagement", headers=arr_headers(api_key))
    if not isinstance(cfg, dict):
        raise RuntimeError(f"{kind} media management missing")
    want = {
        "enableCompletedDownloadHandling": True,
        "skipFreeSpaceCheckWhenImporting": True,
        "minimumFreeSpaceWhenImporting": 0,
    }
    if all(cfg.get(key) == value for key, value in want.items()):
        return
    updated = dict(cfg)
    updated.update(want)
    ident = cfg.get("id", 1)
    http(
        "PUT",
        f"{base}/config/mediamanagement/{ident}",
        updated,
        headers=arr_headers(api_key),
    )
    log(f"{kind} import into library folders (skip NAS free-space check)")


def refresh_monitored_downloads(base: str, api_key: str, kind: str) -> None:
    http(
        "POST",
        f"{base}/command",
        {"name": "RefreshMonitoredDownloads"},
        headers=arr_headers(api_key),
    )
    log(f"{kind} checking completed downloads")


def log_stuck_imports(base: str, api_key: str, kind: str) -> None:
    try:
        payload = http(
            "GET",
            f"{base}/queue?page=1&pageSize=50&includeUnknownMovieItems=true"
            "&includeUnknownSeriesItems=true",
            headers=arr_headers(api_key),
        )
    except RuntimeError as exc:
        log(f"{kind} queue: {exc}", "WARNING")
        return
    records = as_list(payload)
    if isinstance(payload, dict) and not records:
        records = as_list(payload.get("records"))
    for item in records:
        state = str(item.get("trackedDownloadState") or "")
        status = str(item.get("trackedDownloadStatus") or "").lower()
        if status not in {"warning", "error"} and state not in {
            "importPending",
            "importBlocked",
            "failed",
            "failedPending",
        }:
            continue
        bits = []
        for msg in item.get("statusMessages") or []:
            if isinstance(msg, dict):
                title = msg.get("title")
                messages = msg.get("messages") or []
                if title:
                    bits.append(str(title))
                bits.extend(str(part) for part in messages if part)
        extra = "; ".join(bits) or item.get("errorMessage") or state or status
        log(
            f"{kind} download not in the library yet: {item.get('title')} ({extra})",
            "WARNING",
        )


def first_profile(base: str, api_key: str):
    profiles = as_list(http("GET", f"{base}/qualityprofile", headers=arr_headers(api_key)))
    if not profiles:
        raise RuntimeError(f"no quality profiles at {base}")
    return int(profiles[0]["id"]), profiles[0].get("name") or "Default"


# Three Seerr-selectable profiles. Quality definition sizes are global (MB/minute,
# not total GB), so Default and Max must not share the same quality's maxSize:
# Default disallows remux/4K; Max uses those names with large caps.
PROFILE_DEFAULT = "Default"
PROFILE_MAX = "Max"
PROFILE_ANYTHING = "Anything"
PROFILE_NAMES = (PROFILE_DEFAULT, PROFILE_MAX, PROFILE_ANYTHING)
LEGACY_DEFAULT_NAMES = ("HD", "Any")

# Worst → best. Arr treats later items as higher quality.
DEFAULT_GROUPS = (
    ("HDTV-720p", ("HDTV-720p",)),
    ("WEB 720p", ("WEBDL-720p", "WEBRip-720p")),
    ("Bluray-720p", ("Bluray-720p",)),
    ("HDTV-1080p", ("HDTV-1080p",)),
    ("WEB 1080p", ("WEBDL-1080p", "WEBRip-1080p")),
    ("Bluray-1080p", ("Bluray-1080p",)),
)
