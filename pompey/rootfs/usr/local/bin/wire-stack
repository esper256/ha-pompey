    return env("INDEXER_API_KEY")


def qbit_url() -> str:
    return env("QBIT_URL", "http://127.0.0.1:8080").rstrip("/")


def sonarr_url() -> str:
    return env("SONARR_URL", "http://127.0.0.1:8989").rstrip("/")


def radarr_url() -> str:
    return env("RADARR_URL", "http://127.0.0.1:7878").rstrip("/")


def arr_api_root(base: str, api_key: str) -> str:
    """Prefer /api/v3; use /api/v4 when v3 is gone. Do not hard-fail the wire."""
    host = base.rstrip("/")
    for ver in ("v3", "v4"):
        root = f"{host}/api/{ver}"
        try:
            http("GET", f"{root}/qualityprofile", headers=arr_headers(api_key))
            return root
        except RuntimeError as exc:
            msg = str(exc)
            if "-> 404" in msg:
                continue
            if "-> 400" in msg or "-> 401" in msg:
                return root
            continue
    log(f"Arr API v3/v4 missing at {host}; using /api/v3", "WARNING")
    return f"{host}/api/v3"


def prowlarr_url() -> str:
    return env("PROWLARR_URL", "http://127.0.0.1:9696").rstrip("/")


def prowlarr_arr_url() -> str:
    """Radarr/Sonarr talk to Prowlarr through the title-search caps proxy."""
    return env("PROWLARR_ARR_URL", "http://127.0.0.1:9698").rstrip("/")


def seerr_url() -> str:
    return env("SEERR_URL", "http://127.0.0.1:5055").rstrip("/")


def seerr_config_dir() -> str:
    return env("SEERR_CONFIG") or os.path.join(env("POMPEY_CONFIG", "/config"), "seerr")


def seerr_api_key_from_disk() -> str:
    """Seerr writes main.apiKey on first start. That key is admin; /auth/local is not.

    POST /api/v1/auth/local only signs in an existing local user. The first admin is
    created by the Plex (or Jellyfin) setup wizard. A generated pompey@local password
    therefore 403s on a real Seerr, which is why the wait screen came back after 0.2.13.
    """
    path = os.path.join(seerr_config_dir(), "settings.json")
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError, TypeError):
        return ""
    if not isinstance(data, dict):
        return ""
    main = data.get("main") if isinstance(data.get("main"), dict) else data
    key = main.get("apiKey") if isinstance(main, dict) else None
    return key.strip() if isinstance(key, str) else ""


# Seerr: REQUEST + AUTO_APPROVE + AUTO_APPROVE_MOVIE + AUTO_APPROVE_TV + REQUEST_ADVANCED
# REQUEST_ADVANCED (8192) is what shows the quality-profile dropdown on a request.
SEERR_HOUSEHOLD_PERMS = 32 + 128 + 256 + 512 + 8192
SEERR_REQUEST_ADVANCED = 8192


def seerr_permission_update(user: dict) -> dict | None:
    """PUT /api/v1/user/{id} body. Echoing GET fields 400s (email is read-only)."""
    try:
        perms = int(user.get("permissions") or 0)
    except (TypeError, ValueError):
        return None
    if perms & SEERR_REQUEST_ADVANCED:
        return None
    return {"permissions": perms | SEERR_REQUEST_ADVANCED}


# Seerr MediaRequestStatus. Declined stays in the list; Available/Completed stay
# open until the household removes the request (the ticket, not Clear Data).
SEERR_REQUEST_DECLINED = 3


def log(msg: str, level: str = "INFO") -> None:
    stamp = time.strftime("%H:%M:%S")
    print(f"[{stamp}] {level}: [wire-stack] {msg}", flush=True)


def _quiet_path() -> str:
    return os.path.join(ready_dir(), "log-quiet.json")


def _load_quiet() -> dict:
    try:
        with open(_quiet_path(), encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError, TypeError):
        return {}


def _save_quiet(state: dict) -> None:
    path = _quiet_path()
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(state, fh, sort_keys=True)
    os.replace(tmp, path)


def log_if_new(key: str, msg: str, level: str = "INFO") -> None:
    """Skip a housekeep line that has not changed since the last cycle.

    Housekeep is a new process every few minutes, so this is a small file
    under POMPEY_READY — not in-memory.
    """
    state = _load_quiet()
    if state.get(key) == msg:
        return
    state[key] = msg
    _save_quiet(state)
    log(msg, level)


def forget_quiet(key: str) -> None:
    state = _load_quiet()
    if key not in state:
        return
    state.pop(key, None)
    _save_quiet(state)


def mark_status(step: str, label: str, percent: int, error: str = "") -> None:
    script = shutil.which("pompey-status")
    if not script:
        sibling = os.path.join(os.path.dirname(os.path.abspath(__file__)), "pompey-status")
        if os.path.isfile(sibling):
            script = sibling
    if not script:
        return
    cmd = [sys.executable, script, step, label, str(percent)]
    if error:
        cmd.append(error)
    subprocess.run(cmd, check=False)


def load_secrets() -> dict:
    with open(secrets_path(), encoding="utf-8") as fh:
        return json.load(fh)


def http(method: str, url: str, body=None, headers=None, timeout=30):
    data = None
    hdrs = dict(headers or {})
    if body is not None:
        if isinstance(body, (bytes, bytearray)):
            data = body
            hdrs.setdefault("Content-Type", "application/x-www-form-urlencoded")
        elif isinstance(body, str):
            data = body.encode()
        else:
            data = json.dumps(body).encode()
            hdrs.setdefault("Content-Type", "application/json")
    attempts = 3
    last: Exception | None = None
    for attempt in range(attempts):
        req = urllib.request.Request(url, data=data, method=method, headers=hdrs)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                raw = resp.read()
                if not raw:
                    return None
                text = raw.decode(errors="replace")
                try:
                    return json.loads(text)
                except json.JSONDecodeError:
                    return text
        except urllib.error.HTTPError as exc:
            err = exc.read().decode(errors="replace")
            last = RuntimeError(f"{method} {url} -> {exc.code} {err[:300]}")
            if exc.code in {502, 503, 504} and attempt + 1 < attempts:
                time.sleep(wait_sleep())
                continue
            raise last from exc
        except urllib.error.URLError as exc:
            last = RuntimeError(f"{method} {url} -> {exc}")
            raise last from exc
    raise last or RuntimeError(f"{method} {url} failed")


def wait_http(url: str, tries: int | None = None):
    last = None
    n = wait_tries() if tries is None else tries
    for _ in range(n):
        try:
            req = urllib.request.Request(url, method="GET")
            with urllib.request.urlopen(req, timeout=10) as resp:
                return resp.read()
        except urllib.error.HTTPError as exc:
            if exc.code < 500:
                return b""
            last = exc
        except Exception as exc:  # noqa: BLE001
            last = exc
        time.sleep(wait_sleep())
    raise RuntimeError(f"timeout {url}: {last}")


def arr_headers(api_key: str) -> dict:
    return {"X-Api-Key": api_key, "Content-Type": "application/json"}


def ensure_root_folder(base: str, api_key: str, path: str) -> None:
    if paths_overlap(path, downloads_complete()) or paths_overlap(path, downloads_manual()):
        log(
            f"refusing Arr root folder that overlaps a download drop: {path}",
            "ERROR",
        )
        return
    existing = as_list(http("GET", f"{base}/rootfolder", headers=arr_headers(api_key)))
    if any(item.get("path", "").rstrip("/") == path.rstrip("/") for item in existing):
        return
    try:
        http("POST", f"{base}/rootfolder", {"path": path}, headers=arr_headers(api_key))
    except RuntimeError as exc:
        # A leftover parent root (0.2.20 `/media/TV`) can block a nested
        # household folder until prune_root_folders deletes it.
        log(f"root folder {path}: {exc}", "WARNING")
        return
    log(f"root folder {path}")


def in_root(path: str, root: str) -> bool:
    path = (path or "").rstrip("/")
    root = (root or "").rstrip("/")
    return bool(root) and (path == root or path.startswith(root + "/"))


def leftover_root_dest(path: str, kid: str, gen: str, auto: str) -> str:
    """Map a stale Arr root onto today's kid / general / By Rating dest.

    0.2.20 used `/media` + `TV` / `Kid Friendly TV` (and `Movies` /
    `Kid Friendly Movies`). 0.2.21 moved to `/media/dlna` + sibling
    Kid / Not Kid folders. Seerr lists every Arr root, so those old
    paths stay in the request dropdown until we delete them.
    """
    low = (path or "").rstrip("/").lower()
    if "not kid" in low:
        return gen
    if "kid friendly" in low:
        return kid
    return auto


def wanted_arr_roots(kind: str) -> tuple[str, str, str]:
    """auto, general, kid. Same three names for movies and TV."""
    if kind == "sonarr":
        return tv_auto_dir(), tv_dir(), tv_kid_dir()
    return movies_auto_dir(), movies_dir(), movies_kid_dir()


def title_on_leftover_root(path: str, leftover: str, wanted: set[str]) -> bool:
    """True when a title still lives on a stale root, not a current one.

    `/media/Movies/By Rating/Title` is under leftover `/media/Movies`
    but also under the wanted By Rating root — leave it alone.
    """
    if not in_root(path, leftover):
        return False
    return not any(in_root(path, root) for root in wanted)


def rehome_titles_off_root(
    base: str, api_key: str, kind: str, leftover: str, dest: str, wanted: set[str]
) -> int:
    collection = arr_title_collection(kind)
    try:
        rows = as_list(http("GET", f"{base}/{collection}", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"{kind} titles on leftover root {leftover}: {exc}", "WARNING")
        return 0
    ids = []
    for item in rows:
        if not title_on_leftover_root(title_library_path(item), leftover, wanted):
            continue
        tid = title_id_of(item)
        if tid is not None:
            ids.append(tid)
    if not ids:
        return 0
    id_key = "movieIds" if kind == "radarr" else "seriesIds"
    try:
        http(
            "PUT",
            f"{base}/{collection}/editor",
            {id_key: ids, "rootFolderPath": dest, "moveFiles": True},
            headers=arr_headers(api_key),
        )
        return len(ids)
    except RuntimeError as exc:
        log(f"{kind} could not move {len(ids)} title(s) off {leftover}: {exc}", "WARNING")
        return 0


def rehome_import_lists_off_root(
    base: str, api_key: str, kind: str, leftover: str, dest: str
) -> int:
    try:
        rows = as_list(http("GET", f"{base}/importlist", headers=arr_headers(api_key)))
    except RuntimeError:
        return 0
    moved = 0
    leftover = leftover.rstrip("/")
    dest = dest.rstrip("/")
    for item in rows:
        have = (item.get("rootFolderPath") or "").rstrip("/")
        if have != leftover:
            continue
        tid = title_id_of(item)
        if tid is None:
            continue
        payload = json.loads(json.dumps(item))
        payload["rootFolderPath"] = dest
        try:
            http(
                "PUT",
                f"{base}/importlist/{tid}",
                payload,
                headers=arr_headers(api_key),
            )
            moved += 1
        except RuntimeError as exc:
            log(f"{kind} could not move import list {tid} off {leftover}: {exc}", "WARNING")
    return moved


def prune_root_folders(base: str, api_key: str, kind: str) -> None:
    """Seerr lists every Arr root. Keep only By Rating + Kid + Not Kid."""
    auto, gen, kid = wanted_arr_roots(kind)
    wanted = {auto.rstrip("/"), gen.rstrip("/"), kid.rstrip("/")}
    try:
        existing = as_list(http("GET", f"{base}/rootfolder", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"{kind} root folders: {exc}", "WARNING")
        return
    for item in existing:
        path = (item.get("path") or "").rstrip("/")
        ident = item.get("id")
        if not path or path in wanted:
            continue
        dest = leftover_root_dest(path, kid, gen, auto)
        moved = rehome_titles_off_root(base, api_key, kind, path, dest, wanted)
        lists = rehome_import_lists_off_root(base, api_key, kind, path, dest)
        if moved:
            log(f"{kind} moved {moved} title(s) from leftover root {path} -> {dest}")
        if lists:
            log(f"{kind} moved {lists} import list(s) from leftover root {path} -> {dest}")
        if ident is None:
            log(f"{kind} leftover root {path} has no id; leaving it", "WARNING")
            continue
        try:
            http(
                "DELETE",
                f"{base}/rootfolder/{ident}",
                headers=arr_headers(api_key),
            )
            log(f"removed leftover root folder {path}")
        except RuntimeError as exc:
            log(f"could not remove root folder {path}: {exc}", "WARNING")


def sync_root_folders(base: str, api_key: str, kind: str) -> None:
    auto, gen, kid = wanted_arr_roots(kind)
    for path in (auto, gen, kid):
        ensure_root_folder(base, api_key, path)
    prune_root_folders(base, api_key, kind)
    for path in (auto, gen, kid):
        ensure_root_folder(base, api_key, path)


def schema_impl(schema, name: str):
    for item in as_list(schema):
        if item.get("implementation") == name:
            return json.loads(json.dumps(item))
    raise RuntimeError(f"schema missing {name}")


def fill_fields(resource: dict, values: dict) -> dict:
    for field in resource.get("fields") or []:
        n = field.get("name")
        if n in values:
            field["value"] = values[n]
    return resource


def set_app_fields(resource: dict, values: dict) -> dict:
    """Set Prowlarr application fields, appending any the existing row omitted."""
    fill_fields(resource, values)
    fields = resource.get("fields")
    if not isinstance(fields, list):
        fields = []
        resource["fields"] = fields
    have = {field.get("name") for field in fields}
    for name, value in values.items():
        if name not in have:
            fields.append({"name": name, "value": value})
    return resource


# Newznab movie / TV buckets Prowlarr syncs into Radarr / Sonarr.
RADARR_SYNC_CATS = [2000, 2010, 2020, 2030, 2040, 2045, 2050, 2060, 2070, 2080, 2090]
SONARR_SYNC_CATS = [5000, 5010, 5020, 5030, 5040, 5045, 5050, 5060, 5070, 5080, 5090]
SEARCH_FLAGS = ("enableRss", "enableAutomaticSearch", "enableInteractiveSearch")
# Prowlarr → Sonarr. Off (or omitted on an old app row) means SeasonSearch for
# anime still walks every absolute episode and never asks for S01 packs.
SONARR_ANIME_STANDARD_SEARCH = "syncAnimeStandardFormatSearch"
SONARR_INDEXER_ANIME_STANDARD = "animeStandardFormatSearch"
CUTOFF_SEARCH_KIND = "season-v1"


def app_field(app: dict, name: str):
    for field in app.get("fields") or []:
        if field.get("name") == name:
            return field.get("value")
    return None


def field_is_true(resource: dict, name: str) -> bool:
    return app_field(resource, name) is True


def cats_match(value, want: list[int]) -> bool:
    if not isinstance(value, list):
        return False
    try:
        have = sorted(int(item) for item in value)
    except (TypeError, ValueError):
        return False
    return have == sorted(want)


def sync_cats_for(impl: str) -> list[int]:
    return list(RADARR_SYNC_CATS if impl == "Radarr" else SONARR_SYNC_CATS)


def qbit_client_values(secrets: dict, kind: str) -> tuple[str, dict]:
    if kind == "radarr":
        cat = "radarr"
    elif kind == "sonarr":
        cat = "sonarr"
    elif kind == "prowlarr":
        cat = "prowlarr"
    else:
        raise ValueError(f"unknown download client kind {kind!r}")
    values = {
        "host": "127.0.0.1",
        "port": 8080,
        "username": secrets["qbit_user"],
        "password": secrets["qbit_password"],
        "movieCategory": cat,
        "tvCategory": cat,
        "category": cat,
        "useSsl": False,
    }
    if kind == "prowlarr":
        # Prowlarr Search → Grab picks a category from the release type.
        values["musicCategory"] = cat
        values["bookCategory"] = cat
    return cat, values


def download_client_ready(item: dict, cat: str, remove: bool) -> bool:
    if item.get("removeCompletedDownloads") is not remove:
        return False
    if item.get("removeFailedDownloads") is not True:
        return False
    if item.get("enable") is not True:
        return False
    return cat in {
        app_field(item, "movieCategory"),
        app_field(item, "tvCategory"),
        app_field(item, "category"),
    }


def apply_download_client(item: dict, values: dict, remove: bool) -> dict:
    updated = json.loads(json.dumps(item))
    set_app_fields(updated, values)
    updated["enable"] = True
    updated["removeCompletedDownloads"] = remove
    updated["removeFailedDownloads"] = True
    return updated


def ensure_download_client(base: str, api_key: str, secrets: dict, kind: str) -> None:
    remove = after_download() == "stop_sharing"
    cat, values = qbit_client_values(secrets, kind)
    existing = as_list(http("GET", f"{base}/downloadclient", headers=arr_headers(api_key)))
    for item in existing:
        if item.get("implementation") != "QBittorrent" or item.get("id") is None:
            continue
        if download_client_ready(item, cat, remove):
            return
        updated = apply_download_client(item, values, remove)
        http(
            "PUT",
            f"{base}/downloadclient/{item['id']}",
            updated,
            headers=arr_headers(api_key),
        )
        log(f"{kind} download client category={cat} after_download={after_download()} remove={remove}")
        return
    schema = http("GET", f"{base}/downloadclient/schema", headers=arr_headers(api_key))
    client = apply_download_client(schema_impl(schema, "QBittorrent"), values, remove)
    client["name"] = "qBittorrent"
    client["priority"] = 1
    http("POST", f"{base}/downloadclient", client, headers=arr_headers(api_key))
    log(f"{kind} download client category={cat} after_download={after_download()} remove={remove}")


def ensure_prowlarr_download_client(prowlarr: str, pkey: str, secrets: dict) -> None:
    """Prowlarr Search → Grab. Separate qbit category so Arr CDH cannot mis-import.

    Arr Interactive Search uses Radarr/Sonarr's own clients (radarr / sonarr).
    Reusing those categories here would let Radarr claim a TV grab. Prowlarr is
    not the importer — leave completed torrents in qbit so housekeep/Arr can
    see the files. Save path is downloads/manual (not complete/, and not an
    Arr library root).
    """
    remove = False
    cat, values = qbit_client_values(secrets, "prowlarr")
    existing = as_list(http("GET", f"{prowlarr}/api/v1/downloadclient", headers=arr_headers(pkey)))
    for item in existing:
        if item.get("implementation") != "QBittorrent" or item.get("id") is None:
            continue
        if download_client_ready(item, cat, remove):
            return
        updated = apply_download_client(item, values, remove)
        http(
            "PUT",
            f"{prowlarr}/api/v1/downloadclient/{item['id']}",
            updated,
            headers=arr_headers(pkey),
        )
        log(f"prowlarr download client category={cat} removeCompleted={remove}")
        return
    schema = http("GET", f"{prowlarr}/api/v1/downloadclient/schema", headers=arr_headers(pkey))
    client = apply_download_client(schema_impl(schema, "QBittorrent"), values, remove)
    client["name"] = "qBittorrent"
    client["priority"] = 1
    http("POST", f"{prowlarr}/api/v1/downloadclient", client, headers=arr_headers(pkey))
    log(f"prowlarr download client category={cat} removeCompleted={remove}")


# Sonarr (and current Radarr) reject 0: "must be greater than or equal to 100".
# skipFreeSpaceCheckWhenImporting is what ignores a NAS that reports 0 bytes free.
MIN_IMPORT_FREE_SPACE = 100


def ensure_media_management(base: str, api_key: str, kind: str) -> None:
    """Import completed torrents into the library folder Seerr asked for.

    Network media shares (this house: /media/dlna) often report 0 free space, so
    Radarr/Sonarr skip import and the file sits in downloads/complete. Auto
    completed-download handling must stay on. Hardlinks do not work on CIFS, and
    the copy fallback is a slow second write — same-share rename (Move) is the
    household path. Do not fail the wait screen if this PUT 400s — quality
    profiles and Seerr still need to wire.
    """
    try:
        cfg = http("GET", f"{base}/config/mediamanagement", headers=arr_headers(api_key))
    except RuntimeError as exc:
        log(f"{kind} media management: {exc}", "WARNING")
        return
    if not isinstance(cfg, dict):
        log(f"{kind} media management missing", "WARNING")
        return
    want = {
        "enableCompletedDownloadHandling": True,
        "skipFreeSpaceCheckWhenImporting": True,
        "minimumFreeSpaceWhenImporting": MIN_IMPORT_FREE_SPACE,
        "copyUsingHardlinks": False,
        "importExtraFiles": True,
        "extraFileExtensions": "srt",
    }
    # Recycle bin is how Arr upgrades avoid permanently deleting a library file
    # (empty recycleBin + ManualImport/CDH upgrade = dest gone if the move fails).
    extra = {
        "recycleBin": downloads_recycle(),
        "recycleBinCleanupDays": 0,
        "deleteEmptyFolders": False,
        "useScriptImport": False,
        "autoUnmonitorPreviouslyDownloadedEpisodes": False,
        "autoUnmonitorPreviouslyDownloadedMovies": False,
    }
    for key, value in extra.items():
        if key in cfg:
            want[key] = value
    recycle = want.get("recycleBin")
    if recycle:
        try:
            os.makedirs(recycle, exist_ok=True)
        except OSError as exc:
            log(f"{kind} recycle folder: {exc}", "WARNING")
    if all(cfg.get(key) == value for key, value in want.items()):
        return
    updated = dict(cfg)
    updated.update(want)
    ident = cfg.get("id", 1)
    try:
        http(
            "PUT",
            f"{base}/config/mediamanagement/{ident}",
            updated,
            headers=arr_headers(api_key),
        )
    except RuntimeError as exc:
        log(f"{kind} media management: {exc}", "WARNING")
        return
    log(
        f"{kind} import into library folders (rename on the NAS, skip free-space check, "
        "old files go to downloads/recycle)"
    )


def tickle_seerr_availability() -> None:
    """Seerr marks requests available from Plex (recently-added ~5 min) and Arr.

    Import into the library folder is not enough by itself — Seerr has to notice
    Plex or Radarr/Sonarr. Ask those jobs to run now instead of waiting.
    """
    key = seerr_api_key_from_disk()
    if not key:
        return
    s = Seerr()
    s.api_key = key
    ran: list[str] = []
    jobs = (
        "plex-recently-added-scan",
        "plex-recently-added",
        "radarr-scan",
        "sonarr-scan",
    )
    for job in jobs:
        try:
            s.call("POST", f"/api/v1/settings/jobs/{job}/run")
            ran.append(job)
        except RuntimeError as exc:
            if "404" in str(exc):
                continue
            if "403" in str(exc):
                return
            log(f"seerr {job}: {exc}", "WARNING")
    if ran:
        log_if_new(
            "seerr-tickle",
            "seerr checking Plex and Arr for titles that landed in the library",
        )


def ensure_download_client_handling(base: str, api_key: str, kind: str) -> None:
    """Keep completed-download handling on. Do not grab the same title again if
    a torrent was dropped before the file was renamed into the library.
    """
    try:
        cfg = http("GET", f"{base}/config/downloadclient", headers=arr_headers(api_key))
    except RuntimeError as exc:
        log(f"{kind} download-client config: {exc}", "WARNING")
        return
    if not isinstance(cfg, dict):
        log(f"{kind} download-client config missing", "WARNING")
        return
    want = {
        "enableCompletedDownloadHandling": True,
        "autoRedownloadFailed": False,
    }
    if "autoRedownloadFailedFromInteractiveSearch" in cfg:
        want["autoRedownloadFailedFromInteractiveSearch"] = False
    if all(cfg.get(key) == value for key, value in want.items()):
        return
    updated = dict(cfg)
    updated.update(want)
    ident = cfg.get("id", 1)
    try:
        http(
            "PUT",
            f"{base}/config/downloadclient/{ident}",
            updated,
            headers=arr_headers(api_key),
        )
    except RuntimeError as exc:
        log(f"{kind} download-client config: {exc}", "WARNING")
        return
    log(f"{kind} completed-download handling on (no auto re-download)")


def refresh_monitored_downloads(base: str, api_key: str, kind: str) -> None:
    http(
        "POST",
        f"{base}/command",
        {"name": "RefreshMonitoredDownloads"},
        headers=arr_headers(api_key),
    )
    key = f"check:{kind}"
    if count_complete_videos() == 0:
        forget_quiet(key)
        return
    log_if_new(key, f"{kind} checking completed downloads")


def log_stuck_imports(base: str, api_key: str, kind: str) -> None:
    """Arr only warns on a failed move. A finished torrent still in complete/ with
    status ok is the silent case: Seerr already handed Arr the library folder,
    qBittorrent never gets that path, and Arr has not started the import yet.
    """
    try:
        payload = http(
            "GET",
            f"{base}/queue?page=1&pageSize=50&includeUnknownMovieItems=true"
            "&includeUnknownSeriesItems=true",
            headers=arr_headers(api_key),
        )
    except RuntimeError as exc:
        log(f"{kind} queue: {exc}", "WARNING")
        return
    records = as_list(payload)
    shown = 0
    for item in records:
        if not queue_needs_import_log(item):
            continue
        bits = []
        for msg in item.get("statusMessages") or []:
            if isinstance(msg, dict):
                title = msg.get("title")
                messages = msg.get("messages") or []
                if title:
                    bits.append(str(title))
                bits.extend(str(part) for part in messages if part)
        extra = (
            "; ".join(bits)
            or item.get("errorMessage")
            or item.get("trackedDownloadState")
            or item.get("trackedDownloadStatus")
            or item.get("status")
            or "still in the download folder"
        )
        dest = item.get("outputPath") or ""
        where = f" qbit={dest}" if dest else ""
        msg = (
            f"{kind} download not in the library yet: {item.get('title')} ({extra}){where}"
        )
        log_if_new(f"stuck:{kind}:{item.get('title')}", msg, "WARNING")
        shown += 1
        if shown >= 15:
            break


def title_library_path(item: dict) -> str:
    path = item.get("path") or item.get("rootFolderPath") or ""
    if isinstance(path, str) and path.strip():
        return path.strip()
    return ""


def title_needs_library_file(item: dict, kind: str) -> bool:
    """True when a monitored title is still missing library video.

    Movies: hasFile is False. Series: monitored episodeCount is greater than
    episodeFileCount (a show with S01 on disk can still be waiting on S02).
    """
    if not isinstance(item, dict) or item.get("monitored") is not True:
        return False
    if kind == "radarr":
        return item.get("hasFile") is False
    stats = item.get("statistics") if isinstance(item.get("statistics"), dict) else {}
    try:
        files = int(stats.get("episodeFileCount") or 0)
        wanted = int(stats.get("episodeCount") or 0)
    except (TypeError, ValueError):
        files, wanted = 0, 0
    if not stats:
        return True
    return wanted > 0 and files < wanted


def log_titles_waiting_for_library(base: str, api_key: str, kind: str) -> None:
    """Show the folder Seerr/Arr already stored. Empty path means the handoff never landed."""
    endpoint = "movie" if kind == "radarr" else "series"
    try:
        rows = as_list(http("GET", f"{base}/{endpoint}", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"{kind} library list: {exc}", "WARNING")
        return
    waiting: list[str] = []
    for item in rows:
        if not title_needs_library_file(item, kind):
            continue
        dest = title_library_path(item) or "NO PATH (Seerr/Arr never stored a library folder)"
        waiting.append(f"{item.get('title')} -> {dest}")
        if len(waiting) >= 10:
            break
    if waiting:
        log_if_new(
            f"wait:{kind}",
            f"{kind} titles with no library file yet: {'; '.join(waiting)}",
            "WARNING",
        )


def parse_arr_time(raw) -> datetime.datetime | None:
    if not isinstance(raw, str) or not raw.strip():
        return None
    text = raw.strip().replace("Z", "+00:00")
    try:
        dt = datetime.datetime.fromisoformat(text)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=datetime.timezone.utc)
    return dt.astimezone(datetime.timezone.utc)


def age_label(raw, now: datetime.datetime | None = None) -> str:
    dt = parse_arr_time(raw)
    if dt is None:
        return ""
    now = now or datetime.datetime.now(datetime.timezone.utc)
    seconds = int((now - dt).total_seconds())
    if seconds < 0:
        seconds = 0
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    hours = seconds // 3600
    if hours < 48:
        return f"{hours}h"
    return f"{hours // 24}d"


def command_search_target(item: dict) -> str:
    body = item.get("body") if isinstance(item.get("body"), dict) else item
    if not isinstance(body, dict):
        return ""
    series = body.get("seriesTitle") or body.get("series")
    if isinstance(series, dict):
        series = series.get("title")
    bits = []
    if isinstance(series, str) and series.strip():
        bits.append(series.strip())
    season = body.get("seasonNumber")
    if season is not None:
        try:
            bits.append(f"S{int(season):02d}")
        except (TypeError, ValueError):
            bits.append(f"S{season}")
    ids = body.get("episodeIds")
    if isinstance(ids, list) and ids:
        bits.append(f"{len(ids)} episode(s)")
    movie = body.get("movieTitle") or body.get("movie")
    if isinstance(movie, dict):
        movie = movie.get("title")
    if isinstance(movie, str) and movie.strip():
        bits.append(movie.strip())
    return " ".join(bits)


def format_arr_command(item: dict, now: datetime.datetime | None = None) -> str:
    name = str(item.get("name") or item.get("commandName") or "command")
    status = str(item.get("status") or "unknown").lower()
    stamp = item.get("started") or item.get("queued") or ""
    age = age_label(stamp, now)
    target = command_search_target(item)
    priority = str(item.get("priority") or "").lower()
    bits = [status, name]
    if age:
        bits.append(age)
    if priority and priority != "normal":
        bits.append(priority)
    if target:
        bits.append(f"({target})")
    return " ".join(bits)


def summarize_arr_commands(rows: list, now: datetime.datetime | None = None) -> str:
    live = []
    for item in rows:
        if not isinstance(item, dict):
            continue
        status = str(item.get("status") or "").lower()
        if status in {"completed", "cancelled", "aborted"}:
            continue
        live.append(format_arr_command(item, now))
    if not live:
        return "none queued or started"
    live = live[:8]
    extra = "" if len(live) < 8 else " …"
    return "; ".join(live) + extra


def missing_episode_label(item: dict) -> str:
    series = item.get("series") if isinstance(item.get("series"), dict) else {}
    show = series.get("title") or item.get("seriesTitle") or item.get("title") or "episode"
    try:
        season = int(item.get("seasonNumber"))
        episode = int(item.get("episodeNumber"))
        return f"{show} S{season:02d}E{episode:02d}"
    except (TypeError, ValueError):
        return str(show)


def count_complete_videos() -> int:
    count = 0
    try:
        for root in download_drop_roots():
            if not os.path.isdir(root):
                continue
            for dirpath, dirnames, filenames in os.walk(root):
                dirnames[:] = [name for name in dirnames if not name.startswith(".")]
                for name in filenames:
                    if name.startswith("."):
                        continue
                    if is_video_file(name):
                        count += 1
                        if count >= 50:
                            return count
    except OSError:
        return count
    return count


def log_arr_command_queue(base: str, api_key: str, kind: str) -> None:
    """Queue state *before* housekeeping posts more Refresh/Scan commands."""
    try:
        payload = http("GET", f"{base}/command", headers=arr_headers(api_key))
    except RuntimeError as exc:
        log(f"{kind} command queue: {exc}", "WARNING")
        return
    summary = summarize_arr_commands(as_list(payload))
    log(f"{kind} commands: {summary}")


def log_sonarr_missing(base: str, api_key: str) -> None:
    try:
        payload = http(
            "GET",
            f"{base}/wanted/missing?page=1&pageSize=20&sortKey=airDateUtc"
            "&sortDirection=descending",
            headers=arr_headers(api_key),
        )
    except RuntimeError as exc:
        log(f"sonarr wanted/missing: {exc}", "WARNING")
        return
    records = as_list(payload)
    total = len(records)
    if isinstance(payload, dict):
        try:
            total = int(payload.get("totalRecords") or total)
        except (TypeError, ValueError):
            pass
    labels = [missing_episode_label(item) for item in records[:8]]
    shown = ", ".join(labels) if labels else "none"
    extra = "" if total <= 8 else " …"
    log(f"sonarr wanted/missing: {total} ({shown}{extra})")


def log_search_diagnostics(radarr: str, rk: str, sonarr: str, sk: str) -> None:
    """Enough to tell a stalled EpisodeSearch from an empty complete/ scan flood.

    Read these lines *above* any 'checking completed downloads' / 'scanning'
    lines from the same housekeep. Refresh/Scan themselves are skipped when
    complete/ is empty or a search is already running.
    """
    videos = count_complete_videos()
    cap = "+" if videos >= 50 else ""
    log(f"complete/: {videos}{cap} video(s) on disk before Refresh/Scan")
    log_arr_command_queue(radarr, rk, "radarr")
    log_arr_command_queue(sonarr, sk, "sonarr")
    log_sonarr_missing(sonarr, sk)


def queue_needs_import_log(item: dict) -> bool:
    if not isinstance(item, dict):
        return False
    state = str(item.get("trackedDownloadState") or "")
    tracked = str(item.get("trackedDownloadStatus") or "").lower()
    if tracked in {"warning", "error"} or state in {
        "importPending",
        "importBlocked",
        "failed",
        "failedPending",
    }:
        return True
    output = str(item.get("outputPath") or "")
    if output.strip() and path_under_drop(output):
        return True
    return False


def first_profile(base: str, api_key: str):
    profiles = as_list(http("GET", f"{base}/qualityprofile", headers=arr_headers(api_key)))
    if not profiles:
        raise RuntimeError(f"no quality profiles at {base}")
    return int(profiles[0]["id"]), profiles[0].get("name") or "Default"


# Three Seerr-selectable names. Recyclarr/TRaSH owns Default and Max (qualities,
# sizes, scores). Pompey only creates those names if they are missing, and owns
# Anything (CAM allowed). Do not PUT Default/Max items — that was a second TRaSH.
PROFILE_DEFAULT = "Default"
PROFILE_MAX = "Max"
PROFILE_ANYTHING = "Anything"
PROFILE_NAMES = (PROFILE_DEFAULT, PROFILE_MAX, PROFILE_ANYTHING)
LEGACY_DEFAULT_NAMES = ("HD", "Any")
DUAL_AUDIO = "Pompey Dual Audio"
DUAL_AUDIO_SCORE = 15
# Dual Audio is two audio tracks (JA+EN). Dual Subs is two subtitle tracks.
# Bare DUAL is an anime [DUAL] / .DUAL. tag — not Dual Subs / Dual Subtitles.
DUAL_AUDIO_RE = (
    r"(?:Dual[-_. ]?Audio|DualAudio|Multi[-_. ]?Audio|JA[-+&/]+EN|EN[-+&/]+JA|"
    r"[(\[]DUAL[)\]]|(?<![A-Za-z])DUAL(?![A-Za-z]|[-_. ]?Subs?))"
)
DUAL_SUBS_RE = r"dual[-_. ]?subs?(?:titles?)?"
DUAL_SUBS_SPEC_NAME = "Not Dual Subs"
# Title CFs. Scores are per-profile; -10000 is a hard reject.
CUSTOM_FORMATS = (
    (
        "Pompey Reject CAM/TS",
        r"(CAMRip|HDCAM|TELESYNC|HDTS|TELECINE|HDTC|WORKPRINT|[-_.]CAM[-_.])",
    ),
    (
        "Pompey Reject Remux/DISK",
        r"\b(REMUX|BD[-_. ]?DISK|BRDISK|COMPLETE[-_. ]?BLURAY)\b",
    ),
    ("Pompey Prefer WEB-DL", r"\bWEB[-_. ]?DL\b"),
    ("Pompey Prefer x265", r"\b(x265|h265|HEVC)\b"),
    ("Pompey Prefer Proper", r"\b(PROPER|REPACK|RERIP)\b"),
    ("Pompey Prefer Remux", r"\bREMUX\b"),
    (
        "Pompey Prefer lossless audio",
        r"\b(TrueHD|TRUEHD|DTS[-_. ]?HD(?:MA)?|DTS[-_. ]?X|Atmos|ATMOS|FLAC|LPCM)\b",
    ),
    (DUAL_AUDIO, DUAL_AUDIO_RE),
)

# Arr language id -2 is the title's original audio (TMDB / series metadata).
NOT_ORIGINAL_LANGUAGE = "Pompey Not Original Language"


def quality_catalog(profile: dict) -> dict:
    catalog = {}
    for item in profile.get("items") or []:
        if not isinstance(item, dict):
            continue
        q = item.get("quality")
        if isinstance(q, dict) and q.get("name"):
            catalog[str(q["name"])] = q
        for child in item.get("items") or []:
            if not isinstance(child, dict):
                continue
            cq = child.get("quality")
            if isinstance(cq, dict) and cq.get("name"):
                catalog[str(cq["name"])] = cq
    return catalog


def quality_id_of(value) -> int | None:
    if isinstance(value, dict):
        try:
            return int(value["id"])
        except (KeyError, TypeError, ValueError):
            return None
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def group_id_state(profiles: list[dict]) -> dict:
    """Arr rejects quality groups with id 0 ('Groups must have an ID'). Reuse ids."""
    by_name: dict[str, int] = {}
    used: set[int] = set()
    for profile in profiles:
        if not isinstance(profile, dict):
            continue
        for item in profile.get("items") or []:
            if not isinstance(item, dict) or isinstance(item.get("quality"), dict):
                continue
            gid = quality_id_of(item)
            if gid in (None, 0):
                continue
            used.add(gid)
            name = item.get("name")
            if name:
                by_name.setdefault(str(name), gid)
    nxt = 1000
    while nxt in used:
        nxt += 1
    return {"by_name": by_name, "used": used, "next": nxt}


def take_group_id(state: dict, name: str) -> int:
    have = state["by_name"].get(name)
    if have:
        return int(have)
    gid = int(state["next"])
    used = state["used"]
    while gid in used:
        gid += 1
    used.add(gid)
    state["by_name"][name] = gid
    state["next"] = gid + 1
    return gid


def rebuild_profile_items(
    catalog: dict,
    groups: tuple,
    allow_unlisted: bool = False,
    id_state: dict | None = None,
) -> list[dict]:
    used: set[str] = set()
    items: list[dict] = []
    grouped = {n for _name, names in groups for n in names}
    ids = id_state if id_state is not None else group_id_state([])
    for group_name, names in groups:
        present = [catalog[n] for n in names if n in catalog]
        if not present:
            continue
        used.update(n for n in names if n in catalog)
        if len(present) == 1 and present[0].get("name") == group_name:
            items.append({"quality": present[0], "items": [], "allowed": True})
            continue
        items.append(
            {
                "id": take_group_id(ids, group_name),
                "name": group_name,
                "allowed": True,
                "items": [{"quality": q, "items": [], "allowed": True} for q in present],
            }
        )
    for name, q in catalog.items():
        if name in used:
            continue
        allowed = allow_unlisted and name != "BR-DISK" and name not in grouped
        items.append({"quality": q, "items": [], "allowed": allowed})
    return items


def title_custom_format(name: str, regex: str) -> dict:
    specs = [
        {
            "name": name,
            "implementation": "ReleaseTitleSpecification",
            "negate": False,
            "required": True,
            "fields": [{"name": "value", "value": regex}],
        }
    ]
    if name == DUAL_AUDIO:
        specs.append(dual_subs_negate_spec())
    return {
        "name": name,
        "includeCustomFormatWhenRenaming": False,
        "specifications": specs,
    }


def dual_subs_negate_spec() -> dict:
    return {
        "name": DUAL_SUBS_SPEC_NAME,
        "implementation": "ReleaseTitleSpecification",
        "negate": True,
        "required": True,
        "fields": [{"name": "value", "value": DUAL_SUBS_RE}],
    }


def is_dual_audio_format_name(name: str) -> bool:
    return "dual audio" in (name or "").lower()


def spec_fields_value(spec: dict) -> str:
    fields = spec.get("fields")
    if isinstance(fields, dict):
        return str(fields.get("value") or "")
    if isinstance(fields, list):
        for item in fields:
            if isinstance(item, dict) and item.get("name") == "value":
                return str(item.get("value") or "")
    return ""


def spec_is_dual_subs_negate(spec: dict) -> bool:
    if not isinstance(spec, dict) or spec.get("negate") is not True:
        return False
    if "dual sub" in str(spec.get("name") or "").lower():
        return True
    value = spec_fields_value(spec).lower()
    return "dual" in value and "sub" in value


def format_excludes_dual_subs(item: dict) -> bool:
    specs = item.get("specifications")
    if not isinstance(specs, list):
        return False
    return any(spec_is_dual_subs_negate(spec) for spec in specs)


def with_dual_subs_negate(item: dict) -> dict:
    """Copy a Dual Audio CF and require the title not be Dual Subs."""
    saved = json.loads(json.dumps(item))
    specs = saved.get("specifications")
    if not isinstance(specs, list):
        specs = []
    if not any(spec_is_dual_subs_negate(spec) for spec in specs if isinstance(spec, dict)):
        specs.append(dual_subs_negate_spec())
    saved["specifications"] = specs
    return saved


def exclude_dual_subs_from_dual_audio_formats(base: str, api_key: str) -> int:
    """TRaSH Anime Dual Audio also treats 1080p…DUAL as a hit, including Dual Subs.

    Recyclarr rewrites that CF from the guide. Re-apply a required negate so
    Dual Subs does not get the +15 Dual Audio tie-break.
    """
    try:
        rows = as_list(http("GET", f"{base}/customformat", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"dual-audio formats: {exc}", "WARNING")
        return 0
    patched = 0
    for item in rows:
        if not isinstance(item, dict) or not is_dual_audio_format_name(str(item.get("name") or "")):
            continue
        if format_excludes_dual_subs(item):
            continue
        ident = item.get("id")
        if ident is None:
            continue
        payload = with_dual_subs_negate(item)
        payload["id"] = ident
        try:
            http(
                "PUT",
                f"{base}/customformat/{ident}",
                payload,
                headers=arr_headers(api_key),
            )
        except RuntimeError as exc:
            log(f"custom format {item.get('name')}: {exc}", "WARNING")
            continue
        patched += 1
        log(f"{item.get('name')} ignores Dual Subs (not Dual Audio)")
    return patched


def not_original_language_format() -> dict:
    """Arr-native original-audio filter (TRaSH Language: Not Original).

    Score -10000 on Default/Max so a French dub of an English title loses to
    the original, while a French film still matches its original audio. Anything
    does not use this reject. HA has no language picker — Seerr does not either.
    """
    return {
        "name": NOT_ORIGINAL_LANGUAGE,
        "includeCustomFormatWhenRenaming": False,
        "specifications": [
            {
                "name": "Not Original Language",
                "implementation": "LanguageSpecification",
                "negate": True,
                "required": False,
                "fields": [{"name": "value", "value": -2}],
            }
        ],
    }


def household_custom_formats() -> list[dict]:
    rows = [title_custom_format(name, regex) for name, regex in CUSTOM_FORMATS]
    rows.append(not_original_language_format())
    return rows


def household_format_scores(tier: str) -> dict[str, int]:
    """Per-profile CF scores. Default/Max scores are Recyclarr's once it syncs.

    On a name stub (Recyclarr missing) attach original-audio reject and a small
    Dual-Audio nudge. Recyclarr then owns Default/Max (TRaSH Anime Dual Audio).
    Anything takes CAM; Prefer Proper is a mild tie-break.
    """
    if tier in {PROFILE_DEFAULT, PROFILE_MAX}:
        return {NOT_ORIGINAL_LANGUAGE: -10000, DUAL_AUDIO: DUAL_AUDIO_SCORE}
    return {"Pompey Prefer Proper": 10}


def ensure_custom_formats(base: str, api_key: str) -> list[dict]:
    """Upsert household title CFs. Returns the Arr custom-format list (all of them)."""
    try:
        existing = as_list(http("GET", f"{base}/customformat", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"custom formats: {exc}", "WARNING")
        return []
    by_name = {item.get("name"): item for item in existing if item.get("name")}
    for payload in household_custom_formats():
        name = payload.get("name")
        have = by_name.get(name)
        try:
            if have and have.get("id") is not None:
                payload["id"] = have["id"]
                saved = http(
                    "PUT",
                    f"{base}/customformat/{have['id']}",
                    payload,
                    headers=arr_headers(api_key),
                )
            else:
                saved = http(
                    "POST",
                    f"{base}/customformat",
                    payload,
                    headers=arr_headers(api_key),
                )
            saved_id = (saved or {}).get("id") if isinstance(saved, dict) else None
            if saved_id is None and have:
                saved_id = have.get("id")
            if saved_id is not None:
                stored = dict(payload)
                stored["id"] = int(saved_id)
                by_name[name] = stored
        except RuntimeError as exc:
            log(f"custom format {name}: {exc}", "WARNING")
    exclude_dual_subs_from_dual_audio_formats(base, api_key)
    try:
        latest = as_list(http("GET", f"{base}/customformat", headers=arr_headers(api_key)))
        if latest:
            return latest
    except RuntimeError as exc:
        log(f"custom formats after upsert: {exc}", "WARNING")
    return [item for item in by_name.values() if isinstance(item, dict)]


def format_items_for(tier: str, formats: list[dict]) -> list[dict]:
    """Arr requires every custom format on the profile, including score 0."""
    scores = household_format_scores(tier)
    items = []
    for fmt in formats:
        if not isinstance(fmt, dict):
            continue
        name = fmt.get("name")
        fid = fmt.get("id")
        if not name or fid is None:
            continue
        items.append({"format": int(fid), "name": str(name), "score": int(scores.get(name, 0))})
    return items


def top_level_cutoff_id(item: dict) -> int | None:
    """ValidCutoff matches top-level quality.id or group id, not nested children."""
    q = item.get("quality") if isinstance(item.get("quality"), dict) else None
    if q is not None:
        return quality_id_of(q)
    gid = quality_id_of(item)
    if gid in (None, 0):
        return None
    return gid


def cutoff_names_of(item: dict) -> list[str]:
    names: list[str] = []
    q = item.get("quality") if isinstance(item.get("quality"), dict) else None
    if q and q.get("name"):
        names.append(str(q["name"]))
        return names
    if item.get("name"):
        names.append(str(item["name"]))
    for child in item.get("items") or []:
        if not isinstance(child, dict):
            continue
        cq = child.get("quality") if isinstance(child.get("quality"), dict) else None
        if cq and cq.get("name"):
            names.append(str(cq["name"]))
    return names


def cutoff_id_from_items(items: list[dict], preferred: tuple[str, ...], fallback=None) -> int | None:
    allowed: list[tuple[list[str], int]] = []
    for item in items:
        if not isinstance(item, dict) or not item.get("allowed"):
            continue
        cid = top_level_cutoff_id(item)
        if cid is None:
            continue
        allowed.append((cutoff_names_of(item), cid))
    for want in preferred:
        for names, cid in allowed:
            if want in names:
                return cid
    fb = quality_id_of(fallback)
    if fb is not None and any(cid == fb for _names, cid in allowed):
        return fb
    if allowed:
        return allowed[0][1]
    return fb


def pick_default_profile(profiles: list[dict]) -> dict:
    by_name = {item.get("name"): item for item in profiles if item.get("name")}
    for name in (PROFILE_DEFAULT, *LEGACY_DEFAULT_NAMES):
        if name in by_name:
            return by_name[name]
    return profiles[0]


def quality_schema(base: str, api_key: str) -> dict | None:
    try:
        schema = http("GET", f"{base}/qualityprofile/schema", headers=arr_headers(api_key))
    except RuntimeError as exc:
        log(f"quality profile schema: {exc}", "WARNING")
        return None
    return schema if isinstance(schema, dict) else None


def quality_catalog_for(base: str, api_key: str, profiles: list[dict]) -> dict:
    catalog: dict = {}
    schema = quality_schema(base, api_key)
    if schema:
        catalog.update(quality_catalog(schema))
    for item in profiles:
        catalog.update(quality_catalog(item))
    return catalog


def profile_id_by_name(base: str, api_key: str, name: str) -> int | None:
    try:
        profiles = as_list(http("GET", f"{base}/qualityprofile", headers=arr_headers(api_key)))
    except RuntimeError:
        return None
    for item in profiles:
        if item.get("name") == name and item.get("id") is not None:
            try:
                return int(item["id"])
            except (TypeError, ValueError):
                return None
    return None


def profile_id_from_save(saved, name: str, base: str, api_key: str) -> int | None:
    if isinstance(saved, dict) and saved.get("id") is not None:
        try:
            return int(saved["id"])
        except (TypeError, ValueError):
            pass
    if isinstance(saved, int):
        return saved
    return profile_id_by_name(base, api_key, name)


def prepare_quality_payload(
    template: dict,
    name: str,
    items: list[dict],
    cutoff_id: int | None,
    format_items: list[dict],
    upgrade_allowed: bool,
) -> dict:
    payload = json.loads(json.dumps(template))
    payload.pop("id", None)
    payload["name"] = name
    payload["items"] = items
    payload["upgradeAllowed"] = upgrade_allowed
    if cutoff_id is not None:
        payload["cutoff"] = cutoff_id
    payload["minFormatScore"] = 0
    payload["cutoffFormatScore"] = 10000 if upgrade_allowed else 0
    payload["formatItems"] = format_items
    # Language CFs (original audio) only work when the profile language is Any.
    if "language" in payload:
        payload["language"] = {"id": -1, "name": "Any"}
    try:
        min_up = int(payload.get("minUpgradeFormatScore") or 0)
    except (TypeError, ValueError):
        min_up = 0
    payload["minUpgradeFormatScore"] = min_up if min_up >= 1 else 1
    return payload


def upsert_quality_profile(
    base: str,
    api_key: str,
    name: str,
    template: dict,
    items: list[dict],
    cutoff_id: int | None,
    format_items: list[dict],
    upgrade_allowed: bool,
    existing: dict | None,
) -> int:
    payload = prepare_quality_payload(
        template, name, items, cutoff_id, format_items, upgrade_allowed
    )
    if existing and existing.get("id") is not None:
        payload["id"] = existing["id"]
        try:
            http(
                "PUT",
                f"{base}/qualityprofile/{existing['id']}",
                payload,
                headers=arr_headers(api_key),
            )
            return int(existing["id"])
        except RuntimeError as exc:
            log(f"quality profile {name} PUT: {exc}", "WARNING")
            payload.pop("id", None)
    try:
        saved = http(
            "POST",
            f"{base}/qualityprofile",
            payload,
            headers=arr_headers(api_key),
        )
    except RuntimeError as exc:
        found = profile_id_by_name(base, api_key, name)
        if found is not None:
            log(f"quality profile {name} POST: {exc}; using existing id {found}", "WARNING")
            return found
        raise RuntimeError(f"quality profile {name}: {exc}") from exc
    saved_id = profile_id_from_save(saved, name, base, api_key)
    if saved_id is None:
        raise RuntimeError(f"quality profile {name} POST returned no id")
    return int(saved_id)


def arr_title_collection(kind: str) -> str:
    return "movie" if kind == "radarr" else "series"


def title_id_of(item: dict) -> int | None:
    return profile_id_of(item)


def title_quality_profile_id(item: dict) -> int | None:
    try:
        if item.get("qualityProfileId") is not None:
            return int(item["qualityProfileId"])
    except (TypeError, ValueError):
        return None
    return None


def rehome_titles_off_profile(
    base: str, api_key: str, kind: str, leftover_id: int, default_id: int
) -> int:
    """Move movies/series off a leftover profile so Arr will allow DELETE.

    Seerr cannot change quality on an approved request. The profile lives on
    the Arr title. Default is the household 1080p encode; leftovers (HD-1080p)
    stay in the Seerr dropdown until every title is off them.

    Use the editor so a full title PUT cannot also queue a same-path move.
    """
    if leftover_id == default_id:
        return 0
    path = arr_title_collection(kind)
    try:
        rows = as_list(http("GET", f"{base}/{path}", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"{kind} titles on leftover profile {leftover_id}: {exc}", "WARNING")
        return 0
    ids = []
    for item in rows:
        if title_quality_profile_id(item) != leftover_id:
            continue
        tid = title_id_of(item)
        if tid is not None:
            ids.append(tid)
    if not ids:
        return 0
    id_key = "movieIds" if kind == "radarr" else "seriesIds"
    try:
        http(
            "PUT",
            f"{base}/{path}/editor",
            {id_key: ids, "qualityProfileId": default_id},
            headers=arr_headers(api_key),
        )
        return len(ids)
    except RuntimeError as exc:
        log(f"{kind} could not move {len(ids)} title(s) onto Default: {exc}", "WARNING")
        return 0


def rehome_import_lists_off_profile(
    base: str, api_key: str, kind: str, leftover_id: int, default_id: int
) -> int:
    """Import lists also pin a leftover profile and block DELETE."""
    if leftover_id == default_id:
        return 0
    try:
        rows = as_list(http("GET", f"{base}/importlist", headers=arr_headers(api_key)))
    except RuntimeError:
        return 0
    moved = 0
    for item in rows:
        if title_quality_profile_id(item) != leftover_id:
            continue
        tid = title_id_of(item)
        if tid is None:
            continue
        payload = json.loads(json.dumps(item))
        payload["qualityProfileId"] = default_id
        try:
            http(
                "PUT",
                f"{base}/importlist/{tid}",
                payload,
                headers=arr_headers(api_key),
            )
            moved += 1
        except RuntimeError as exc:
            log(f"{kind} could not move import list {tid} onto Default: {exc}", "WARNING")
    return moved


def drop_extra_quality_profiles(
    base: str, api_key: str, kind: str, default_id: int | None
) -> None:
    """Seerr lists every Arr profile in the request dropdown. Keep only the three."""
    try:
        profiles = as_list(http("GET", f"{base}/qualityprofile", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"quality profiles after upsert: {exc}", "WARNING")
        return
    have = {item.get("name") for item in profiles}
    if not set(PROFILE_NAMES) <= have:
        log(
            f"keeping leftover quality profiles until Max/Default/Anything all exist "
            f"(have {sorted(n for n in have if n)})",
            "WARNING",
        )
        return
    if default_id is None:
        default_id = profile_id_by_name(base, api_key, PROFILE_DEFAULT)
    for item in profiles:
        name = item.get("name")
        pid = item.get("id")
        if name in PROFILE_NAMES or pid is None:
            continue
        leftover_id = profile_id_of(item)
        if leftover_id is not None and default_id is not None:
            moved = rehome_titles_off_profile(
                base, api_key, kind, leftover_id, int(default_id)
            )
            lists = rehome_import_lists_off_profile(
                base, api_key, kind, leftover_id, int(default_id)
            )
            if moved:
                log(
                    f"{kind} moved {moved} title(s) from {name} onto Default "
                    "so the leftover profile can be removed"
                )
            if lists:
                log(f"{kind} moved {lists} import list(s) from {name} onto Default")
        try:
            http(
                "DELETE",
                f"{base}/qualityprofile/{pid}",
                headers=arr_headers(api_key),
            )
            log(f"removed leftover quality profile {name}")
        except RuntimeError as exc:
            log(f"could not remove quality profile {name}: {exc}", "WARNING")


def recyclarr_marker() -> str:
    return os.path.join(ready_dir(), "recyclarr")


def recyclarr_is_fresh() -> bool:
    """True when Recyclarr already synced recently. Skip a redundant sync."""
    path = recyclarr_marker()
    if not os.path.isfile(path):
        return False
    try:
        max_age = float(env("POMPEY_RECYCLARR_MAX_AGE", "86400") or "86400")
    except ValueError:
        max_age = 86400.0
    try:
        return (time.time() - os.path.getmtime(path)) < max_age
    except OSError:
        return False


def recyclarr_sync_script() -> str:
    override = env("POMPEY_RECYCLARR_SYNC")
    if override:
        return override
    here = os.path.dirname(os.path.abspath(__file__))
    sibling = os.path.join(here, "recyclarr-sync")
    if os.path.isfile(sibling):
        return sibling
    return "/usr/local/bin/recyclarr-sync"


def recyclarr_binary() -> str:
    override = env("POMPEY_RECYCLARR")
    if override:
        return override
    root = os.path.join(env("POMPEY_ENGINES", "/data/engines"), "recyclarr")
    nested = os.path.join(root, "recyclarr")
    if os.path.isfile(nested) and os.access(nested, os.X_OK):
        return nested
    return root


def run_recyclarr(*, force: bool = False) -> bool:
    """Sync TRaSH onto Default/Max. Failures leave name stubs until Recyclarr can sync."""
    if not force and recyclarr_is_fresh():
        return True
    binary = recyclarr_binary()
    if not os.path.isfile(binary) or not os.access(binary, os.X_OK):
        log_if_new(
            "recyclarr-missing",
            "Recyclarr binary not on disk; Default/Max stay name stubs until Recyclarr can sync",
        )
        return False
    script = recyclarr_sync_script()
    if not os.path.isfile(script):
        log(
            "Recyclarr sync script missing; Default/Max stay name stubs until Recyclarr can sync",
            "WARNING",
        )
        return False
    try:
        proc = subprocess.run(
            [sys.executable, script],
            check=False,
            timeout=int(env("POMPEY_RECYCLARR_TIMEOUT", "600") or "600"),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        log(f"Recyclarr: {exc}", "WARNING")
        return False
    if proc.returncode != 0:
        return False
    os.makedirs(ready_dir(), exist_ok=True)
    marker = recyclarr_marker()
    with open(marker, "w", encoding="utf-8") as fh:
        fh.write("ok\n")
    return True


def profile_id_of(item: dict) -> int | None:
    try:
        if item.get("id") is not None:
            return int(item["id"])
    except (TypeError, ValueError):
        return None
    return None


def household_quality_profile(base: str, api_key: str, kind: str):
    """Max (4K encode), Default (1080p encode), Anything (take what exists)."""
    try:
        return apply_household_quality_profiles(base, api_key, kind)
    except RuntimeError as exc:
        log(f"{kind} quality profiles: {exc}", "WARNING")
        return first_profile(base, api_key)


def ensure_seerr_profile_name(
    base: str,
    api_key: str,
    name: str,
    template: dict,
    formats: list[dict],
    existing: dict | None,
) -> int | None:
    """Create Default/Max if missing. Never PUT items — Recyclarr owns those."""
    pid = profile_id_of(existing or {})
    if pid is not None:
        return pid
    items = json.loads(json.dumps(template.get("items") or []))
    if not items:
        raise RuntimeError(f"quality profile {name}: template has no items")
    cutoff = cutoff_id_from_items(items, (), template.get("cutoff"))
    return upsert_quality_profile(
        base,
        api_key,
        name,
        template,
        items,
        cutoff,
        format_items_for(name, formats),
        True,
        None,
    )


def apply_household_quality_profiles(base: str, api_key: str, kind: str):
    profiles = as_list(http("GET", f"{base}/qualityprofile", headers=arr_headers(api_key)))
    if not profiles:
        raise RuntimeError(f"no quality profiles at {base}")
    template = pick_default_profile(profiles)
    catalog = quality_catalog_for(base, api_key, profiles)
    if not catalog:
        catalog = quality_catalog(template)
        if not catalog:
            for item in profiles:
                catalog = quality_catalog(item)
                if catalog:
                    template = item
                    break
    if not catalog:
        log(f"{kind} quality profile has no qualities listed; leaving defaults", "WARNING")
        return int(template["id"]), template.get("name") or PROFILE_DEFAULT

    formats = ensure_custom_formats(base, api_key)
    by_name = {item.get("name"): item for item in profiles if item.get("name")}
    ids = group_id_state(profiles + ([template] if template else []))

    default_id = None
    stubbed: list[str] = []
    try:
        had_default = PROFILE_DEFAULT in by_name
        default_id = ensure_seerr_profile_name(
            base,
            api_key,
            PROFILE_DEFAULT,
            template,
            formats,
            by_name.get(PROFILE_DEFAULT),
        )
        if not had_default and default_id is not None:
            stubbed.append(PROFILE_DEFAULT)
    except RuntimeError as exc:
        log(f"{kind} quality profile {PROFILE_DEFAULT}: {exc}", "WARNING")
    try:
        had_max = PROFILE_MAX in by_name
        max_id = ensure_seerr_profile_name(
            base,
            api_key,
            PROFILE_MAX,
            template,
            formats,
            by_name.get(PROFILE_MAX),
        )
        if not had_max and max_id is not None:
            stubbed.append(PROFILE_MAX)
    except RuntimeError as exc:
        log(f"{kind} quality profile {PROFILE_MAX}: {exc}", "WARNING")
    if stubbed:
        log(
            f"{kind} quality profile name stub(s) {', '.join(stubbed)} until Recyclarr can sync"
        )
    elif PROFILE_DEFAULT in by_name and PROFILE_MAX in by_name:
        log(f"{kind} quality profiles {PROFILE_DEFAULT}/{PROFILE_MAX} left to Recyclarr")

    anything_items = rebuild_profile_items(catalog, (), allow_unlisted=True, id_state=ids)
    try:
        upsert_quality_profile(
            base,
            api_key,
            PROFILE_ANYTHING,
            template,
            anything_items,
            cutoff_id_from_items(
                anything_items,
                ("CAM", "WEBDL-480p", "WEBDL-720p", "WEBDL-1080p"),
                template.get("cutoff"),
            ),
            format_items_for(PROFILE_ANYTHING, formats),
            False,
            by_name.get(PROFILE_ANYTHING),
        )
    except RuntimeError as exc:
        log(f"{kind} quality profile {PROFILE_ANYTHING}: {exc}", "WARNING")
    drop_extra_quality_profiles(base, api_key, kind, default_id)
    try:
        now = as_list(http("GET", f"{base}/qualityprofile", headers=arr_headers(api_key)))
    except RuntimeError:
        now = []
    have = {item.get("name") for item in now}
    if default_id is None:
        default_id = profile_id_by_name(base, api_key, PROFILE_DEFAULT)
    if set(PROFILE_NAMES) <= have:
        log(
            f"{kind} quality profiles: {PROFILE_MAX} (4K encode), "
            f"{PROFILE_DEFAULT} (1080p encode), {PROFILE_ANYTHING} (take anything)"
        )
    else:
        log(
            f"{kind} quality profiles incomplete (have {sorted(n for n in have if n)})",
            "WARNING",
        )
    if default_id is None:
        return first_profile(base, api_key)
    return default_id, PROFILE_DEFAULT


def language_profile_id(_base: str, _api_key: str):
    # Sonarr v4 dropped language profiles. GET /languageprofile is deprecated and
    # warned on every wire retry (Python-urllib) while doing no work for our 4.0.x.
    return None


def prowlarr_app_values(impl: str, base_url: str, api_key: str) -> dict:
    values = {
        "prowlarrUrl": prowlarr_arr_url(),
        "baseUrl": base_url,
        "apiKey": api_key,
        "syncCategories": sync_cats_for(impl),
    }
    if impl == "Sonarr":
        values[SONARR_ANIME_STANDARD_SEARCH] = True
    return values


def prowlarr_app_matches(existing: dict, values: dict) -> bool:
    current = str(app_field(existing, "prowlarrUrl") or "").rstrip("/")
    if current != str(values.get("prowlarrUrl") or "").rstrip("/"):
        return False
    if not cats_match(app_field(existing, "syncCategories"), values["syncCategories"]):
        return False
    if SONARR_ANIME_STANDARD_SEARCH in values and not field_is_true(
        existing, SONARR_ANIME_STANDARD_SEARCH
    ):
        return False
    return True


def ensure_prowlarr_app(prowlarr: str, pkey: str, name: str, impl: str, base_url: str, api_key: str) -> None:
    values = prowlarr_app_values(impl, base_url, api_key)
    want = values["prowlarrUrl"]
    want_cats = values["syncCategories"]
    apps = as_list(http("GET", f"{prowlarr}/api/v1/applications", headers=arr_headers(pkey)))
    for existing in apps:
        if existing.get("name") != name:
            continue
        if prowlarr_app_matches(existing, values):
            return
        if existing.get("id") is None:
            return
        updated = json.loads(json.dumps(existing))
        updates = {"prowlarrUrl": want, "syncCategories": want_cats}
        if SONARR_ANIME_STANDARD_SEARCH in values:
            updates[SONARR_ANIME_STANDARD_SEARCH] = True
        set_app_fields(updated, updates)
        http(
            "PUT",
            f"{prowlarr}/api/v1/applications/{existing['id']}",
            updated,
            headers=arr_headers(pkey),
        )
        log(f"prowlarr app {name} Arr URL {want} cats {want_cats[0]}s")
        return
    schema = http("GET", f"{prowlarr}/api/v1/applications/schema", headers=arr_headers(pkey))
    app = schema_impl(schema, impl)
    set_app_fields(app, values)
    app["name"] = name
    app["syncLevel"] = "fullSync"
    app["tags"] = []
    http("POST", f"{prowlarr}/api/v1/applications", app, headers=arr_headers(pkey))
    log(f"prowlarr app {name}")


def ensure_indexer(prowlarr: str, pkey: str) -> None:
    if not indexer_url():
        log("no source URL configured yet")
        return
    indexers = as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
    if indexers:
        return
    schema = http("GET", f"{prowlarr}/api/v1/indexer/schema", headers=arr_headers(pkey))
    impl = "Newznab" if "newznab" in indexer_url().lower() else "Torznab"
    try:
        indexer = schema_impl(schema, impl)
    except RuntimeError:
        indexer = schema_impl(schema, "Newznab" if impl == "Torznab" else "Torznab")
    fill_fields(
        indexer,
        {
            "baseUrl": indexer_url().rstrip("/"),
            "apiPath": "/api",
            "apiKey": indexer_api_key(),
        },
    )
    indexer["name"] = "Source"
    indexer["enable"] = True
    indexer["enableRss"] = True
    indexer["enableAutomaticSearch"] = True
    indexer["enableInteractiveSearch"] = True
    indexer["priority"] = 25
    indexer["appProfileId"] = 1
    indexer["tags"] = []
    http("POST", f"{prowlarr}/api/v1/indexer", indexer, headers=arr_headers(pkey))
    log("added source")


def sync_prowlarr_indexers(prowlarr: str, pkey: str) -> None:
    """Push every enabled Prowlarr source into Radarr/Sonarr and say how many exist.

    Pompey does not pick which indexer to query — Arr asks Prowlarr, and Prowlarr
    fans out to every source that is enabled for that search type and category.
    Household sources are added in Prowlarr's UI; we still sync so Arr sees them.
    Enabled sources with search switched off would be skipped on the next request.
    """
    indexers = as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
    for item in indexers:
        if not item.get("enable") or item.get("id") is None:
            continue
        if all(item.get(key) is True for key in SEARCH_FLAGS):
            continue
        detail = item
        try:
            fetched = http(
                "GET",
                f"{prowlarr}/api/v1/indexer/{item['id']}",
                headers=arr_headers(pkey),
            )
            if isinstance(fetched, dict) and fetched.get("id") is not None:
                detail = fetched
        except RuntimeError:
            pass
        if all(detail.get(key) is True for key in SEARCH_FLAGS):
            continue
        for key in SEARCH_FLAGS:
            detail[key] = True
        name = detail.get("name") or item.get("name") or "unnamed"
        try:
            http(
                "PUT",
                f"{prowlarr}/api/v1/indexer/{item['id']}",
                detail,
                headers=arr_headers(pkey),
            )
            log(f"Prowlarr source {name} search flags turned on")
        except RuntimeError as exc:
            log(f"Prowlarr source {name} could not enable search: {exc}", "WARNING")
    indexers = as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
    enabled = [item for item in indexers if item.get("enable")]
    log(f"Prowlarr sources: {len(enabled)} enabled / {len(indexers)} total")
    for item in indexers:
        name = item.get("name") or "unnamed"
        on = "on" if item.get("enable") else "off"
        rss, auto, interactive = (item.get(key) for key in SEARCH_FLAGS)
        if item.get("enable") and any(flag is not True for flag in (rss, auto, interactive)):
            try:
                fetched = http(
                    "GET",
                    f"{prowlarr}/api/v1/indexer/{item['id']}",
                    headers=arr_headers(pkey),
                )
                if isinstance(fetched, dict):
                    rss, auto, interactive = (fetched.get(key) for key in SEARCH_FLAGS)
            except RuntimeError:
                pass
        log(
            f"Prowlarr source {name} {on} "
            f"rss={rss} auto={auto} interactive={interactive}"
        )
    http(
        "POST",
        f"{prowlarr}/api/v1/command",
        {"name": "ApplicationIndexerSync"},
        headers=arr_headers(pkey),
    )
    log("prowlarr sync")


def log_arr_vs_prowlarr_indexers(
    radarr: str, radarr_key: str, sonarr: str, sonarr_key: str, prowlarr: str, pkey: str
) -> None:
    """Warn when Prowlarr sync left Radarr/Sonarr with fewer sources than Prowlarr has."""
    try:
        enabled = [
            item
            for item in as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
            if item.get("enable")
        ]
    except RuntimeError as exc:
        log(f"could not list Prowlarr sources after sync: {exc}", "WARNING")
        return
    names = {(item.get("name") or "").strip() for item in enabled if item.get("name")}
    for kind, base, key in (("Radarr", radarr, radarr_key), ("Sonarr", sonarr, sonarr_key)):
        try:
            arr = as_list(http("GET", f"{base}/indexer", headers=arr_headers(key)))
        except RuntimeError as exc:
            log(f"could not list {kind} indexers: {exc}", "WARNING")
            continue
        active = [item for item in arr if item.get("enable") is not False]
        log(f"{kind} indexers: {len(active)} (Prowlarr enabled {len(enabled)})")
        arr_names = {(item.get("name") or "").strip() for item in active if item.get("name")}
        missing = sorted(name for name in names if name not in arr_names)
        extra = sorted(name for name in arr_names if name not in names)
        if missing:
            log(
                f"{kind} is missing Prowlarr source(s): {', '.join(missing)}. "
                "Those sources will not run for Seerr requests (Prowlarr often refuses "
                "to sync when a category test returns top100 / CloudFlare).",
                "WARNING",
            )
        if extra:
            log(f"{kind} extra indexer(s) not in Prowlarr: {', '.join(extra)}")


def arr_indexer_needs_search(detail: dict, kind: str) -> bool:
    if any(detail.get(key) is not True for key in SEARCH_FLAGS):
        return True
    return kind == "sonarr" and not field_is_true(detail, SONARR_INDEXER_ANIME_STANDARD)


def ensure_arr_indexer_search(base: str, api_key: str, kind: str) -> None:
    """Debug Interactive Search uses Arr's indexer rows, not Prowlarr's UI.

    Prowlarr ApplicationIndexerSync usually copies enableInteractiveSearch.
    If a source landed with search off, the Debug magnifying glass is empty.
    Sonarr also needs Anime Standard Format Search so a season search asks
    for S01 packs instead of only absolute episode numbers.
    """
    try:
        indexers = as_list(http("GET", f"{base}/indexer", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"{kind} indexers: {exc}", "WARNING")
        return
    for item in indexers:
        if item.get("enable") is False or item.get("id") is None:
            continue
        if not arr_indexer_needs_search(item, kind):
            continue
        detail = item
        try:
            fetched = http(
                "GET",
                f"{base}/indexer/{item['id']}",
                headers=arr_headers(api_key),
            )
            if isinstance(fetched, dict) and fetched.get("id") is not None:
                detail = fetched
        except RuntimeError:
            pass
        if not arr_indexer_needs_search(detail, kind):
            continue
        for key in SEARCH_FLAGS:
            detail[key] = True
        if kind == "sonarr":
            set_app_fields(detail, {SONARR_INDEXER_ANIME_STANDARD: True})
        name = detail.get("name") or item.get("name") or "unnamed"
        try:
            http(
                "PUT",
                f"{base}/indexer/{item['id']}",
                detail,
                headers=arr_headers(api_key),
            )
            log(f"{kind} source {name} search flags turned on")
        except RuntimeError as exc:
            log(f"{kind} source {name} could not enable search: {exc}", "WARNING")


def history_data_map(record: dict) -> dict[str, str]:
    raw = record.get("data") if isinstance(record, dict) else None
    if not isinstance(raw, dict):
        return {}
    out: dict[str, str] = {}
    for key, val in raw.items():
        if val is None or val == "":
            continue
        out[str(key).lower()] = str(val)
    return out


def describe_prowlarr_history_row(record: dict, indexer_names: dict | None = None) -> str:
    """Say whether History Query was empty because of IMDb/TMDB, RSS, or a true blank."""
    names = indexer_names or {}
    indexer = record.get("indexer") if isinstance(record, dict) else None
    if isinstance(indexer, dict) and indexer.get("name"):
        name = str(indexer.get("name"))
    else:
        idx = record.get("indexerId") if isinstance(record, dict) else None
        try:
            name = names.get(int(idx)) or f"indexer {idx}"
        except (TypeError, ValueError):
            name = str(indexer or "indexer")
    event = record.get("eventType") if isinstance(record, dict) else None
    event_s = str(event or "").lower()
    data = history_data_map(record if isinstance(record, dict) else {})
    query = (data.get("query") or "").strip()
    qtype = (data.get("querytype") or "").strip() or "search"
    source = (data.get("source") or "").strip()
    ids = []
    if data.get("imdbid"):
        ids.append(f"IMDb {data['imdbid']}")
    if data.get("tmdbid"):
        ids.append(f"TMDb {data['tmdbid']}")
    if data.get("tvdbid"):
        ids.append(f"TVDb {data['tvdbid']}")
    id_bit = " ".join(ids)
    via = f" via {source}" if source else ""
    url = (data.get("url") or "").lower()
    if "top100" in url or "top-100" in url or "top_100" in url:
        return f"{name}{via} browse/top100 (not the Seerr title)"
    if event in (3, "indexerRss", "IndexerRss") or event_s == "indexerrss":
        return f"{name}{via} RSS (no title term)"
    if id_bit and not query:
        return f"{name}{via} {qtype} {id_bit} (Query empty — ID search)"
    if id_bit and query:
        return f"{name}{via} {qtype} {id_bit} q={query!r}"
    if query:
        return f"{name}{via} {qtype} q={query!r}"
    return f"{name}{via} {qtype} empty query (no IDs)"


def log_recent_prowlarr_searches(prowlarr: str, pkey: str) -> None:
    """Dump recent History rows so an empty Query is not mistaken for a blank search."""
    try:
        indexers = as_list(http("GET", f"{prowlarr}/api/v1/indexer", headers=arr_headers(pkey)))
        names = {}
        for item in indexers:
            try:
                names[int(item["id"])] = item.get("name") or f"indexer {item['id']}"
            except (TypeError, ValueError, KeyError):
                continue
        payload = http(
            "GET",
            f"{prowlarr}/api/v1/history?page=1&pageSize=40&sortKey=date&sortDirection=descending",
            headers=arr_headers(pkey),
        )
        records = as_list(payload)
        shown = 0
        for record in records:
            event = record.get("eventType")
            event_s = str(event or "").lower()
            if event not in (2, 3, "indexerQuery", "indexerRss", "IndexerQuery", "IndexerRss") and event_s not in {
                "indexerquery",
                "indexerrss",
            }:
                continue
            log(f"Prowlarr history {describe_prowlarr_history_row(record, names)}")
            shown += 1
            if shown >= 20:
                break
        if shown:
            log(
                f"Prowlarr history: {shown} recent search(es). "
                "Empty Query plus IMDb/TMDb is ID search (keep it). "
                "Empty Query with no IDs is RSS or a true blank."
            )
    except RuntimeError as exc:
        log(f"could not read Prowlarr history: {exc}", "WARNING")


SEARCH_COMMAND_NAMES = {
    "EpisodeSearch",
    "MissingEpisodeSearch",
    "MovieSearch",
    "MoviesSearch",
    "SeasonSearch",
    "SeriesSearch",
}


def arr_search_in_flight(base: str, api_key: str) -> bool:
    try:
        rows = as_list(http("GET", f"{base}/command", headers=arr_headers(api_key)))
    except RuntimeError:
        return False
    for item in rows:
        if not isinstance(item, dict):
            continue
        if item.get("name") not in SEARCH_COMMAND_NAMES:
            continue
        if str(item.get("status") or "").lower() in {"started", "queued"}:
            return True
    return False


def series_id_of(item: dict) -> int | None:
    series = item.get("series") if isinstance(item.get("series"), dict) else {}
    return parse_int(item.get("seriesId") or series.get("id"))


def season_and_episode_searches(
    records: list[dict], limit: int = 8
) -> tuple[list[tuple[int, int]], list[int]]:
    """Prefer SeasonSearch when two or more missing eps share a season.

    EpisodeSearch never asks indexers for season packs. Anime series type has
    no pack concept unless Sonarr is doing a season search *and* the indexer
    has Anime Standard Format Search on.
    """
    grouped: dict[tuple[int, int], list[int]] = {}
    order: list[tuple[int, int]] = []
    leftover: list[int] = []
    for item in records:
        if not isinstance(item, dict):
            continue
        eid = parse_int(item.get("id"))
        if eid is None:
            continue
        sid = series_id_of(item)
        season = parse_int(item.get("seasonNumber"))
        if sid is None or season is None:
            leftover.append(eid)
            continue
        key = (sid, season)
        if key not in grouped:
            grouped[key] = []
            order.append(key)
        grouped[key].append(eid)
    seasons: list[tuple[int, int]] = []
    for key in order:
        ids = grouped[key]
        if len(ids) >= 2:
            seasons.append(key)
        else:
            leftover.extend(ids)
    return seasons[:limit], leftover[:limit]


def missing_search_token(seasons: list[tuple[int, int]], episode_ids: list[int]) -> str:
    bits = [f"s{sid}-{season}" for sid, season in seasons]
    if episode_ids:
        bits.append("e" + ",".join(str(i) for i in episode_ids))
    return ";".join(bits)


def post_sonarr_season_and_episode_searches(
    sonarr: str,
    sonarr_key: str,
    seasons: list[tuple[int, int]],
    episode_ids: list[int],
    season_log: str,
    episode_log: str,
) -> None:
    headers = arr_headers(sonarr_key)
    for series_id, season_number in seasons:
        http(
            "POST",
            f"{sonarr}/command",
            {"name": "SeasonSearch", "seriesId": series_id, "seasonNumber": season_number},
            headers=headers,
        )
    if episode_ids:
        http(
            "POST",
            f"{sonarr}/command",
            {"name": "EpisodeSearch", "episodeIds": episode_ids},
            headers=headers,
        )
    if seasons:
        log(season_log)
    if episode_ids:
        log(episode_log)


def retry_unfilled_titles(
    radarr: str,
    radarr_key: str,
    sonarr: str,
    sonarr_key: str,
    skip_search: set[str] | None = None,
) -> None:
    """Search monitored titles that still have no file. Seerr already handed off.

    A request that searched too few indexers stays approved in Seerr; Arr will
    not try again until RSS or a missing-search cycle unless we ask.
    One poke per missing season / leftover-episode set so housekeep does not
    re-search every 5 minutes. SeasonSearch is what can query a pack; an
    EpisodeSearch of eight holes in the same season never will.
    Skip titles we just retargeted after a hand-move, and seasons whose files
    already sit on disk under the Arr path (Plex/Seerr can look done while
    Sonarr hasFile is still false).
    """
    skip_search = skip_search or set()
    if arr_search_in_flight(radarr, radarr_key) or arr_search_in_flight(sonarr, sonarr_key):
        return
    try:
        movies = as_list(http("GET", f"{radarr}/movie", headers=arr_headers(radarr_key)))
        movie_ids = []
        for item in movies:
            if item.get("monitored") is not True or item.get("hasFile") is not False:
                continue
            mid = parse_int(item.get("id"))
            if mid is None:
                continue
            if f"movie:{mid}" in skip_search:
                continue
            if library_video_count(title_library_path(item)):
                continue
            movie_ids.append(mid)
        movie_ids = movie_ids[:8]
        token = ",".join(str(i) for i in movie_ids)
        if movie_ids and _load_quiet().get("retry-movies") != token:
            http(
                "POST",
                f"{radarr}/command",
                {"name": "MoviesSearch", "movieIds": movie_ids},
                headers=arr_headers(radarr_key),
            )
            state = _load_quiet()
            state["retry-movies"] = token
            _save_quiet(state)
            log(f"searching again for {len(movie_ids)} movie(s) still missing a file")
    except RuntimeError as exc:
        log(f"could not retry movie search: {exc}", "WARNING")
    try:
        missing = http(
            "GET",
            f"{sonarr}/wanted/missing?pageSize=8",
            headers=arr_headers(sonarr_key),
        )
        records = as_list(missing)
        try:
            series_rows = as_list(http("GET", f"{sonarr}/series", headers=arr_headers(sonarr_key)))
        except RuntimeError:
            series_rows = []
        series_by_id = {
            tid: row
            for row in series_rows
            if (tid := parse_int(row.get("id"))) is not None
        }
        paths = {
            tid: title_library_path(row)
            for tid, row in series_by_id.items()
        }
        filtered = []
        for item in records:
            sid = series_id_of(item)
            if sid is not None and f"series:{sid}" in skip_search:
                continue
            series = series_by_id.get(sid) if sid is not None else None
            if isinstance(series, dict) and series.get("monitored") is False:
                continue
            path = paths.get(sid) if sid is not None else ""
            if missing_episode_already_on_disk(item, path):
                continue
            filtered.append(item)
        records = filtered
        seasons, episode_ids = season_and_episode_searches(records)
        token = missing_search_token(seasons, episode_ids)
        if token and _load_quiet().get("retry-episodes") != token:
            post_sonarr_season_and_episode_searches(
                sonarr,
                sonarr_key,
                seasons,
                episode_ids,
                f"searching again for {len(seasons)} missing season(s)",
                f"searching again for {len(episode_ids)} missing episode(s)",
            )
            state = _load_quiet()
            state["retry-episodes"] = token
            _save_quiet(state)
    except RuntimeError as exc:
        if "404" not in str(exc):
            log(f"could not retry episode search: {exc}", "WARNING")


def seerr_request_headers() -> dict | None:
    key = seerr_api_key_from_disk()
    if not key:
        return None
    return {"X-API-Key": key, "Content-Type": "application/json"}


def load_open_seerr_requests() -> list[dict] | None:
    """Seerr request rows that still want a better file. None if Seerr cannot be read.

    Removing the request (Requests page) is the household close-out. Declined
    stays listed but is closed. Fail closed: a 403/5xx must not unmonitor.
    """
    headers = seerr_request_headers()
    if not headers:
        return None
    rows: list[dict] = []
    skip = 0
    take = 50
    while skip <= 2000:
        try:
            payload = http(
                "GET",
                f"{seerr_url()}/api/v1/request?take={take}&skip={skip}&filter=all&sort=added",
                headers=headers,
            )
        except RuntimeError as exc:
            # 403 until the Plex wizard (same as other Seerr admin routes).
            if "403" not in str(exc):
                log(f"seerr requests: {exc}", "WARNING")
            return None
        if isinstance(payload, list):
            batch = as_list(payload)
        elif isinstance(payload, dict) and "results" in payload:
            batch = as_list(payload.get("results"))
        else:
            log("seerr requests: unexpected payload; not closing or upgrading", "WARNING")
            return None
        for item in batch:
            status = parse_int(item.get("status"))
            if status == SEERR_REQUEST_DECLINED:
                continue
            rows.append(item)
        if len(batch) < take:
            return rows
        skip += take
    return rows


def open_seerr_upgrade_keys(requests: list[dict]) -> set[str]:
    keys: set[str] = set()
    for item in requests:
        media = item.get("media") if isinstance(item.get("media"), dict) else {}
        media_type = str(media.get("mediaType") or item.get("type") or "").lower()
        movie = media_type in {"movie", "movies"}
        ext = parse_int(media.get("externalServiceId"))
        if ext:
            keys.add(f"{'movie' if movie else 'series'}:{ext}")
        tmdb = parse_int(media.get("tmdbId"))
        if tmdb:
            keys.add(f"tmdb:{'movie' if movie else 'series'}:{tmdb}")
        tvdb = parse_int(media.get("tvdbId"))
        if tvdb and not movie:
            keys.add(f"tvdb:{tvdb}")
    return keys


def remembered_arr_upgrade_ids(keys: set[str]) -> list[str]:
    return sorted(key for key in keys if key.startswith("movie:") or key.startswith("series:"))


def request_covers_movie(movie: dict, keys: set[str]) -> bool:
    mid = parse_int(movie.get("id"))
    if mid is not None and f"movie:{mid}" in keys:
        return True
    tmdb = parse_int(movie.get("tmdbId"))
    return tmdb is not None and f"tmdb:movie:{tmdb}" in keys


def request_covers_series(series: dict, keys: set[str]) -> bool:
    sid = parse_int(series.get("id"))
    if sid is not None and f"series:{sid}" in keys:
        return True
    tvdb = parse_int(series.get("tvdbId"))
    if tvdb is not None and f"tvdb:{tvdb}" in keys:
        return True
    tmdb = parse_int(series.get("tmdbId"))
    return tmdb is not None and f"tmdb:series:{tmdb}" in keys


def request_covers_episode(episode: dict, keys: set[str]) -> bool:
    series = episode.get("series") if isinstance(episode.get("series"), dict) else {}
    sid = parse_int(episode.get("seriesId") or series.get("id"))
    if sid is not None and f"series:{sid}" in keys:
        return True
    tvdb = parse_int(series.get("tvdbId") or episode.get("tvdbId"))
    if tvdb is not None and f"tvdb:{tvdb}" in keys:
        return True
    tmdb = parse_int(series.get("tmdbId") or episode.get("tmdbId"))
    return tmdb is not None and f"tmdb:series:{tmdb}" in keys


def series_still_hunting(item: dict) -> bool:
    """True when Sonarr would still RSS or missing-search this title."""
    if item.get("monitored") is not False:
        return True
    if str(item.get("monitorNewItems") or "none").lower() != "none":
        return True
    for season in item.get("seasons") or []:
        if isinstance(season, dict) and season.get("monitored") is True:
            return True
    return False


def title_is_hunting(item: dict, endpoint: str) -> bool:
    if endpoint == "series" or "seasons" in item:
        return series_still_hunting(item)
    return item.get("monitored") is not False


def unmonitor_arr_item(base: str, api_key: str, endpoint: str, item: dict):
    """PUT unmonitor using the already-fetched movie/series row. No extra GET."""
    title_id = parse_int(item.get("id"))
    if title_id is None or not title_is_hunting(item, endpoint):
        return item
    if endpoint == "series" or "seasons" in item:
        item["monitored"] = False
        item["monitorNewItems"] = "none"
        for season in item.get("seasons") or []:
            if isinstance(season, dict):
                season["monitored"] = False
    else:
        item["monitored"] = False
    return http(
        "PUT",
        f"{base}/{endpoint}/{title_id}",
        item,
        headers=arr_headers(api_key),
    )


def arr_command_targets_title(cmd: dict, title_id: int) -> bool:
    blobs = [cmd]
    body = cmd.get("body")
    if isinstance(body, dict):
        blobs.append(body)
    for blob in blobs:
        if parse_int(blob.get("movieId")) == title_id:
            return True
        if parse_int(blob.get("seriesId")) == title_id:
            return True
        for key in ("movieIds", "seriesIds"):
            raw = blob.get(key) or []
            if not isinstance(raw, list):
                continue
            if any(parse_int(value) == title_id for value in raw):
                return True
    return False


def arr_command_is_search(cmd: dict) -> bool:
    name = str(cmd.get("name") or "")
    body = cmd.get("body") if isinstance(cmd.get("body"), dict) else {}
    return name in SEARCH_COMMAND_NAMES or str(body.get("name") or "") in SEARCH_COMMAND_NAMES


def arr_list_commands(base: str, api_key: str) -> list[dict]:
    try:
        return as_list(http("GET", f"{base}/command", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"could not list Arr commands: {exc}", "WARNING")
        return []


def arr_list_queue(base: str, api_key: str) -> list[dict]:
    try:
        return as_list(
            http(
                "GET",
                f"{base}/queue?page=1&pageSize=200",
                headers=arr_headers(api_key),
            )
        )
    except RuntimeError as exc:
        if "404" not in str(exc):
            log(f"could not read Arr queue: {exc}", "WARNING")
        return []


def cancel_arr_search_commands(base: str, api_key: str, title_ids: set[int], rows: list[dict]) -> dict[int, int]:
    """Abort queued/started Arr searches for closed-out titles. One GET, then DELETEs."""
    cancelled: dict[int, int] = {}
    if not title_ids:
        return cancelled
    for cmd in rows:
        if not arr_command_is_search(cmd):
            continue
        status = str(cmd.get("status") or "").lower()
        if status not in {"", "started", "queued"}:
            continue
        cid = parse_int(cmd.get("id"))
        if cid is None:
            continue
        matched = [tid for tid in title_ids if arr_command_targets_title(cmd, tid)]
        if not matched:
            continue
        try:
            http("DELETE", f"{base}/command/{cid}", headers=arr_headers(api_key))
        except RuntimeError as exc:
            log(f"could not cancel Arr search {cid}: {exc}", "WARNING")
            continue
        for tid in matched:
            cancelled[tid] = cancelled.get(tid, 0) + 1
    return cancelled


def abort_arr_queue_for_titles(base: str, api_key: str, title_ids: set[int], rows: list[dict]) -> dict[int, int]:
    """Drop Arr-queued downloads for closed-out titles (not Prowlarr Grabs).

    Prowlarr Search → Grab uses the prowlarr qBittorrent category, so it is
    not in Radarr/Sonarr's queue. removeFromClient only touches the Arr
    category torrent. skipRedownload keeps Arr from immediately grabbing again
    while unmonitor is still in flight.
    """
    aborted: dict[int, int] = {}
    if not title_ids:
        return aborted
    for item in rows:
        tid = parse_int(item.get("movieId")) or parse_int(item.get("seriesId"))
        if tid is None or tid not in title_ids:
            continue
        qid = parse_int(item.get("id"))
        if qid is None:
            continue
        url = (
            f"{base}/queue/{qid}"
            "?removeFromClient=true&blocklist=false&skipRedownload=true"
        )
        try:
            http("DELETE", url, headers=arr_headers(api_key))
        except RuntimeError as exc:
            log(f"could not drop queued download {qid}: {exc}", "WARNING")
            continue
        aborted[tid] = aborted.get(tid, 0) + 1
    return aborted


def log_closed_title(item: dict, key: str, cancelled: int, aborted: int) -> None:
    label = str(item.get("title") or "") or key
    extra = []
    if cancelled:
        extra.append(f"{cancelled} search command(s)")
    if aborted:
        extra.append(f"{aborted} queued download(s)")
    suffix = f"; cancelled {' and '.join(extra)}" if extra else ""
    log(f"stopped looking for a better copy of {label} (Seerr request removed){suffix}")


def close_arr_kind(
    base: str,
    api_key: str,
    endpoint: str,
    rows: list[dict],
    keys: set[str],
    covered,
) -> set[str]:
    """Unmonitor uncovered titles, then cancel their searches/queue in one pass."""
    failed: set[str] = set()
    drop: list[dict] = []
    drop_ids: set[int] = set()
    hunting_ids: set[int] = set()
    for item in rows:
        if covered(item, keys):
            continue
        title_id = parse_int(item.get("id"))
        if title_id is None:
            continue
        drop.append(item)
        drop_ids.add(title_id)
        if title_is_hunting(item, endpoint):
            hunting_ids.add(title_id)
            try:
                unmonitor_arr_item(base, api_key, endpoint, item)
            except RuntimeError as exc:
                kind = "movie" if endpoint == "movie" else "series"
                log(f"could not unmonitor {kind}:{title_id}: {exc}", "WARNING")
                failed.add(f"{kind}:{title_id}")
    if not drop_ids:
        return failed
    cancelled = cancel_arr_search_commands(base, api_key, drop_ids, arr_list_commands(base, api_key))
    aborted = abort_arr_queue_for_titles(base, api_key, drop_ids, arr_list_queue(base, api_key))
    kind = "movie" if endpoint == "movie" else "series"
    for item in drop:
        title_id = parse_int(item.get("id"))
        if title_id is None:
            continue
        ncmd = cancelled.get(title_id, 0)
        nqueue = aborted.get(title_id, 0)
        if title_id in hunting_ids or ncmd or nqueue:
            log_closed_title(item, f"{kind}:{title_id}", ncmd, nqueue)
    return failed


def unmonitor_closed_seerr_requests(
    radarr: str, radarr_key: str, sonarr: str, sonarr_key: str
) -> None:
    """Stop Arr hunting when the household removes the Seerr request.

    The Seerr request is the ticket. If Seerr is readable, every movie/series
    that is not on an open request is unmonitored (including leftover Arr-only
    rows). TV seasons and monitorNewItems are turned off too — series.monitored
    false with seasons still on still RSS-hunts. Fail closed: a 403/5xx must
    not unmonitor. Never delete the Arr title row.
    """
    requests = load_open_seerr_requests()
    if requests is None:
        return
    keys = open_seerr_upgrade_keys(requests)
    failed: set[str] = set()
    try:
        movies = as_list(http("GET", f"{radarr}/movie", headers=arr_headers(radarr_key)))
    except RuntimeError as exc:
        log(f"could not list movies to close out: {exc}", "WARNING")
        movies = []
    try:
        series = as_list(http("GET", f"{sonarr}/series", headers=arr_headers(sonarr_key)))
    except RuntimeError as exc:
        log(f"could not list series to close out: {exc}", "WARNING")
        series = []
    failed |= close_arr_kind(radarr, radarr_key, "movie", movies, keys, request_covers_movie)
    failed |= close_arr_kind(sonarr, sonarr_key, "series", series, keys, request_covers_series)
    current = remembered_arr_upgrade_ids(keys)
    stored = sorted(set(current) | failed)
    state = _load_quiet()
    previous = state.get("seerr-upgrade-ids")
    if not isinstance(previous, list):
        previous = []
    if stored != previous:
        state["seerr-upgrade-ids"] = stored
        _save_quiet(state)


def prowlarr_source_fingerprint() -> str | None:
    try:
        secrets = load_secrets()
    except (OSError, RuntimeError, KeyError, TypeError, json.JSONDecodeError):
        return None
    key = str(secrets.get("prowlarr_api_key") or "").strip()
    if not key:
        return None
    try:
        rows = as_list(http("GET", f"{prowlarr_url()}/api/v1/indexer", headers=arr_headers(key)))
    except RuntimeError as exc:
        log(f"could not read Prowlarr sources: {exc}", "WARNING")
        return None
    ids = []
    for item in rows:
        if item.get("enable") is not True:
            continue
        iid = parse_int(item.get("id"))
        if iid is not None:
            ids.append(str(iid))
    return ",".join(sorted(ids))


def wanted_cutoff_records(base: str, api_key: str) -> list[dict] | None:
    try:
        payload = http(
            "GET",
            f"{base}/wanted/cutoff?page=1&pageSize=50&sortKey=title",
            headers=arr_headers(api_key),
        )
    except RuntimeError as exc:
        if "404" in str(exc):
            return []
        log(f"cutoff unmet: {exc}", "WARNING")
        return None
    return as_list(payload)


def retry_cutoff_unmet(
    radarr: str,
    radarr_key: str,
    sonarr: str,
    sonarr_key: str,
    skip_search: set[str] | None = None,
) -> None:
    """Search already-imported titles that are still below Default/Max cutoff.

    Runs when the Prowlarr source set changes (and once after this feature
    first wires). RSS still catches later announcements. Only titles with an
    open Seerr request are searched — remove the request to opt out.
    """
    skip_search = skip_search or set()
    if arr_search_in_flight(radarr, radarr_key) or arr_search_in_flight(sonarr, sonarr_key):
        return
    requests = load_open_seerr_requests()
    if requests is None:
        return
    fingerprint = prowlarr_source_fingerprint()
    if fingerprint is None:
        return
    state = _load_quiet()
    if (
        state.get("cutoff-sources") == fingerprint
        and state.get("cutoff-search") == CUTOFF_SEARCH_KIND
    ):
        return
    keys = open_seerr_upgrade_keys(requests)
    movie_ids: list[int] = []
    covered_episodes: list[dict] = []
    movies = wanted_cutoff_records(radarr, radarr_key)
    episodes = wanted_cutoff_records(sonarr, sonarr_key)
    if movies is None or episodes is None:
        return
    for item in movies:
        mid = parse_int(item.get("id"))
        if mid is not None and f"movie:{mid}" in skip_search:
            continue
        if mid is not None and request_covers_movie(item, keys):
            movie_ids.append(mid)
    for item in episodes:
        sid = series_id_of(item)
        if sid is not None and f"series:{sid}" in skip_search:
            continue
        if request_covers_episode(item, keys):
            covered_episodes.append(item)
    movie_ids = movie_ids[:8]
    seasons, episode_ids = season_and_episode_searches(covered_episodes)
    try:
        if movie_ids:
            http(
                "POST",
                f"{radarr}/command",
                {"name": "MoviesSearch", "movieIds": movie_ids},
                headers=arr_headers(radarr_key),
            )
            log(
                f"searching for a better copy of {len(movie_ids)} movie(s) still requested in Seerr"
            )
        if seasons or episode_ids:
            post_sonarr_season_and_episode_searches(
                sonarr,
                sonarr_key,
                seasons,
                episode_ids,
                f"searching for a better copy of {len(seasons)} season(s) still requested in Seerr",
                f"searching for a better copy of {len(episode_ids)} episode(s) still requested in Seerr",
            )
    except RuntimeError as exc:
        log(f"could not search cutoff unmet: {exc}", "WARNING")
        return
    state = _load_quiet()
    state["cutoff-sources"] = fingerprint
    state["cutoff-search"] = CUTOFF_SEARCH_KIND
    _save_quiet(state)


def improve_existing_requests(
    radarr: str,
    radarr_key: str,
    sonarr: str,
    sonarr_key: str,
    skip_search: set[str] | None = None,
) -> None:
    """Close-out unmonitor, then one cutoff poke when sources changed."""
    unmonitor_closed_seerr_requests(radarr, radarr_key, sonarr, sonarr_key)
    retry_cutoff_unmet(radarr, radarr_key, sonarr, sonarr_key, skip_search=skip_search)


def skip_search_keys_for_complete_grabs(
    radarr: str, rk: str, sonarr: str, sk: str
) -> set[str]:
    """Do not SeasonSearch a title while a matching Grab is still in the drop.

    Prowlarr Search → Grab uses the prowlarr qbit category and downloads/manual,
    so Arr CDH will not import it. Housekeep ManualImport runs on this pass; a
    missing-search in the same cycle grabs a second pack while the human file
    is still there. Only regular episode/movie leftovers count — extras and
    specials stay for the Plex-folder placer and must not freeze a holey season.
    """
    skipped: set[str] = set()
    videos = list_complete_videos()
    if not videos:
        return skipped
    series_rows = arr_library_titles(sonarr, sk, "sonarr")
    movie_rows = arr_library_titles(radarr, rk, "radarr")
    for path in videos:
        kind_bonus, _, _ = classify_bonus_video(path)
        if kind_bonus not in {"episode", "skip"}:
            continue
        _dest, title, kind, ident = match_bonus_library(path, series_rows, movie_rows)
        tid = parse_int(ident)
        if tid is None:
            continue
        key = hand_move_skip_key("radarr" if kind == "radarr" else "sonarr", tid)
        if key in skipped:
            continue
        skipped.add(key)
        label = title or key
        log_if_new(
            f"pending-grab:{key}",
            f"not searching {label}; a matching file is still in complete/ or manual/ "
            "(manual grab, not a new SeasonSearch)",
        )
    return skipped


def poke_missing_and_upgrades(radarr: str, rk: str, sonarr: str, sk: str) -> None:
    """Close removed Seerr tickets first, then reconcile, then missing/cutoff search."""
    unmonitor_closed_seerr_requests(radarr, rk, sonarr, sk)
    skip: set[str] = set()
    if not (arr_search_in_flight(radarr, rk) or arr_search_in_flight(sonarr, sk)):
        skip = reconcile_hand_moved_library_paths(radarr, rk, sonarr, sk)
        skip |= skip_search_keys_for_complete_grabs(radarr, rk, sonarr, sk)
    retry_unfilled_titles(radarr, rk, sonarr, sk, skip_search=skip)
    retry_cutoff_unmet(radarr, rk, sonarr, sk, skip_search=skip)


def qbit_category(name: str, save_path: str) -> None:
    data = urllib.parse.urlencode({"category": name, "savePath": save_path}).encode()
    try:
        http("POST", f"{qbit_url()}/api/v2/torrents/createCategory", data)
        log(f"qbit category {name} -> {save_path}")
    except RuntimeError as exc:
        # 409 = category already exists. Point it at the requested save path.
        if "409" in str(exc) or "already" in str(exc).lower():
            http("POST", f"{qbit_url()}/api/v2/torrents/editCategory", data)
            return
        raise


def qbit_torrents_url() -> str:
    return f"{qbit_url()}/api/v2/torrents/{'info'}"


def qbit_delete_url() -> str:
    return f"{qbit_url()}/api/v2/torrents/delete"


def qbit_stop_url() -> str:
    return f"{qbit_url()}/api/v2/torrents/{'stop'}"


def qbit_pause_url() -> str:
    return f"{qbit_url()}/api/v2/torrents/{'pause'}"


# Recheck/move is transient. missingFiles means the payload left (Arr import or a
# hand move). Leaving that torrent in qBittorrent is what re-downloads it.
QBIT_TRANSIENT = {
    "moving",
    "checkingDL",
    "checkingUP",
    "checkingResumeData",
    "allocating",
    "metaDL",
}
QBIT_STOPPED = {
    "pausedUP",
    "pausedDL",
    "stoppedUP",
    "stoppedDL",
}


VIDEO_EXTENSIONS = {
    ".mkv",
    ".mp4",
    ".avi",
    ".m4v",
    ".ts",
    ".m2ts",
    ".wmv",
    ".mov",
    ".webm",
    ".iso",
}


def is_video_file(name: str) -> bool:
    return os.path.splitext(name)[1].lower() in VIDEO_EXTENSIONS


def library_video_count(path: str, limit: int = 8) -> int:
    """How many videos sit under a library title folder (capped)."""
    root = os.path.normpath(path or "")
    if not root or not os.path.isdir(root):
        return 0
    count = 0
    try:
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [name for name in dirnames if not name.startswith(".")]
            for name in filenames:
                if name.startswith("."):
                    continue
                if is_video_file(name):
                    count += 1
                    if count >= limit:
                        return count
    except OSError:
        return count
    return count


def title_folder_name(path: str) -> str:
    return (path or "").rstrip("/").rsplit("/", 1)[-1]


def root_of_title_path(path: str, roots: list[str]) -> str:
    """Longest matching library root. Avoids `/media` beating Kid Friendly."""
    path = (path or "").rstrip("/")
    best = ""
    for root in roots:
        root = (root or "").rstrip("/")
        if in_root(path, root) and len(root) > len(best):
            best = root
    return best


def sibling_title_paths_with_video(stored: str, roots: list[str]) -> list[str]:
    """Same title folder name under another Kid / Not Kid / By Rating root."""
    name = title_folder_name(stored)
    if not name:
        return []
    stored_n = os.path.normpath(stored.rstrip("/")) if stored else ""
    found: list[str] = []
    for root in roots:
        root = (root or "").rstrip("/")
        if not root:
            continue
        candidate = os.path.normpath(f"{root}/{name}")
        if stored_n and candidate == stored_n:
            continue
        if library_video_count(candidate):
            found.append(candidate)
    return found


def plan_library_retarget(stored: str, roots: list[str]) -> tuple[str, str]:
    """Decide whether Arr's stored folder is the one that actually has video.

    keep — videos are at the stored path.
    retarget — exactly one sibling root has the title folder.
    ambiguous — two+ sibling folders have video; do not guess Kid vs Not Kid.
    missing — nothing on disk under these roots.
    """
    stored = (stored or "").rstrip("/")
    clean_roots = [root.rstrip("/") for root in roots if root]
    if library_video_count(stored):
        return "keep", root_of_title_path(stored, clean_roots)
    siblings = sibling_title_paths_with_video(stored, clean_roots)
    if len(siblings) == 1:
        return "retarget", root_of_title_path(siblings[0], clean_roots)
    if len(siblings) > 1:
        return "ambiguous", ""
    return "missing", ""


def season_videos_on_disk(series_path: str, season: int) -> bool:
    """True when Season N (folder or SxxE filenames) already has library video."""
    root = os.path.normpath(series_path or "")
    if not root or not os.path.isdir(root):
        return False
    try:
        want = int(season)
    except (TypeError, ValueError):
        return False
    prefix = f"S{want:02d}E"
    try:
        for name in os.listdir(root):
            if name.startswith("."):
                continue
            full = os.path.join(root, name)
            if os.path.isdir(full):
                match = SEASON_FOLDER_RE.match(name)
                if match and int(match.group(1)) == want and library_video_count(full):
                    return True
                continue
            if is_video_file(name) and video_episode_key(name).startswith(prefix):
                return True
    except OSError:
        return False
    return False


HAND_MOVE_STATE = "hand-move-roots"


def already_hand_moved(key: str, dest: str) -> bool:
    state = _load_quiet()
    done = state.get(HAND_MOVE_STATE)
    if not isinstance(done, dict):
        return False
    return done.get(key) == dest


def save_hand_move(key: str, dest: str) -> None:
    state = _load_quiet()
    done = state.get(HAND_MOVE_STATE)
    if not isinstance(done, dict):
        done = {}
    done[key] = dest
    state[HAND_MOVE_STATE] = done
    _save_quiet(state)


def hand_move_skip_key(kind: str, title_id: int) -> str:
    return f"{'movie' if kind == 'radarr' else 'series'}:{title_id}"


def post_arr_rescan(base: str, api_key: str, kind: str, title_id: int) -> None:
    name = "RescanMovie" if kind == "radarr" else "RescanSeries"
    id_key = "movieId" if kind == "radarr" else "seriesId"
    http(
        "POST",
        f"{base}/command",
        {"name": name, id_key: title_id},
        headers=arr_headers(api_key),
    )


def retarget_title_root(
    base: str, api_key: str, kind: str, title_id: int, dest_root: str
) -> None:
    collection = arr_title_collection(kind)
    id_key = "movieIds" if kind == "radarr" else "seriesIds"
    http(
        "PUT",
        f"{base}/{collection}/editor",
        {id_key: [title_id], "rootFolderPath": dest_root, "moveFiles": False},
        headers=arr_headers(api_key),
    )


def _reconcile_kind(base: str, api_key: str, kind: str) -> set[str]:
    """Retarget Arr when the household already moved the title folder.

    Editor with moveFiles false — the files are already at dest. Then rescan
    so episode records match disk. Skip search for titles we just pointed or
    that sit in more than one kid/general folder.
    """
    skipped: set[str] = set()
    auto, gen, kid = wanted_arr_roots("sonarr" if kind == "sonarr" else "radarr")
    roots = [auto, gen, kid]
    collection = arr_title_collection(kind)
    try:
        rows = as_list(http("GET", f"{base}/{collection}", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"{kind} hand-move reconcile: {exc}", "WARNING")
        return skipped
    for item in rows:
        if not isinstance(item, dict) or item.get("monitored") is False:
            continue
        tid = title_id_of(item)
        if tid is None:
            continue
        stored = title_library_path(item)
        if not stored:
            continue
        key = hand_move_skip_key(kind, tid)
        action, dest = plan_library_retarget(stored, roots)
        title = item.get("title") or key
        if action == "ambiguous":
            log(
                f"{kind} {title} is on more than one Kid / Not Kid / By Rating folder; "
                "not searching until there is one library copy",
                "WARNING",
            )
            skipped.add(key)
            continue
        if action == "retarget" and dest:
            if not already_hand_moved(key, dest):
                try:
                    retarget_title_root(base, api_key, kind, tid, dest)
                    post_arr_rescan(base, api_key, kind, tid)
                    save_hand_move(key, dest)
                    log(
                        f"{kind} pointed {title} at {dest} "
                        "(files already there; rescanning instead of grabbing again)"
                    )
                except RuntimeError as exc:
                    log(f"{kind} could not retarget {title}: {exc}", "WARNING")
                    skipped.add(key)
                    continue
            skipped.add(key)
            continue
        if action == "keep" and title_needs_library_file(item, kind):
            if not already_hand_moved(key, stored):
                try:
                    post_arr_rescan(base, api_key, kind, tid)
                    save_hand_move(key, stored)
                    log(
                        f"{kind} {title} already has library video at {stored}; "
                        "rescanning instead of grabbing again"
                    )
                except RuntimeError as exc:
                    log(f"{kind} could not rescan {title}: {exc}", "WARNING")
    return skipped


def reconcile_hand_moved_library_paths(
    radarr: str, radarr_key: str, sonarr: str, sonarr_key: str
) -> set[str]:
    skipped: set[str] = set()
    for kind, base, key in each_arr(radarr, radarr_key, sonarr, sonarr_key):
        skipped |= _reconcile_kind(base, key, kind)
    return skipped


def missing_episode_already_on_disk(item: dict, series_path: str) -> bool:
    """True when wanted/missing is a season folder Arr has not imported yet."""
    if not series_path:
        return False
    season = parse_int(item.get("seasonNumber"))
    if season is None:
        return library_video_count(series_path) > 0
    return season_videos_on_disk(series_path, season)


def video_episode_key(name: str) -> str:
    match = EPISODE_KEY_RE.search(name or "")
    if not match:
        return ""
    return f"S{int(match.group(1)):02d}E{int(match.group(2)):02d}"


def library_has_this_release(dest: str, source_name: str) -> bool:
    """True when the library folder already has this movie or this SxxExx."""
    if not dest or not os.path.isdir(dest):
        return False
    key = video_episode_key(source_name)
    try:
        for dirpath, dirnames, filenames in os.walk(dest):
            dirnames[:] = [name for name in dirnames if not name.startswith(".")]
            for name in filenames:
                if name.startswith(".") or not is_video_file(name):
                    continue
                if key:
                    if video_episode_key(name) == key:
                        return True
                    continue
                return True
    except OSError:
        return False
    return False


def path_has_video(path: str) -> bool:
    """True when a movie/episode file is still on disk (sidecars do not count)."""
    if not os.path.exists(path):
        return False
    if os.path.isfile(path):
        return is_video_file(os.path.basename(path))
    try:
        for dirpath, dirnames, filenames in os.walk(path):
            dirnames[:] = [name for name in dirnames if not name.startswith(".")]
            for name in filenames:
                if name.startswith("."):
                    continue
                if is_video_file(name):
                    return True
    except OSError:
        return True
    return False


def qbit_payload_gone(item: dict) -> bool:
    """True when the torrent's video is not on disk (moved into the library).

    Leftover .srt/.nfo/.txt next to an already-imported title do not keep the
    torrent alive — those extras are not the library file.
    """
    path = item.get("content_path")
    if not isinstance(path, str) or not path.strip():
        return str(item.get("state") or "") == "missingFiles"
    path = path.strip()
    if not os.path.exists(path):
        return True
    return not path_has_video(path)


def qbit_is_finished(item: dict) -> bool:
    try:
        progress = float(item.get("progress") or 0)
    except (TypeError, ValueError):
        progress = 0.0
    try:
        left = float(item.get("amount_left") or 1)
    except (TypeError, ValueError):
        left = 1.0
    return progress >= 0.999 or left == 0


def qbit_should_forget(item: dict, gone: bool | None = None) -> bool:
    """Drop the qBittorrent row only. Never delete files (library may be a hardlink)."""
    if not isinstance(item, dict):
        return False
    state = str(item.get("state") or "")
    if state in QBIT_TRANSIENT:
        return False
    if gone is None:
        gone = qbit_payload_gone(item)
    if state == "missingFiles":
        return True
    return bool(gone and qbit_is_finished(item))


def path_under_complete(path: str) -> bool:
    return path_under_root(path, downloads_complete())


def path_under_manual(path: str) -> bool:
    return path_under_root(path, downloads_manual())


def path_under_drop(path: str) -> bool:
    return path_under_complete(path) or path_under_manual(path)


def drop_folder_label(path: str) -> str:
    if path_under_manual(path):
        return "manual/"
    return "complete/"


def qbit_should_unlock(item: dict) -> bool:
    """Stop a finished torrent whose files still sit in complete/ or manual/.

    Arr completed-download handling only watches radarr/sonarr in complete/.
    A Prowlarr Grab in manual/ still needs to stop seeding so housekeep can
    ManualImport.
    """
    if not isinstance(item, dict):
        return False
    state = str(item.get("state") or "")
    if state in QBIT_TRANSIENT or state in QBIT_STOPPED:
        return False
    if state == "missingFiles" or qbit_payload_gone(item):
        return False
    if not qbit_is_finished(item):
        return False
    path = item.get("content_path") or item.get("save_path") or ""
    return path_under_drop(path)


def qbit_forget_torrents(hashes: list[str]) -> None:
    if not hashes:
        return
    data = urllib.parse.urlencode(
        {"hashes": "|".join(hashes), "deleteFiles": "false"}
    ).encode()
    http("POST", qbit_delete_url(), data)


def qbit_stop_torrents(hashes: list[str]) -> None:
    """qBittorrent 5 uses stop; 4.x still has pause. Never delete files."""
    if not hashes:
        return
    data = urllib.parse.urlencode({"hashes": "|".join(hashes)}).encode()
    try:
        http("POST", qbit_stop_url(), data)
        return
    except RuntimeError:
        http("POST", qbit_pause_url(), data)


def unlock_completed_torrents() -> None:
    """Release the CIFS lock on finished files so Arr can rename them into the library."""
    try:
        payload = http("GET", qbit_torrents_url())
    except RuntimeError as exc:
        log(f"qbit torrents: {exc}", "WARNING")
        return
    rows = payload if isinstance(payload, list) else []
    hashes: list[str] = []
    for item in rows:
        if not qbit_should_unlock(item):
            continue
        digest = item.get("hash")
        if digest:
            hashes.append(str(digest))
    if not hashes:
        return
    try:
        qbit_stop_torrents(hashes)
    except RuntimeError as exc:
        log(f"qbit stop completed: {exc}", "WARNING")
        return
    log(
        f"qbit stopped {len(hashes)} finished torrent(s) so Arr can rename "
        "into the library (torrent kept; files kept)"
    )


def forget_moved_torrents() -> None:
    """If the file already left complete/, drop the torrent so it cannot re-download."""
    try:
        payload = http("GET", qbit_torrents_url())
    except RuntimeError as exc:
        log(f"qbit torrents: {exc}", "WARNING")
        return
    rows = payload if isinstance(payload, list) else []
    hashes: list[str] = []
    for item in rows:
        if not isinstance(item, dict) or not qbit_should_forget(item):
            continue
        digest = item.get("hash")
        if digest:
            hashes.append(str(digest))
    if not hashes:
        return
    try:
        qbit_forget_torrents(hashes)
    except RuntimeError as exc:
        log(f"qbit forget moved: {exc}", "WARNING")
        return
    log(
        f"qbit dropped {len(hashes)} torrent(s) whose files were already moved "
        "(torrent only; library files kept)"
    )


def scan_download_drop(base: str, api_key: str, kind: str) -> None:
    """Import files Arr can match to a title it already has (Seerr's library folder).

    Destination is the movie/series path on Arr, not a guess from the filename.
    Kid vs Not Kid was stored when Seerr added the title.
    """
    names = (
        ("DownloadedMoviesScan", "DownloadedMovieScan")
        if kind == "radarr"
        else ("DownloadedEpisodesScan", "DownloadedEpisodeScan")
    )
    last: RuntimeError | None = None
    for path in existing_download_scan_paths(kind):
        posted = False
        for name in names:
            try:
                http(
                    "POST",
                    f"{base}/command",
                    {"name": name, "path": path, "importMode": "Move"},
                    headers=arr_headers(api_key),
                )
                posted = True
                last = None
                break
            except RuntimeError as exc:
                last = exc
                if "-> 400" not in str(exc) and "-> 404" not in str(exc):
                    log(f"{kind} download scan: {exc}", "WARNING")
                    posted = True
                    break
        if posted:
            scan_key = f"scan:{kind}:{path}"
            if count_complete_videos() == 0:
                forget_quiet(scan_key)
            else:
                log_if_new(
                    scan_key,
                    f"{kind} scanning {path} for files that already have an Arr library folder",
                )
        elif last is not None:
            log(f"{kind} download scan: {last}", "WARNING")


def import_rejection_text(item: dict) -> str:
    bits = []
    for rej in item.get("rejections") or []:
        if isinstance(rej, dict):
            bits.append(str(rej.get("reason") or rej.get("message") or rej))
        elif rej:
            bits.append(str(rej))
    return "; ".join(bit for bit in bits if bit)


def nested_arr_record(item: dict, kind: str) -> dict:
    key = "movie" if kind == "radarr" else "series"
    nested = item.get(key)
    return nested if isinstance(nested, dict) else {}


def arr_record_id(item: dict, kind: str):
    nested = nested_arr_record(item, kind)
    if kind == "radarr":
        return item.get("movieId") or nested.get("id")
    return item.get("seriesId") or nested.get("id")


def episode_ids_of(item: dict) -> list:
    wanted = item.get("episodeIds")
    if not isinstance(wanted, list):
        wanted = [
            ep.get("id")
            for ep in item.get("episodes") or []
            if isinstance(ep, dict) and ep.get("id")
        ]
    return [eid for eid in wanted if eid]


def fetch_arr_record(base: str, api_key: str, kind: str, ident):
    path = "movie" if kind == "radarr" else "series"
    return http("GET", f"{base}/{path}/{ident}", headers=arr_headers(api_key))


def each_arr(radarr: str, rk: str, sonarr: str, sk: str):
    return (("radarr", radarr, rk), ("sonarr", sonarr, sk))


def arr_import_destination(item: dict, kind: str) -> str:
    """Library folder Arr already has (Seerr's Kid / Not Kid choice), not the filename."""
    return title_library_path(nested_arr_record(item, kind))


def arr_already_has_library_file(item: dict, kind: str) -> bool:
    """True when Arr already assigned a library file. Do not ManualImport again.

    Re-importing a title that hasFile deletes the library copy (no recycle bin)
    and the subtitle extras that came with it.
    """
    if kind == "radarr":
        return nested_arr_record(item, kind).get("hasFile") is True
    episodes = item.get("episodes") if isinstance(item.get("episodes"), list) else []
    if not episodes:
        return False
    return all(isinstance(ep, dict) and ep.get("hasFile") is True for ep in episodes)


def lookup_arr_has_file(base: str, api_key: str, kind: str, item: dict) -> bool:
    """GET /manualimport often omits hasFile even after CDH already imported."""
    if arr_already_has_library_file(item, kind):
        return True
    ident = arr_record_id(item, kind)
    if not ident:
        return False
    try:
        if kind == "radarr":
            row = fetch_arr_record(base, api_key, kind, ident)
            return isinstance(row, dict) and row.get("hasFile") is True
        rows = as_list(
            http(
                "GET",
                f"{base}/episode?seriesId={ident}",
                headers=arr_headers(api_key),
            )
        )
        wanted_ids = set(episode_ids_of(item))
        if not wanted_ids:
            return False
        matched = [
            ep
            for ep in rows
            if isinstance(ep, dict) and ep.get("id") in wanted_ids
        ]
        return bool(matched) and all(ep.get("hasFile") is True for ep in matched)
    except RuntimeError:
        return False


EXPECTED_CROSS_KIND_REJECT = ("unknown series", "unknown movie")
HARD_IMPORT_REJECT = EXPECTED_CROSS_KIND_REJECT + ("sample",)


def is_expected_cross_kind_reject(reason: str) -> bool:
    low = reason.strip().lower()
    return any(low == bit or low.startswith(bit) for bit in EXPECTED_CROSS_KIND_REJECT)


def is_hard_import_reject(reason: str) -> bool:
    """True when housekeep must leave the file in complete/.

    Unknown movie/series is Radarr looking at a TV grab (or the reverse).
    Sample files are not library titles. Quality / custom-format / cutoff
    rejections are Arr taste — a human Prowlarr Grab already picked the
    release, so import it if Arr can match the title.
    """
    low = (reason or "").strip().lower()
    if not low:
        return False
    bits = [part.strip() for part in low.split(";") if part.strip()]
    for bit in bits:
        for hard in HARD_IMPORT_REJECT:
            if bit == hard or bit.startswith(hard) or f" {hard}" in bit:
                return True
    return False


def release_dir_under_complete(path: str) -> str:
    """Torrent folder under complete/ or manual/, not the drop root itself."""
    full = os.path.normpath((path or "").strip())
    if not full:
        return ""
    if os.path.isfile(full) or (
        not os.path.isdir(full) and os.path.splitext(full)[1]
    ):
        full = os.path.dirname(full)
    complete = os.path.normpath(downloads_complete())
    manual = os.path.normpath(downloads_manual())
    category = {
        os.path.normpath(os.path.join(complete, "radarr")),
        os.path.normpath(os.path.join(complete, "sonarr")),
    }
    roots = {complete, manual}
    if full in roots or full in category:
        return ""
    if not path_under_drop(full):
        return ""
    while True:
        parent = os.path.dirname(full)
        if parent in roots or parent in category:
            return full
        if parent == full:
            return ""
        full = parent


def library_dir_has_video(path: str) -> bool:
    return bool(path) and os.path.isdir(path) and path_has_video(path)


def remove_complete_release(release_dir: str, reason: str) -> None:
    if not release_dir or not os.path.isdir(release_dir):
        return
    if not safe_to_delete_complete_path(release_dir):
        return
    try:
        shutil.rmtree(release_dir)
    except OSError as exc:
        log(f"could not remove leftover complete/ folder: {exc}", "WARNING")
        return
    log(f"removed leftover complete/ folder ({reason})")


def remove_complete_leftover(path: str, reason: str) -> None:
    """Drop a leftover video sitting loose in complete/ or manual/, or its torrent folder."""
    if not path:
        return
    full = os.path.normpath(path.strip())
    if not safe_to_delete_complete_path(full):
        return
    drop_roots = {os.path.normpath(root) for root in download_drop_roots()}
    if os.path.isfile(full):
        try:
            os.remove(full)
        except OSError as exc:
            log(f"could not remove leftover {drop_folder_label(full)} file: {exc}", "WARNING")
            return
        log(
            f"removed leftover {drop_folder_label(full)} file ({reason}): "
            f"{os.path.basename(full)}"
        )
        parent = os.path.dirname(full)
        if parent not in drop_roots and os.path.isdir(parent) and not path_has_video(parent):
            remove_complete_release(parent, reason)
        return
    remove_complete_release(release_dir_under_complete(full) or full, reason)


def prune_complete_extras() -> None:
    """Arr imports the video (+ srt) into the library folder, not the torrent dump."""
    removed = 0

    def consider(folder: str) -> None:
        nonlocal removed
        if not os.path.isdir(folder):
            return
        if not safe_to_delete_complete_path(folder):
            return
        if path_has_video(folder):
            return
        try:
            shutil.rmtree(folder)
        except OSError:
            return
        removed += 1

    for root in download_drop_roots():
        if not os.path.isdir(root):
            continue
        if path_under_complete(root) and complete_overlaps_library():
            continue
        if path_under_manual(root) and manual_overlaps_library():
            continue
        try:
            names = [name for name in os.listdir(root) if not name.startswith(".")]
        except OSError:
            continue
        for name in names:
            full = os.path.join(root, name)
            if name in ("radarr", "sonarr") and os.path.isdir(full):
                try:
                    children = [
                        child for child in os.listdir(full) if not child.startswith(".")
                    ]
                except OSError:
                    continue
                for child in children:
                    consider(os.path.join(full, child))
                continue
            consider(full)
    if removed:
        log(
            f"removed {removed} leftover complete/manual folder(s) "
            "(extras only; library files kept)"
        )


def plex_extra_suffix_for(folder: str) -> str:
    for suffix, name in PLEX_EXTRA_SUFFIX.items():
        if name == folder:
            return suffix
    return "other"


def classify_bonus_video(path: str) -> tuple[str, str, str]:
    """Classify a leftover complete/ video for Plex extras / specials.

    Returns (kind, extra_folder, extra_suffix). kind is extra, special,
    episode, sample, or skip. Destination folder is Arr's title path — this
    only decides *what* the file is.
    """
    full = (path or "").replace("\\", "/")
    name = os.path.basename(full)
    stem, _ext = os.path.splitext(name)
    parts = [part for part in full.split("/") if part and part not in (".", "..")]
    if SAMPLE_NAME_RE.search(name) or any(
        SAMPLE_NAME_RE.search(f"{part}/") for part in parts[:-1]
    ):
        return "sample", "", ""
    suffix_hit = EXTRA_SUFFIX_RE.search(stem)
    if suffix_hit:
        folder = PLEX_EXTRA_SUFFIX[suffix_hit.group(1).lower()]
        return "extra", folder, plex_extra_suffix_for(folder)
    for part in parts[:-1]:
        alias = PLEX_EXTRA_FOLDER_ALIASES.get(part.strip().lower())
        if alias:
            return "extra", alias, plex_extra_suffix_for(alias)
    ep_key = video_episode_key(name)
    regular_episode = bool(ep_key) and not ep_key.startswith("S00")
    if regular_episode:
        return "episode", "", ""
    for pattern, folder in PLEX_EXTRA_KEYWORDS:
        if pattern.search(stem):
            return "extra", folder, plex_extra_suffix_for(folder)
    specials_dir = any(SPECIALS_FOLDER_RE.match(part) for part in parts[:-1])
    named_special = bool(SPECIAL_NAME_RE.search(stem)) and not NOT_SPECIAL_RE.search(stem)
    if ep_key.startswith("S00") or specials_dir or named_special:
        return "special", "", ""
    return "skip", "", ""


def bonus_display_title(name: str, show_title: str = "") -> str:
    stem = os.path.splitext(name or "")[0]
    stem = EXTRA_SUFFIX_RE.sub("", stem)
    stem = QUALITY_TAIL_RE.sub("", stem)
    stem = stem.replace(".", " ").replace("_", " ")
    stem = EPISODE_KEY_RE.sub(" ", stem)
    stem = re.sub(r"(?i)\bS\d{1,2}\b", " ", stem)
    if show_title:
        stem = re.sub(re.escape(show_title), " ", stem, flags=re.I)
    return re.sub(r"\s+", " ", stem).strip(" -.")


def season_hint_from_path(path: str) -> int | None:
    key = video_episode_key(os.path.basename(path or ""))
    if key:
        return int(key[1:3])
    for part in (path or "").replace("\\", "/").split("/"):
        match = SEASON_FOLDER_RE.match(part)
        if match:
            return int(match.group(1))
    token = SEASON_TOKEN_RE.search(os.path.basename(path or ""))
    if token:
        return int(token.group(1))
    return None


def specials_dest_dir(show_path: str) -> str:
    """Plex accepts Specials or Season 00. Reuse whichever already exists."""
    for name in ("Season 00", "Season 0", "Specials"):
        candidate = os.path.join(show_path, name)
        if os.path.isdir(candidate):
            return candidate
    return os.path.join(show_path, "Specials")


def extras_dest_dir(show_path: str, extra_folder: str, season: int | None) -> str:
    if season == 0:
        for name in ("Season 00", "Season 0"):
            candidate = os.path.join(show_path, name)
            if os.path.isdir(candidate):
                return os.path.join(candidate, extra_folder)
        return os.path.join(show_path, extra_folder)
    if season and season > 0:
        season_dir = os.path.join(show_path, f"Season {season:02d}")
        if os.path.isdir(season_dir):
            return os.path.join(season_dir, extra_folder)
    return os.path.join(show_path, extra_folder)


def next_specials_episode(dest_dir: str) -> int:
    used: set[int] = set()
    if os.path.isdir(dest_dir):
        try:
            names = os.listdir(dest_dir)
        except OSError:
            names = []
        for name in names:
            match = EPISODE_KEY_RE.search(name)
            if match and int(match.group(1)) == 0:
                used.add(int(match.group(2)))
    number = 1
    while number in used:
        number += 1
    return number


def title_match_tokens(text: str) -> list[str]:
    """Word tokens from a release or Arr title. Dots/Sxx/year are separators."""
    cleaned = WWW_PREFIX_RE.sub("", text or "")
    cleaned = YEAR_SUFFIX_RE.sub("", cleaned)
    cleaned = EPISODE_KEY_RE.sub(" ", cleaned)
    cleaned = re.sub(r"(?i)\bS\d{1,2}\b", " ", cleaned)
    cleaned = re.sub(r"[^a-z0-9]+", " ", cleaned.lower())
    return [part for part in cleaned.split() if part]


def tokens_as_sequence(needle: list[str], hay: list[str]) -> bool:
    if not needle or len(hay) < len(needle):
        return False
    size = len(needle)
    return any(hay[index : index + size] == needle for index in range(len(hay) - size + 1))


def best_arr_title_match(label: str, rows: list[dict]) -> dict | None:
    """Longest Arr title whose words appear in the release name. Not a substring.

    'Unknown' must not match UnknownShow. Never guesses Kid vs Not Kid.
    """
    hay = title_match_tokens(label)
    if not hay:
        return None
    best: dict | None = None
    best_len = 0
    for row in rows:
        if not isinstance(row, dict):
            continue
        candidates = [str(row.get("title") or "")]
        dest = title_library_path(row)
        if dest:
            candidates.append(os.path.basename(dest.rstrip("/")))
        for raw in candidates:
            needle = title_match_tokens(raw)
            joined = "".join(needle)
            if len(joined) < 3 or not tokens_as_sequence(needle, hay):
                continue
            if len(joined) > best_len:
                best = row
                best_len = len(joined)
    return best


def list_complete_videos() -> list[str]:
    found: list[str] = []
    try:
        for root in download_drop_roots():
            if not os.path.isdir(root):
                continue
            for dirpath, dirnames, filenames in os.walk(root):
                dirnames[:] = [name for name in dirnames if not name.startswith(".")]
                for name in filenames:
                    if name.startswith(".") or not is_video_file(name):
                        continue
                    found.append(os.path.join(dirpath, name))
    except OSError:
        return found
    return found


def bonus_sidecar_paths(video_path: str) -> list[str]:
    parent = os.path.dirname(video_path)
    stem = os.path.splitext(os.path.basename(video_path))[0]
    found: list[str] = []
    try:
        names = os.listdir(parent)
    except OSError:
        return found
    for name in names:
        if name.startswith("."):
            continue
        other_stem, ext = os.path.splitext(name)
        if other_stem != stem or ext.lower() not in SUBTITLE_EXTENSIONS:
            continue
        found.append(os.path.join(parent, name))
    return found


def find_library_episode_file(show_path: str, ep_key: str) -> str:
    if not ep_key or not os.path.isdir(show_path):
        return ""
    try:
        for dirpath, dirnames, filenames in os.walk(show_path):
            dirnames[:] = [name for name in dirnames if not name.startswith(".")]
            for name in filenames:
                if name.startswith(".") or not is_video_file(name):
                    continue
                if video_episode_key(name) != ep_key:
                    continue
                if EXTRA_SUFFIX_RE.search(os.path.splitext(name)[0]):
                    continue
                return os.path.join(dirpath, name)
    except OSError:
        return ""
    return ""


def episode_extra_dest(show_path: str, src_name: str, suffix: str) -> str:
    key = video_episode_key(src_name)
    if not key or key.startswith("S00") or not suffix:
        return ""
    existing = find_library_episode_file(show_path, key)
    if not existing:
        return ""
    return f"{os.path.splitext(existing)[0]}-{suffix}{os.path.splitext(src_name)[1]}"


def arr_library_titles(base: str, api_key: str, kind: str) -> list[dict]:
    endpoint = "movie" if kind == "radarr" else "series"
    try:
        return as_list(http("GET", f"{base}/{endpoint}", headers=arr_headers(api_key)))
    except RuntimeError as exc:
        log(f"{kind} library list for extras: {exc}", "WARNING")
        return []


def match_bonus_library(
    path: str, series_rows: list[dict], movie_rows: list[dict]
) -> tuple[str, str, str, object]:
    """Arr title folder for a leftover extra/special. TV first, then movies."""
    release = release_dir_under_complete(path)
    labels = []
    if release:
        labels.append(os.path.basename(release))
    labels.append(os.path.splitext(os.path.basename(path))[0])
    for kind, rows in (("sonarr", series_rows), ("radarr", movie_rows)):
        for label in labels:
            row = best_arr_title_match(label, rows)
            if not row:
                continue
            dest = title_library_path(row)
            title = str(row.get("title") or "") or os.path.basename(dest.rstrip("/"))
            if dest:
                return dest, title, kind, row.get("id")
    return "", "", "", None


def sonarr_wants_special(base: str, api_key: str, series_id, src_name: str) -> bool:
    """True when Sonarr still has this S00Exx as a missing special — leave it for Arr."""
    match = EPISODE_KEY_RE.search(src_name or "")
    if not match or int(match.group(1)) != 0 or not series_id:
        return False
    ep_num = int(match.group(2))
    try:
        rows = as_list(
            http(
                "GET",
                f"{base}/episode?seriesId={series_id}",
                headers=arr_headers(api_key),
            )
        )
    except RuntimeError:
        return False
    for ep in rows:
        if not isinstance(ep, dict):
            continue
        try:
            season = int(ep.get("seasonNumber"))
            number = int(ep.get("episodeNumber"))
        except (TypeError, ValueError):
            continue
        if season == 0 and number == ep_num and ep.get("hasFile") is not True:
            return True
    return False


def relocate_bonus_file(src: str, dest: str) -> bool:
    """Same-share rename into the library extras/specials folder. Never a library src."""
    if not src or not dest or not safe_to_delete_complete_path(src):
        return False
    if path_is_library(src):
        return False
    try:
        os.makedirs(os.path.dirname(dest), exist_ok=True)
    except OSError as exc:
        log(f"could not create Plex extras folder: {exc}", "WARNING")
        return False
    if os.path.exists(dest):
        try:
            os.remove(src)
        except OSError as exc:
            log(f"could not remove leftover complete/ extra: {exc}", "WARNING")
            return False
        log(f"library already has {os.path.basename(dest)}; removed leftover complete/ copy")
        return True
    try:
        shutil.move(src, dest)
    except OSError as exc:
        log(f"could not place Plex extra {os.path.basename(src)}: {exc}", "WARNING")
        return False
    log(f"placed Plex extra {os.path.basename(src)} -> {dest}")
    return True


def place_complete_plex_sidecars(
    radarr: str,
    rk: str,
    sonarr: str,
    sk: str,
    skip_paths: list[str] | None = None,
) -> int:
    """Move leftover extras and Season 00/specials into the Plex library layout.

    Arr only imports the episode (plus .srt). Season packs leave featurettes,
    interviews, and unmapped S00 specials in complete/. Plex wants those in
    Behind The Scenes / Featurettes / … or Specials (or existing Season 00).
    Destination is the Arr title path Seerr stored — we do not guess Kid vs
    Not Kid from the filename. Files Arr already queued to import stay put.
    """
    if complete_overlaps_library():
        return 0
    skip = {os.path.normpath(path) for path in (skip_paths or []) if path}
    series_rows = arr_library_titles(sonarr, sk, "sonarr")
    movie_rows = arr_library_titles(radarr, rk, "radarr")
    placed = 0

    def bonus_sort_key(path: str) -> tuple:
        key = video_episode_key(os.path.basename(path))
        numbered = 0 if key.startswith("S00") else 1
        return (numbered, path)

    for src in sorted(list_complete_videos(), key=bonus_sort_key):
        if os.path.normpath(src) in skip:
            continue
        kind, extra_folder, extra_suffix = classify_bonus_video(src)
        if kind == "sample":
            if safe_to_delete_complete_path(src):
                try:
                    os.remove(src)
                    log(f"removed leftover complete/ sample: {os.path.basename(src)}")
                except OSError:
                    pass
            continue
        if kind not in {"extra", "special"}:
            continue
        dest_root, title, arr_kind, ident = match_bonus_library(src, series_rows, movie_rows)
        if not dest_root:
            continue
        if kind == "special" and arr_kind != "sonarr":
            kind = "extra"
            extra_folder = extra_folder or "Other"
            extra_suffix = extra_suffix or "other"
        if kind == "special":
            if sonarr_wants_special(sonarr, sk, ident, os.path.basename(src)):
                continue
            dest_dir = specials_dest_dir(dest_root)
            ep_match = EPISODE_KEY_RE.search(os.path.basename(src))
            if ep_match and int(ep_match.group(1)) == 0:
                ep_label = f"S00E{int(ep_match.group(2)):02d}"
            else:
                ep_label = f"S00E{next_specials_episode(dest_dir):02d}"
            pretty = bonus_display_title(os.path.basename(src), title)
            ext = os.path.splitext(src)[1]
            filename = (
                f"{title} - {ep_label} - {pretty}{ext}"
                if pretty
                else f"{title} - {ep_label}{ext}"
            )
            dest = os.path.join(dest_dir, filename)
        else:
            ep_dest = episode_extra_dest(dest_root, os.path.basename(src), extra_suffix)
            if ep_dest:
                dest = ep_dest
            else:
                dest_dir = extras_dest_dir(
                    dest_root, extra_folder or "Other", season_hint_from_path(src)
                )
                pretty = bonus_display_title(os.path.basename(src), title) or (
                    extra_folder or "Extra"
                )
                dest = os.path.join(dest_dir, pretty + os.path.splitext(src)[1])
        sidecars = bonus_sidecar_paths(src)
        if not relocate_bonus_file(src, dest):
            continue
        placed += 1
        dest_stem = os.path.splitext(dest)[0]
        for side in sidecars:
            relocate_bonus_file(side, dest_stem + os.path.splitext(side)[1])
    if placed:
        log(f"placed {placed} leftover extra/special video(s) using Plex folders")
    return placed


def lookup_arr_library_path(base: str, api_key: str, kind: str, row: dict) -> str:
    ident = arr_record_id(row, kind)
    if not ident:
        return ""
    try:
        rec = fetch_arr_record(base, api_key, kind, ident)
        return title_library_path(rec if isinstance(rec, dict) else {})
    except RuntimeError:
        return ""


def manual_import_file(item: dict, kind: str) -> dict | None:
    path = item.get("path")
    if not isinstance(path, str) or not path.strip():
        return None
    quality = item.get("quality")
    if not isinstance(quality, dict):
        return None
    languages = item.get("languages") if isinstance(item.get("languages"), list) else []
    row = {
        "path": path,
        "quality": quality,
        "languages": languages,
        "downloadId": item.get("downloadId") or "",
        "releaseGroup": item.get("releaseGroup") or "",
    }
    if kind == "radarr":
        movie_id = arr_record_id(item, kind)
        if not movie_id:
            return None
        row["movieId"] = movie_id
        return row
    series_id = arr_record_id(item, kind)
    episode_ids = episode_ids_of(item)
    if not series_id or not episode_ids:
        return None
    row["seriesId"] = series_id
    row["episodeIds"] = episode_ids
    return row


def import_matched_drop(base: str, api_key: str, kind: str) -> list[str]:
    """Rename complete/ files Arr can match to a title it already has.

    Destination is the Arr folder (Seerr request, or a leftover row after the
    request was removed). Quality-profile rejections do not block a human
    Prowlarr Grab. Unknown series/movie and samples stay in complete/. A
    Grab with no Arr title also stays — we do not guess Kid vs Not Kid.
    """
    seen: set[str] = set()
    files: list[dict] = []
    queued: list[str] = []
    for folder in existing_download_scan_paths(kind):
        query = urllib.parse.urlencode(
            {"folder": folder, "filterExistingFiles": "false"}
        )
        try:
            payload = http(
                "GET",
                f"{base}/manualimport?{query}",
                headers=arr_headers(api_key),
            )
        except RuntimeError as exc:
            log(f"{kind} manual import list {folder}: {exc}", "WARNING")
            continue
        for item in as_list(payload):
            path = item.get("path")
            if not isinstance(path, str) or path in seen:
                continue
            seen.add(path)
            rejected = import_rejection_text(item)
            if rejected and is_hard_import_reject(rejected):
                if not is_expected_cross_kind_reject(rejected):
                    log(
                        f"{kind} will not import {os.path.basename(path)}: {rejected}",
                        "WARNING",
                    )
                continue
            dest = arr_import_destination(item, kind) or lookup_arr_library_path(
                base, api_key, kind, item
            )
            if path_is_library(path) or not path_under_drop(path):
                log(
                    f"{kind} skipped import of {path} "
                    "(not a leftover under downloads/complete or downloads/manual)",
                    "WARNING",
                )
                continue
            if dest and library_has_this_release(dest, os.path.basename(path)):
                log_if_new(
                    f"hasfile:{kind}:{os.path.basename(path)}",
                    f"{kind} already has a library file for "
                    f"{os.path.basename(path)} -> {dest} "
                    "(not re-importing leftover complete/ files)",
                )
                remove_complete_leftover(path, "title already in the library")
                continue
            if lookup_arr_has_file(base, api_key, kind, item):
                dest = dest or "Arr title path"
                log(
                    f"{kind} marks hasFile for {os.path.basename(path)} but "
                    f"{dest} does not have this video; importing leftover"
                )
            row = manual_import_file(item, kind)
            if not row:
                log_if_new(
                    f"nomatch:{kind}:{os.path.basename(path)}",
                    f"{kind} no library match for {os.path.basename(path)} "
                    "(request it in search first so Arr has a Kid / Not Kid folder; "
                    f"leaving it in {drop_folder_label(path)})",
                    "WARNING",
                )
                continue
            dest = dest or lookup_arr_library_path(base, api_key, kind, row)
            dest = dest or "Arr title path"
            if rejected:
                log(
                    f"{kind} importing {os.path.basename(path)} into {dest} "
                    f"despite {rejected} (manual grab; Arr already has this title)"
                )
            else:
                log(
                    f"{kind} importing {os.path.basename(path)} into {dest} "
                    "(Arr title folder, not a guess from the filename)"
                )
            files.append(row)
            queued.append(path)
    if not files:
        return queued
    try:
        http(
            "POST",
            f"{base}/command",
            {"name": "ManualImport", "files": files, "importMode": "Move"},
            headers=arr_headers(api_key),
        )
        log(f"{kind} renaming {len(files)} file(s) into the library")
    except RuntimeError as exc:
        log(f"{kind} manual import: {exc}", "WARNING")
    return queued


def log_complete_drop_contents() -> None:
    """Warn only when a video is still under complete/ or manual/. Sidecars are not the title."""
    videos: list[str] = []
    extras = 0
    saw_root = False
    for root in download_drop_roots():
        if not os.path.isdir(root):
            continue
        saw_root = True
        label = "manual" if path_under_manual(root) else "complete"
        try:
            for dirpath, dirnames, filenames in os.walk(root):
                dirnames[:] = [name for name in dirnames if not name.startswith(".")]
                for name in filenames:
                    if name.startswith("."):
                        continue
                    if not is_video_file(name):
                        extras += 1
                        continue
                    full = os.path.join(dirpath, name)
                    rel = os.path.relpath(full, root)
                    try:
                        size = os.path.getsize(full)
                    except OSError:
                        size = -1
                    prefix = f"{label}/" if label == "manual" else ""
                    videos.append(f"{prefix}{rel} ({size} bytes)")
                    if len(videos) >= 20:
                        break
                if len(videos) >= 20:
                    break
        except OSError:
            continue
        if len(videos) >= 20:
            break
    if not saw_root:
        log(f"complete folder is missing: {downloads_complete()}", "WARNING")
        return
    if videos:
        extra = " …" if len(videos) >= 20 else ""
        log_if_new(
            "complete-videos",
            f"still in complete/: {'; '.join(videos)}{extra}",
            "WARNING",
        )
        return
    if extras:
        log(
            f"complete/ leftovers are extras only ({extras} srt/nfo/txt file(s)); "
            "titles already in the library"
        )
        return
    names: list[str] = []
    for root in download_drop_roots():
        if not os.path.isdir(root):
            continue
        try:
            names.extend(
                name for name in os.listdir(root) if not name.startswith(".")
            )
        except OSError as exc:
            log(f"complete folder unreadable: {exc}", "WARNING")
            return
    if names:
        log(f"complete/ has folders but no files yet: {', '.join(names[:20])}", "WARNING")


class Seerr:
    def __init__(self, base: str | None = None):
        self.base = (base or seerr_url()).rstrip("/")
        self.cookie = ""
        self.api_key = ""

    def _headers(self) -> dict:
        headers = {"Content-Type": "application/json"}
        if self.cookie:
            headers["Cookie"] = self.cookie
        if self.api_key:
            headers["X-API-Key"] = self.api_key
        return headers

    def call(self, method: str, path: str, body=None):
        req = urllib.request.Request(
            self.base + path,
            data=None if body is None else json.dumps(body).encode(),
            method=method,
            headers=self._headers(),
        )
        try:
            with urllib.request.urlopen(req, timeout=45) as resp:
                cookies = []
                if hasattr(resp.headers, "get_all"):
                    cookies = resp.headers.get_all("Set-Cookie") or []
                elif resp.headers.get("Set-Cookie"):
                    cookies = [resp.headers.get("Set-Cookie")]
                for cookie in cookies:
                    self.cookie = cookie.split(";", 1)[0]
                raw = resp.read()
                if not raw:
                    return None
                text = raw.decode(errors="replace")
                try:
                    return json.loads(text)
                except json.JSONDecodeError:
                    return text
        except urllib.error.HTTPError as exc:
            err = exc.read().decode(errors="replace")
            raise RuntimeError(f"seerr {method} {path} -> {exc.code} {err[:400]}") from exc


def parse_plex(url: str):
    u = urllib.parse.urlparse(url)
    host = u.hostname or "127.0.0.1"
    port = u.port or (443 if u.scheme == "https" else 32400)
    ssl = u.scheme == "https"
    return host, port, ssl


def pick_plex_server(servers, host: str):
    candidates = []
    for srv in as_list(servers):
        provides = srv.get("provides") or []
        if isinstance(provides, str):
            provides = [provides]
        if "server" not in provides and provides:
            continue
        candidates.append(srv)
    owned = [s for s in candidates if s.get("owned")]
    pool = owned or candidates
    host_l = (host or "").lower()
    for srv in pool:
        for conn in as_list(srv.get("connection") or srv.get("connections")):
            addr = (conn.get("address") or "").lower()
            if addr == host_l:
                return srv
    return pool[0] if pool else None


def configure_seerr(secrets: dict, radarr_profile, sonarr_profile, sonarr_lang) -> None:
    s = Seerr()
    for _ in range(wait_tries()):
        try:
            s.call("GET", "/api/v1/settings/public")
            break
        except Exception:  # noqa: BLE001
            time.sleep(wait_sleep())
    else:
        raise RuntimeError("Seerr never became ready")

    s.api_key = seerr_api_key_from_disk()
    have_plex = bool(plex_url() and plex_token())
    if not have_plex:
        log("Plex URL/token missing; Seerr setup wizard will be used for Plex")

    if have_plex:
        try:
            s.call("POST", "/api/v1/auth/plex", {"authToken": plex_token()})
            log("seerr signed in with Plex token")
        except RuntimeError as exc:
            log(f"seerr plex login: {exc}", "WARNING")
            have_plex = False

    email = secrets.get("seerr_email") or "pompey@local"
    password = secrets.get("seerr_password") or ""
    # Disk API key is admin. POST /auth/local with the generated pompey@local
    # password 403s and Seerr logs "invalid Seerr password" on every wire retry.
    if password and not s.cookie and not s.api_key:
        try:
            s.call(
                "POST",
                "/api/v1/auth/local",
                {"email": email, "password": password, "name": "Pompey"},
            )
            log("seerr signed in with local account")
        except RuntimeError as exc:
            # Real Seerr: no local user until the wizard (or a later password). 403 is expected.
            log(f"seerr local login: {exc}", "WARNING")

    if not s.api_key:
        try:
            main = s.call("GET", "/api/v1/settings/main") or {}
            if isinstance(main, dict) and main.get("apiKey"):
                s.api_key = main["apiKey"]
        except RuntimeError as exc:
            log(f"seerr api key: {exc}", "WARNING")
        if not s.api_key:
            s.api_key = seerr_api_key_from_disk()

    def public_initialized() -> bool:
        public = s.call("GET", "/api/v1/settings/public") or {}
        return isinstance(public, dict) and bool(public.get("initialized"))

    initialized = public_initialized()

    if have_plex:
        host, port, ssl = parse_plex(plex_url())
        try:
            servers = as_list(s.call("GET", "/api/v1/settings/plex/devices/servers"))
            chosen = pick_plex_server(servers, host)
            payload = {
                "ip": host,
                "port": port,
                "useSsl": ssl,
                "webAppUrl": plex_url().rstrip("/"),
            }
            if chosen:
                payload["name"] = chosen.get("name") or "Plex"
                payload["machineId"] = chosen.get("clientIdentifier") or ""
            else:
                payload["name"] = "Plex"
                payload["machineId"] = "unknown"
            s.call("POST", "/api/v1/settings/plex", payload)
            log("plex settings")
        except RuntimeError as exc:
            log(f"plex settings: {exc}", "WARNING")

        try:
            s.call("POST", "/api/v1/settings/plex/library/sync")
            libs = as_list(s.call("GET", "/api/v1/settings/plex/library"))
            for lib in libs:
                lib_id = lib.get("id")
                if not lib_id:
                    continue
                try:
                    s.call("PUT", f"/api/v1/settings/plex/library/{lib_id}", {"enabled": True})
                except RuntimeError as exc:
                    log(f"plex library {lib_id}: {exc}", "WARNING")
            log("plex libraries enabled")
        except RuntimeError as exc:
            log(f"plex libraries: {exc}", "WARNING")

    radarr_id, radarr_name = radarr_profile
    sonarr_id, sonarr_name = sonarr_profile
    radarr_payload = {
        "name": "Radarr",
        "hostname": "127.0.0.1",
        "port": 7878,
        "apiKey": secrets["radarr_api_key"],
        "useSsl": False,
        "activeProfileId": radarr_id,
        "activeProfileName": radarr_name,
        "activeDirectory": movies_auto_dir(),
        "isDefault": True,
        "is4k": False,
        "minimumAvailability": "released",
        "syncEnabled": True,
        "preventSearch": False,
        "tagRequests": True,
        "urlBase": "",
        "externalUrl": "",
        "tags": [],
    }
    sonarr_payload = {
        "name": "Sonarr",
        "hostname": "127.0.0.1",
        "port": 8989,
        "apiKey": secrets["sonarr_api_key"],
        "useSsl": False,
        "activeProfileId": sonarr_id,
        "activeProfileName": sonarr_name,
        "activeDirectory": tv_auto_dir(),
        "activeAnimeDirectory": tv_auto_dir(),
        "isDefault": True,
        "is4k": False,
        "enableSeasonFolders": True,
        "syncEnabled": True,
        "preventSearch": False,
        "tagRequests": True,
        "urlBase": "",
        "externalUrl": "",
        "tags": [],
    }
    if sonarr_lang is not None:
        sonarr_payload["activeLanguageProfileId"] = sonarr_lang

    def upsert_arr(kind: str, payload: dict) -> bool:
        path = f"/api/v1/settings/{kind}"
        try:
            existing = as_list(s.call("GET", path))
            match = next(
                (item for item in existing if item.get("hostname") == "127.0.0.1"),
                None,
            )
            if match:
                want = (payload.get("activeDirectory") or "").rstrip("/")
                have = (match.get("activeDirectory") or "").rstrip("/")
                want_anime = (payload.get("activeAnimeDirectory") or "").rstrip("/")
                have_anime = (match.get("activeAnimeDirectory") or "").rstrip("/")
                server_id = match.get("id")
                dir_changed = bool(want and want != have) or bool(
                    want_anime and want_anime != have_anime
                )
                profile_changed = (
                    match.get("activeProfileId") != payload.get("activeProfileId")
                    or (match.get("activeProfileName") or "") != (payload.get("activeProfileName") or "")
                )
                if server_id is not None and (dir_changed or profile_changed):
                    update = dict(match)
                    update.update(payload)
                    # Seerr OpenAPI marks id read-only; it belongs in the URL.
                    update.pop("id", None)
                    s.call("PUT", f"{path}/{server_id}", update)
                    if dir_changed:
                        log(f"seerr {kind} directory {want}")
                    if profile_changed:
                        log(f"seerr {kind} profile {payload.get('activeProfileName')}")
                return True
            s.call("POST", path, payload)
            log(f"seerr {kind}")
            return True
        except RuntimeError as exc:
            # API key impersonates user id 1. That row does not exist until the
            # wizard creates the first admin, so settings 403. Hand off anyway.
            if "403" in str(exc) and not initialized:
                log(f"seerr {kind} waits until the Plex wizard creates the first admin")
                return False
            if "403" in str(exc):
                raise RuntimeError("seerr has no Radarr/Sonarr after initialize") from exc
            raise

    wired_arr = upsert_arr("radarr", radarr_payload)
    wired_arr = upsert_arr("sonarr", sonarr_payload) or wired_arr
    if wired_arr:
        open(os.path.join(ready_dir(), "seerr-arr"), "w").close()
    elif initialized:
        raise RuntimeError("seerr has no Radarr/Sonarr after initialize")

    try:
        s.call(
            "POST",
            "/api/v1/settings/main",
            {
                "applicationTitle": "Pompey",
                "applicationUrl": "",
                "defaultPermissions": SEERR_HOUSEHOLD_PERMS,
                "hideAvailable": False,
                "localLogin": True,
                "newPlexLogin": True,
            },
        )
    except RuntimeError as exc:
        log(f"seerr main settings: {exc}", "WARNING")

    try:
        users = s.call("GET", "/api/v1/user") or {}
        rows = as_list(users)
        if isinstance(users, dict) and not rows:
            rows = as_list(users.get("results") or users.get("users") or [])
        for user in rows:
            uid = user.get("id")
            if uid is None:
                continue
            update = seerr_permission_update(user)
            if update is None:
                continue
            try:
                s.call("PUT", f"/api/v1/user/{uid}", update)
            except RuntimeError as exc:
                log(f"seerr user {uid} permissions: {exc}", "WARNING")
    except RuntimeError as exc:
        log(f"seerr users: {exc}", "WARNING")

    try:
        s.call("POST", "/api/v1/settings/network", {"trustProxy": False})
    except RuntimeError as exc:
        log(f"seerr network: {exc}", "WARNING")

    public = s.call("GET", "/api/v1/settings/public") or {}
    already = isinstance(public, dict) and public.get("initialized")
    if already:
        return
    if have_plex:
        s.call("POST", "/api/v1/settings/initialize")
        log("seerr initialized")
    else:
        log("seerr left uninitialized so the Plex setup wizard can run")


def main() -> int:
    secrets = load_secrets()
    wait_http(f"{qbit_url()}/api/v2/app/version")
    wait_http(f"{prowlarr_url()}/ping")
    wait_http(f"{sonarr_url()}/ping")
    wait_http(f"{radarr_url()}/ping")

    sk, rk, pk = secrets["sonarr_api_key"], secrets["radarr_api_key"], secrets["prowlarr_api_key"]
    sonarr = arr_api_root(sonarr_url(), sk)
    radarr = arr_api_root(radarr_url(), rk)
    prowlarr = prowlarr_url()

    complete = downloads_complete()
    manual = downloads_manual()
    for folder in (complete, manual):
        try:
            os.makedirs(folder, exist_ok=True)
        except OSError as exc:
            log(f"could not create {folder}: {exc}", "WARNING")
    apply_qbit_queue()
    qbit_category("sonarr", complete)
    qbit_category("radarr", complete)
    qbit_category("prowlarr", manual)
    sync_root_folders(sonarr, sk, "sonarr")
    sync_root_folders(radarr, rk, "radarr")
    ensure_download_client(sonarr, sk, secrets, "sonarr")
    ensure_download_client(radarr, rk, secrets, "radarr")
    ensure_prowlarr_download_client(prowlarr, pk, secrets)
    # Recyclarr writes Default/Max before we create name stubs, so a successful
    # sync is not overwritten by a stock Arr clone. Quality still runs before
    # import settings so a Sonarr media-management 400 cannot leave Seerr on
    # stock Any / HD-720p and hang the wait screen.
    run_recyclarr()
    sp = household_quality_profile(sonarr, sk, "sonarr")
    rp = household_quality_profile(radarr, rk, "radarr")
    for kind, base, key in each_arr(radarr, rk, sonarr, sk):
        ensure_media_management(base, key, kind)
        ensure_download_client_handling(base, key, kind)
    ensure_prowlarr_app(prowlarr, pk, "Sonarr", "Sonarr", sonarr_url(), sk)
    ensure_prowlarr_app(prowlarr, pk, "Radarr", "Radarr", radarr_url(), rk)
    ensure_indexer(prowlarr, pk)
    sync_prowlarr_indexers(prowlarr, pk)
    log_arr_vs_prowlarr_indexers(radarr, rk, sonarr, sk, prowlarr, pk)
    for kind, base, key in each_arr(radarr, rk, sonarr, sk):
        ensure_arr_indexer_search(base, key, kind)
    import_finished_downloads(radarr, rk, sonarr, sk)
    log_recent_prowlarr_searches(prowlarr, pk)

    sl = language_profile_id(sonarr, sk)

    os.makedirs(ready_dir(), exist_ok=True)
    open(os.path.join(ready_dir(), "arr-wired"), "w").close()

    configure_seerr(secrets, rp, sp, sl)
    tickle_seerr_availability()
    improve_existing_requests(radarr, rk, sonarr, sk)
    port = os.environ.get("SEERR_PORT", "5055")
    sources = os.environ.get("PROWLARR_PORT", "9696")
    log(f"search is on 0.0.0.0:{port}; sources on 0.0.0.0:{sources}; Ingress stays Pompey")
    # Marker first so a concurrent fetch/vpn writer cannot rewind the bar.
    open(os.path.join(ready_dir(), "wired"), "w").close()
    mark_status("ready", "Ready", 100)
    log("done")
    return 0


def import_finished_downloads(radarr: str, rk: str, sonarr: str, sk: str) -> None:
    """Stop finished torrents, rename into the library, drop leftover complete/ files.

    Same path for movies and TV. Destination is the Arr title folder (Seerr
    request, or a leftover Arr row after files were deleted). Leftover extras
    and Season 00/specials are renamed into Plex extra folders (or Specials /
    existing Season 00) on that same title path. Refresh is skipped when
    complete/ is empty or a search is already running — those commands are
    higher priority than EpisodeSearch and starve the rest of a season.
    Missing-title retry runs after import, and skips a title whose matching
    Grab is still sitting in complete/.
    """
    log_search_diagnostics(radarr, rk, sonarr, sk)
    unlock_completed_torrents()
    engines = each_arr(radarr, rk, sonarr, sk)
    if complete_overlaps_library():
        log(
            "downloads/complete overlaps a library folder; "
            "not scanning or deleting leftovers (Plex library kept)",
            "ERROR",
        )
        for kind, base, key in engines:
            log_stuck_imports(base, key, kind)
            log_titles_waiting_for_library(base, key, kind)
        poke_missing_and_upgrades(radarr, rk, sonarr, sk)
        return
    videos = count_complete_videos()
    searching = arr_search_in_flight(radarr, rk) or arr_search_in_flight(sonarr, sk)
    queued: list[str] = []
    if videos:
        if searching:
            log_if_new(
                "skip-refresh-search",
                "not refreshing completed downloads while a search is running",
            )
        else:
            for kind, base, key in engines:
                refresh_monitored_downloads(base, key, kind)
        for kind, base, key in engines:
            scan_download_drop(base, key, kind)
        for kind, base, key in engines:
            queued.extend(import_matched_drop(base, key, kind))
    place_complete_plex_sidecars(radarr, rk, sonarr, sk, queued)
    forget_moved_torrents()
    prune_complete_extras()
    log_complete_drop_contents()
    for kind, base, key in engines:
        log_stuck_imports(base, key, kind)
        log_titles_waiting_for_library(base, key, kind)
    poke_missing_and_upgrades(radarr, rk, sonarr, sk)


def engines_checked_path() -> str:
    return os.path.join(ready_dir(), "engines-checked")


def engines_refresh_due() -> bool:
    """True when fetch-engines last succeeded more than a day ago.

    Missing marker means boot has not fetched yet (or unit tests). Do not
    hit Servarr from housekeep in that case.
    """
    path = engines_checked_path()
    if not os.path.isfile(path):
        return False
    try:
        max_age = float(env("POMPEY_ENGINE_REFRESH_AGE", "86400") or "86400")
    except ValueError:
        max_age = 86400.0
    try:
        return (time.time() - os.path.getmtime(path)) >= max_age
    except OSError:
        return False


def qbit_has_active_transfers() -> bool:
    """True when replacing qBittorrent-nox would interrupt a write to incomplete/."""
    try:
        payload = http("GET", qbit_torrents_url())
    except RuntimeError:
        return False
    rows = payload if isinstance(payload, list) else []
    for item in rows:
        if not isinstance(item, dict):
            continue
        state = str(item.get("state") or "")
        if state in QBIT_TRANSIENT:
            return True
        try:
            progress = float(item.get("progress") or 0)
        except (TypeError, ValueError):
            progress = 0.0
        if progress < 1 and state not in QBIT_STOPPED:
            return True
    return False


def fetch_engines_bin() -> str:
    override = env("POMPEY_FETCH_ENGINES")
    if override:
        return override
    found = shutil.which("fetch-engines")
    if found:
        return found
    here = os.path.dirname(os.path.abspath(__file__))
    sibling = os.path.join(here, "fetch-engines")
    if os.path.isfile(sibling):
        return sibling
    return "/usr/local/bin/fetch-engines"


def refresh_engines() -> list[str]:
    """Replace on-disk engines when upstream moved. Pompey is the orchestrator."""
    if not engines_refresh_due():
        return []
    script = fetch_engines_bin()
    if not os.path.isfile(script):
        return []
    envp = os.environ.copy()
    if qbit_has_active_transfers():
        envp["POMPEY_HOLD_QBIT"] = "1"
        log("engine refresh: qBittorrent is writing; not replacing that binary")
    try:
        proc = subprocess.run(
            [script],
            check=False,
            timeout=int(env("POMPEY_FETCH_TIMEOUT", "900") or "900"),
            env=envp,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        log(f"engine refresh: {exc}", "WARNING")
        return []
    if proc.returncode != 0:
        log("engine refresh failed; search stays on the installed copies", "WARNING")
        return []
    changed_path = os.path.join(ready_dir(), "engines-changed")
    try:
        with open(changed_path, encoding="utf-8") as fh:
            names = [line.strip() for line in fh if line.strip()]
    except OSError:
        names = []
    if names:
        log(f"engines replaced: {', '.join(names)}")
    return names


def housekeep() -> int:
    """Stop finished torrents, rename into the library, forget rows whose files left."""
    secrets = load_secrets()
    wait_http(f"{qbit_url()}/api/v2/app/version")
    wait_http(f"{sonarr_url()}/ping")
    wait_http(f"{radarr_url()}/ping")
    replaced = refresh_engines()
    if replaced:
        wait_http(f"{qbit_url()}/api/v2/app/version")
        wait_http(f"{sonarr_url()}/ping")
        wait_http(f"{radarr_url()}/ping")
    sk, rk = secrets["sonarr_api_key"], secrets["radarr_api_key"]
    sonarr = arr_api_root(sonarr_url(), sk)
    radarr = arr_api_root(radarr_url(), rk)
    run_recyclarr()
    for _kind, base, key in each_arr(radarr, rk, sonarr, sk):
        exclude_dual_subs_from_dual_audio_formats(base, key)
    import_finished_downloads(radarr, rk, sonarr, sk)
    tickle_seerr_availability()
    if replaced:
        try:
            subprocess.run(
                [sys.executable, os.path.abspath(__file__)],
                check=False,
                timeout=int(env("POMPEY_WIRE_TIMEOUT", "300") or "300"),
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            log(f"wire after engine refresh: {exc}", "WARNING")
    return 0


def closeout() -> int:
    """Unmonitor closed Seerr tickets and abort in-flight Arr hunts.

    Runs every ~15s from the wire service so a removed request does not wait
    for the five-minute housekeep tick (and a phantom SeasonSearch).
    """
    secrets = load_secrets()
    wait_http(f"{sonarr_url()}/ping")
    wait_http(f"{radarr_url()}/ping")
    sk, rk = secrets["sonarr_api_key"], secrets["radarr_api_key"]
    sonarr = arr_api_root(sonarr_url(), sk)
    radarr = arr_api_root(radarr_url(), rk)
    unmonitor_closed_seerr_requests(radarr, rk, sonarr, sk)
    return 0


if __name__ == "__main__":
    try:
        if len(sys.argv) > 1 and sys.argv[1] == "housekeep":
            raise SystemExit(housekeep())
        if len(sys.argv) > 1 and sys.argv[1] == "closeout":
            raise SystemExit(closeout())
        raise SystemExit(main())
    except Exception as exc:  # noqa: BLE001
        log(str(exc), "ERROR")
        # Re-wire after an engine swap must not flip the wait screen off search.
        if not os.path.isfile(os.path.join(ready_dir(), "wired")):
            mark_status(
                "wire",
                "Could not finish connecting search",
                80,
                str(exc)[:240],
            )
        raise SystemExit(1)
