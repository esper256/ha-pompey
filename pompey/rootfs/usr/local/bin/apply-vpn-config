#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail
# shellcheck source=/dev/null
source "$(command -v pompey-env)"
[[ -s "${POMPEY_WG_FILE}" ]] || exit 2
python3 "$(command -v vpn_config.py)" \
  "${POMPEY_WG_FILE}" "${POMPEY_WG_CONF}" "${POMPEY_READY}/vpn-config.json"
printf '%s\n' "${POMPEY_LAN_NETWORKS}" > "${POMPEY_LAN_FILE}"
if [[ "${POMPEY_FAKE_VPN:-}" != "1" ]]; then
  vpn-killswitch "${POMPEY_WG_CONF}" || exit 4
fi
touch "${POMPEY_READY}/vpn-applied"
