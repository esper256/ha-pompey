#!/command/with-contenv bashio
# shellcheck shell=bash
# Push Proton's mapped port into qBittorrent (localhost WebUI).
set -euo pipefail
# shellcheck source=/dev/null
source /usr/local/bin/pompey-env

PORT_FILE="${1:-/tmp/vpn/forwarded_port}"
[[ -s "${PORT_FILE}" ]] || exit 0
PORT="$(tr -d '[:space:]' < "${PORT_FILE}")"
[[ "${PORT}" =~ ^[0-9]+$ ]] || exit 0

# LocalHostAuth is off; still try a login in case a later conf tightens it.
cookie_jar="$(mktemp)"
cleanup() { rm -f "${cookie_jar}"; }
trap cleanup EXIT

if [[ -s "${POMPEY_SECRETS}" ]]; then
  USER="$(jq -r .qbit_user "${POMPEY_SECRETS}")"
  PASS="$(jq -r .qbit_password "${POMPEY_SECRETS}")"
  curl -fsS -c "${cookie_jar}" -b "${cookie_jar}" \
    --data-urlencode "username=${USER}" \
    --data-urlencode "password=${PASS}" \
    http://127.0.0.1:8080/api/v2/auth/login >/dev/null 2>&1 || true
fi

curl -fsS -c "${cookie_jar}" -b "${cookie_jar}" \
  --data-urlencode "json={\"listen_port\": ${PORT}, \"upnp\": false}" \
  http://127.0.0.1:8080/api/v2/app/setPreferences >/dev/null 2>&1 || true
