#!/command/with-contenv bashio
# shellcheck shell=bash
# Apply an OUTPUT kill switch that does not depend on the default route.
# Allowed: loopback, wg0, established, HA/LAN CIDRs, UDP handshake to Proton.
set -euo pipefail

WG_CONF="${1:-${POMPEY_WG_CONF:-/etc/wireguard/wg0.conf}}"
LAN_FILE="${POMPEY_LAN_FILE:-/etc/pompey-lan-networks}"
HASS_NET="172.30.32.0/23"

if [[ ! -f "${WG_CONF}" ]]; then
  bashio::exit.nok "vpn-killswitch: missing ${WG_CONF}"
fi

ENDPOINT="$(awk -F'=' '{
  key=$1
  gsub(/[[:space:]]/, "", key)
  if (tolower(key) == "endpoint") {
    val=$2
    gsub(/[[:space:]]/, "", val)
    print val
    exit
  }
}' "${WG_CONF}")"
ENDPOINT_IP="${ENDPOINT%%:*}"
ENDPOINT_PORT="${ENDPOINT##*:}"
if [[ -z "${ENDPOINT_IP}" || -z "${ENDPOINT_PORT}" || "${ENDPOINT_IP}" == "${ENDPOINT_PORT}" ]]; then
  bashio::exit.nok "vpn-killswitch: could not parse Endpoint from ${WG_CONF}"
fi

iptables_bin() {
  if command -v iptables-legacy >/dev/null 2>&1; then
    command -v iptables-legacy
  else
    command -v iptables
  fi
}

ip6tables_bin() {
  if command -v ip6tables-legacy >/dev/null 2>&1; then
    command -v ip6tables-legacy
  else
    command -v ip6tables
  fi
}

ensure_chain() {
  local bin="$1"
  "${bin}" -N POMPEY-KILLSWITCH 2>/dev/null || "${bin}" -F POMPEY-KILLSWITCH
  if ! "${bin}" -C OUTPUT -j POMPEY-KILLSWITCH >/dev/null 2>&1; then
    "${bin}" -I OUTPUT 1 -j POMPEY-KILLSWITCH
  fi
}

IPT="$(iptables_bin)"
ensure_chain "${IPT}"
"${IPT}" -A POMPEY-KILLSWITCH -o lo -j ACCEPT
"${IPT}" -A POMPEY-KILLSWITCH -o wg0 -j ACCEPT
"${IPT}" -A POMPEY-KILLSWITCH -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
"${IPT}" -A POMPEY-KILLSWITCH -d "${HASS_NET}" -j ACCEPT
"${IPT}" -A POMPEY-KILLSWITCH -d "${ENDPOINT_IP}" -p udp --dport "${ENDPOINT_PORT}" -j ACCEPT

if [[ -f "${LAN_FILE}" ]]; then
  IFS=',' read -r -a cidrs <"${LAN_FILE}"
  for cidr in "${cidrs[@]}"; do
    cidr="${cidr// /}"
    [[ -n "${cidr}" ]] || continue
    "${IPT}" -A POMPEY-KILLSWITCH -d "${cidr}" -j ACCEPT
  done
fi

"${IPT}" -A POMPEY-KILLSWITCH -j DROP

IP6="$(ip6tables_bin || true)"
if [[ -n "${IP6}" ]]; then
  ensure_chain "${IP6}"
  "${IP6}" -A POMPEY-KILLSWITCH -o lo -j ACCEPT
  "${IP6}" -A POMPEY-KILLSWITCH -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  "${IP6}" -A POMPEY-KILLSWITCH -j DROP
fi
