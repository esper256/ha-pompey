#!/command/with-contenv bashio
# shellcheck shell=bash
# Apply an OUTPUT kill switch that does not depend on the default route.
# Allowed: loopback, wg0, established, HA/LAN CIDRs, UDP handshake to Proton.
# OUTPUT only: Supervisor Ingress to :8099 is INPUT and is not blocked.
#
# Home Assistant OS is nftables. iptables-legacy needs iptable_filter, which
# this container does not have (/lib/modules is missing). Prefer a backend
# that can actually list the filter table; if none can, exit 4 so the tunnel
# still comes up.
set -euo pipefail

WG_CONF="${1:-${POMPEY_WG_CONF:-/etc/wireguard/wg0.conf}}"
LAN_FILE="${POMPEY_LAN_FILE:-/etc/pompey-lan-networks}"
HASS_NET="172.30.32.0/23"

if [[ ! -f "${WG_CONF}" ]]; then
  bashio::log.error "vpn-killswitch: missing ${WG_CONF}"
  exit 1
fi

ENDPOINT="$(awk -F'=' '{
  key=$1
  gsub(/[[:space:]]/, "", key)
  if (tolower(key) == "endpoint") {
    val=$2
    gsub(/[[:space:]]/, "", val)
    print val
    exit
  }
}' "${WG_CONF}")"
ENDPOINT_IP="${ENDPOINT%%:*}"
ENDPOINT_PORT="${ENDPOINT##*:}"
if [[ -z "${ENDPOINT_IP}" || -z "${ENDPOINT_PORT}" || "${ENDPOINT_IP}" == "${ENDPOINT_PORT}" ]]; then
  bashio::log.error "vpn-killswitch: could not parse Endpoint from ${WG_CONF}"
  exit 1
fi

filter_ok() {
  local bin="$1"
  "${bin}" -w 5 -t filter -L -n >/dev/null 2>&1
}

pick_iptables() {
  local cand
  for cand in iptables-nft iptables iptables-legacy; do
    command -v "${cand}" >/dev/null 2>&1 || continue
    if filter_ok "${cand}"; then
      command -v "${cand}"
      return 0
    fi
  done
  return 1
}

pick_ip6tables() {
  local cand
  for cand in ip6tables-nft ip6tables ip6tables-legacy; do
    command -v "${cand}" >/dev/null 2>&1 || continue
    if filter_ok "${cand}"; then
      command -v "${cand}"
      return 0
    fi
  done
  return 1
}

ensure_chain() {
  local bin="$1"
  "${bin}" -w 5 -N POMPEY-KILLSWITCH 2>/dev/null || "${bin}" -w 5 -F POMPEY-KILLSWITCH
  if ! "${bin}" -w 5 -C OUTPUT -j POMPEY-KILLSWITCH >/dev/null 2>&1; then
    "${bin}" -w 5 -I OUTPUT 1 -j POMPEY-KILLSWITCH
  fi
}

lan_cidrs() {
  local cidr
  local -a cidrs=()
  if [[ ! -f "${LAN_FILE}" ]]; then
    return 0
  fi
  IFS=',' read -r -a cidrs <"${LAN_FILE}" || true
  for cidr in "${cidrs[@]}"; do
    cidr="${cidr// /}"
    [[ -n "${cidr}" ]] || continue
    printf '%s\n' "${cidr}"
  done
}

apply_iptables() {
  local ipt="$1"
  ensure_chain "${ipt}"
  "${ipt}" -w 5 -A POMPEY-KILLSWITCH -o lo -j ACCEPT
  "${ipt}" -w 5 -A POMPEY-KILLSWITCH -o wg0 -j ACCEPT
  "${ipt}" -w 5 -A POMPEY-KILLSWITCH -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  "${ipt}" -w 5 -A POMPEY-KILLSWITCH -d "${HASS_NET}" -j ACCEPT
  "${ipt}" -w 5 -A POMPEY-KILLSWITCH -d "${ENDPOINT_IP}" -p udp --dport "${ENDPOINT_PORT}" -j ACCEPT
  while IFS= read -r cidr; do
    "${ipt}" -w 5 -A POMPEY-KILLSWITCH -d "${cidr}" -j ACCEPT
  done < <(lan_cidrs)
  "${ipt}" -w 5 -A POMPEY-KILLSWITCH -j DROP
}

apply_nft() {
  local cidr nft_script
  nft_script="table inet pompey {
  chain output {
    type filter hook output priority 0; policy accept;
    oifname \"lo\" accept
    oifname \"wg0\" accept
    ct state established,related accept
    ip daddr ${HASS_NET} accept
    ip daddr ${ENDPOINT_IP} udp dport ${ENDPOINT_PORT} accept
"
  while IFS= read -r cidr; do
    nft_script+="    ip daddr ${cidr} accept
"
  done < <(lan_cidrs)
  nft_script+="    drop
  }
}
"
  nft delete table inet pompey >/dev/null 2>&1 || true
  nft -f - <<<"${nft_script}"
}

IPT="$(pick_iptables || true)"
if [[ -n "${IPT}" ]]; then
  apply_iptables "${IPT}"
  IP6="$(pick_ip6tables || true)"
  if [[ -n "${IP6}" ]]; then
    ensure_chain "${IP6}"
    "${IP6}" -w 5 -A POMPEY-KILLSWITCH -o lo -j ACCEPT
    "${IP6}" -w 5 -A POMPEY-KILLSWITCH -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    "${IP6}" -w 5 -A POMPEY-KILLSWITCH -j DROP || true
  fi
  bashio::log.info "iptables kill switch applied via ${IPT##*/}"
  exit 0
fi

if [[ "${ENDPOINT_IP}" =~ ^[0-9.]+$ && "${ENDPOINT_PORT}" =~ ^[0-9]+$ ]] \
  && command -v nft >/dev/null 2>&1 && nft list tables >/dev/null 2>&1; then
  if apply_nft; then
    bashio::log.info "nft kill switch applied (no working iptables filter table)"
    exit 0
  fi
  bashio::log.warning "nft was present but could not install the kill switch"
fi

bashio::log.warning "Kill switch could not attach (no iptables/nft filter table on this Home Assistant host). Proton file is saved; starting the tunnel anyway. If the tunnel drops, traffic may leak until a firewall table exists."
exit 4
