#!/command/with-contenv bashio
# shellcheck shell=bash
# Create persisted API keys and qBittorrent password once.
set -euo pipefail
# shellcheck source=/dev/null
source "$(command -v pompey-env)"

python3 - "${POMPEY_SECRETS}" <<'PY'
import hashlib
import json
import os
import secrets
import sys

path = sys.argv[1]
os.makedirs(os.path.dirname(path), exist_ok=True)
data = {}
if os.path.isfile(path) and os.path.getsize(path) > 0:
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)


def rand_hex(n=32):
    return secrets.token_hex(n // 2)


def rand_pass():
    return secrets.token_urlsafe(18)


data.setdefault("sonarr_api_key", rand_hex())
data.setdefault("radarr_api_key", rand_hex())
data.setdefault("prowlarr_api_key", rand_hex())
data.setdefault("qbit_user", "pompey")
data.setdefault("qbit_password", rand_pass())
data.setdefault("seerr_email", "pompey@local")
data.setdefault("seerr_password", rand_pass())

# qBittorrent WebUI PBKDF2-HMAC-SHA512 (Password_PBKDF2). Keep the first hash
# so a later boot does not invalidate qBittorrent.conf.
if not data.get("qbit_pbkdf2"):
    import base64

    pw = data["qbit_password"].encode()
    salt = os.urandom(16)
    key = hashlib.pbkdf2_hmac("sha512", pw, salt, 100000, dklen=64)
    data["qbit_pbkdf2"] = (
        "@ByteArray("
        + base64.b64encode(salt).decode()
        + ":"
        + base64.b64encode(key).decode()
        + ")"
    )

tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2)
    fh.write("\n")
os.chmod(tmp, 0o600)
os.replace(tmp, path)
print(path)
PY
