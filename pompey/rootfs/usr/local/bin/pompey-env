#!/command/with-contenv bashio
# shellcheck shell=bash
# Shared paths. Sourced by other scripts.
# shellcheck disable=SC2034
set -euo pipefail

POMPEY_DATA="${POMPEY_DATA:-/data/pompey}"
POMPEY_ENGINES="${POMPEY_ENGINES:-/opt/pompey/engines}"
POMPEY_SECRETS="${POMPEY_SECRETS:-${POMPEY_DATA}/secrets.json}"
POMPEY_READY="${POMPEY_READY:-/tmp/pompey}"
POMPEY_CONFIG="${POMPEY_CONFIG:-/config}"
POMPEY_WG_ETC="${POMPEY_WG_ETC:-/etc/wireguard}"
POMPEY_WG_CONF="${POMPEY_WG_CONF:-${POMPEY_WG_ETC}/wg0.conf}"
POMPEY_WG_FILE="${POMPEY_WG_FILE:-${POMPEY_CONFIG}/wireguard/wg0.conf}"

POMPEY_LAN_NETWORKS="${POMPEY_LAN_NETWORKS:-}"
POMPEY_VPN_TMP="${POMPEY_VPN_TMP:-/tmp/vpn}"
POMPEY_LAN_FILE="${POMPEY_LAN_FILE:-/etc/pompey-lan-networks}"
POMPEY_RESOLV="${POMPEY_RESOLV:-/etc/resolv.conf}"
POMPEY_NGINX_RUN="${POMPEY_NGINX_RUN:-/run/nginx}"
NGINX_INGRESS_CONF="${NGINX_INGRESS_CONF:-/etc/nginx/http.d/ingress.conf}"

# Supervisor supplies this file. Reading it directly also permits an isolated
# production boot without emulating Supervisor's HTTP API.
pompey_option() { jq -r --arg key "$1" '.[$key] // empty' /data/options.json; }
if [[ -f /data/options.json ]]; then
  : "${MEDIA_ROOT:=$(pompey_option media_folder)}"
  : "${MEDIA_MOVIES:=$(pompey_option movies_folder)}"
  : "${MEDIA_MOVIES_KID:=$(pompey_option movies_kid_folder)}"
  : "${MEDIA_TV:=$(pompey_option tv_folder)}"
  : "${MEDIA_TV_KID:=$(pompey_option tv_kid_folder)}"
  : "${POMPEY_LAN_NETWORKS:=$(pompey_option lan_networks)}"
  : "${NAT_PMP_GATEWAY:=$(pompey_option nat_pmp_gateway)}"
  : "${AFTER_DOWNLOAD:=$(pompey_option after_download)}"
  : "${SIMULTANEOUS_DOWNLOADS:=$(pompey_option simultaneous_downloads)}"
  if [[ "$(pompey_option debug)" == true ]]; then
    : "${POMPEY_DEBUG:=1}"
  fi
fi
NAT_PMP_GATEWAY="${NAT_PMP_GATEWAY:-}"
[[ "${NAT_PMP_GATEWAY}" != "null" ]] || NAT_PMP_GATEWAY=""
export NAT_PMP_GATEWAY POMPEY_LAN_NETWORKS
MEDIA_ROOT="${MEDIA_ROOT:-/media/dlna}"
MEDIA_MOVIES="${MEDIA_MOVIES:-Movies/Not Kid Friendly}"
MEDIA_MOVIES_KID="${MEDIA_MOVIES_KID:-Movies/Kid Friendly}"
MEDIA_TV="${MEDIA_TV:-TV/Not Kid Friendly}"
MEDIA_TV_KID="${MEDIA_TV_KID:-TV/Kid Friendly}"
AFTER_DOWNLOAD="${AFTER_DOWNLOAD:-stop_sharing}"
SIMULTANEOUS_DOWNLOADS="${SIMULTANEOUS_DOWNLOADS:-8}"
POMPEY_DEBUG="${POMPEY_DEBUG:-0}"
export MEDIA_ROOT MEDIA_MOVIES MEDIA_MOVIES_KID MEDIA_TV MEDIA_TV_KID AFTER_DOWNLOAD SIMULTANEOUS_DOWNLOADS POMPEY_DEBUG

python3 "$(command -v pompey_config.py)"

mkdir -p \
  "${POMPEY_DATA}" \
    "${POMPEY_READY}" \
  "${POMPEY_CONFIG}/wireguard" \
  "${POMPEY_CONFIG}/sonarr" \
  "${POMPEY_CONFIG}/radarr" \
  "${POMPEY_CONFIG}/prowlarr" \
  "${POMPEY_CONFIG}/qBittorrent" \
  "${POMPEY_CONFIG}/seerr" \
  "${MEDIA_ROOT}/${MEDIA_MOVIES}" \
  "${MEDIA_ROOT}/${MEDIA_TV}" \
  "${MEDIA_ROOT}/${MEDIA_MOVIES_KID}" \
  "${MEDIA_ROOT}/${MEDIA_TV_KID}" \
  "${MEDIA_ROOT}/downloads/By Rating/Movies" \
  "${MEDIA_ROOT}/downloads/By Rating/TV" \
  "${MEDIA_ROOT}/downloads/incomplete" \
  "${MEDIA_ROOT}/downloads/complete"
chmod 700 "${POMPEY_CONFIG}/wireguard" 2>/dev/null || true
