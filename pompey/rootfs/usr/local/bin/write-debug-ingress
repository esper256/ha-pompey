#!/usr/bin/env python3
"""Write the Ingress nginx include that exposes hidden engine Web UIs.

When POMPEY_DEBUG is on, /debug/radarr/ /debug/sonarr/ /debug/qbittorrent/
proxy to the localhost engines. UrlBase stays empty so wire-stack and
housekeeping keep talking to /api/v3.

Modern Arr serves Vite bundles at the site root (/index-<hash>.js). A
root-absolute src="/index-….js" would leave Ingress and hit Home Assistant
as text/plain. nginx sub_filter does not rescan its own replacements, so
we cannot stage through a sentinel. Turning those paths into ./ relative
URLs does not rematch (the replacement is quote-dot-slash, not quote-slash)
and they resolve under this location plus <base href>.

When debug is off, /debug/ is 404 so the wait-screen fallback cannot be
used as a back door onto those consoles.
"""
from __future__ import annotations

import os
import sys

ENGINES = (
    ("radarr", "127.0.0.1:7878"),
    ("sonarr", "127.0.0.1:8989"),
    ("qbittorrent", "127.0.0.1:8080"),
)

# JS/CSS string prefixes that modern Arr and qBittorrent emit at the site
# root. src="/ and href="/ already catch HTML tags, including hashed
# /index-<hash>.js. These catch the same paths inside bundles and JSON.
ROOT_TOKENS = (
    "index-",
    "Content/",
    "api/",
    "signalr/",
    "assets/",
    "initialize.json",
    "login/",
    "css/",
    "js/",
    "images/",
    "public/",
    "icons/",
    "scripts/",
)


def debug_enabled(raw: str | None = None) -> bool:
    if raw is None:
        raw = os.environ.get("POMPEY_DEBUG", "")
    return str(raw).strip().lower() in {"1", "true", "yes", "on"}


def off_include() -> str:
    return """# Debug consoles are off (HA option debug).
location ^~ /debug/ {
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 404;
}
"""


def _filters(mount: str) -> str:
    # $http_x_ingress_path is empty in preview, /api/hassio_ingress/<token>
    # on the sidebar. Replacing "/" with that path rematches because the
    # replacement still starts with /. ./ does not rematch.
    prefix = f"$http_x_ingress_path/debug/{mount}"
    lines = [
        "    sub_filter_once off;",
        "    sub_filter_types text/html text/css application/javascript "
        "application/json text/javascript application/xhtml+xml;",
        """    sub_filter 'src="/' 'src="./';""",
        """    sub_filter 'href="/' 'href="./';""",
        """    sub_filter "src='/" "src='./";""",
        """    sub_filter "href='/" "href='./";""",
        """    sub_filter 'url(/' 'url(./';""",
        """    sub_filter 'import("/' 'import("./';""",
        """    sub_filter "import('/" "import('./";""",
        # Webpack jsonp loads /640-<hash>.js via publicPath "/". That is
        # root-absolute, so <base href> does not apply. ./ does not rematch.
        """    sub_filter '.p="/"' '.p="./"';""",
        """    sub_filter ".p='/'" ".p='./'";""",
        """    sub_filter '.p = "/"' '.p = "./"';""",
        """    sub_filter ".p = '/'" ".p = './'";""",
    ]
    for token in ROOT_TOKENS:
        lines.append(f"""    sub_filter '"/{token}' '"./{token}';""")
        lines.append(f"""    sub_filter "'/{token}" "'./{token}";""")
    lines.extend(
        [
            "    sub_filter '<head>' "
            f"""'<head><base href="{prefix}/">"""
            """<script src="$http_x_ingress_path/debug/shim.js"></script>';""",
            "    sub_filter '<HEAD>' "
            f"""'<HEAD><base href="{prefix}/">"""
            """<script src="$http_x_ingress_path/debug/shim.js"></script>';""",
        ]
    )
    return "\n".join(lines)


def on_include(*, www: str) -> str:
    blocks = [
        f"""# Debug consoles (HA option debug). Supervisor strips Ingress.
# X-Ingress-Path is /api/hassio_ingress/<token> in the sidebar, empty here.
location = /debug/shim.js {{
    alias {www}/debug-shim.js;
    default_type application/javascript;
    add_header Cache-Control "no-store";
    access_log off;
}}
"""
    ]
    for name, upstream in ENGINES:
        filters = _filters(name)
        blocks.append(
            f"""location = /debug/{name} {{
    absolute_redirect off;
    return 302 $http_x_ingress_path/debug/{name}/;
}}
location /debug/{name}/ {{
    proxy_pass http://{upstream}/;
    proxy_http_version 1.1;
    proxy_set_header Host {upstream};
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP 127.0.0.1;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header Accept-Encoding "";
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Content-Security-Policy;
    proxy_read_timeout 86400s;
    proxy_buffering off;
    proxy_redirect / $http_x_ingress_path/debug/{name}/;
    proxy_redirect http://{upstream}/ $http_x_ingress_path/debug/{name}/;
    proxy_cookie_path / $http_x_ingress_path/debug/{name}/;
{filters}
}}
"""
        )
    return "\n".join(blocks)


def render(*, enabled: bool, www: str) -> str:
    body = on_include(www=www) if enabled else off_include()
    return body if body.endswith("\n") else body + "\n"


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("usage: write-debug-ingress INCLUDE_PATH", file=sys.stderr)
        return 2
    dest = argv[1]
    www = os.environ.get("POMPEY_WWW", "/usr/share/pompey").rstrip("/")
    text = render(enabled=debug_enabled(), www=www)
    directory = os.path.dirname(dest) or "."
    os.makedirs(directory, exist_ok=True)
    tmp = dest + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.replace(tmp, dest)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
