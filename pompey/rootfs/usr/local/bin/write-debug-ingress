#!/usr/bin/env python3
"""Write the Ingress nginx include that exposes hidden engine Web UIs.

When POMPEY_DEBUG is on, /debug/radarr/ /debug/sonarr/ /debug/qbittorrent/
proxy to the localhost engines. UrlBase stays empty so wire-stack and
housekeeping keep talking to /api/v3. HTML/JS root paths are rewritten
with X-Ingress-Path (empty outside Home Assistant) plus a small shim that
fixes fetch/XHR/WebSocket after the page loads.

When debug is off, /debug/ is 404 so the wait-screen fallback cannot be
used as a back door onto those consoles.
"""
from __future__ import annotations

import os
import sys

ENGINES = (
    ("radarr", "127.0.0.1:7878", ("Content", "api", "signalr", "initialize.json", "login")),
    ("sonarr", "127.0.0.1:8989", ("Content", "api", "signalr", "initialize.json", "login")),
    (
        "qbittorrent",
        "127.0.0.1:8080",
        ("api", "css", "js", "images", "public", "icons", "scripts"),
    ),
)


def debug_enabled(raw: str | None = None) -> bool:
    if raw is None:
        raw = os.environ.get("POMPEY_DEBUG", "")
    return str(raw).strip().lower() in {"1", "true", "yes", "on"}


def off_include() -> str:
    return """# Debug consoles are off (HA option debug).
location ^~ /debug/ {
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 404;
}
"""


def _filters(mount: str, extras: tuple[str, ...]) -> str:
    prefix = f"$http_x_ingress_path/debug/{mount}"
    lines = [
        "    sub_filter_once off;",
        "    sub_filter_types text/html text/css application/javascript "
        "application/json text/javascript application/xhtml+xml;",
        '    sub_filter \'<head>\' \'<head><script src="$http_x_ingress_path/debug/shim.js"></script>\';',
        '    sub_filter \'<HEAD>\' \'<HEAD><script src="$http_x_ingress_path/debug/shim.js"></script>\';',
    ]
    for extra in extras:
        token = extra if extra.startswith("/") else f"/{extra}"
        if not token.endswith("/") and not token.endswith(".json"):
            token = token + "/"
        lines.append(f"    sub_filter 'src=\"{token}' 'src=\"{prefix}{token}';")
        lines.append(f"    sub_filter 'href=\"{token}' 'href=\"{prefix}{token}';")
        lines.append(f"    sub_filter \"src='{token}\" \"src='{prefix}{token}\";")
        lines.append(f"    sub_filter \"href='{token}\" \"href='{prefix}{token}\";")
        lines.append(f"    sub_filter '\"{token}' '\"{prefix}{token}';")
        lines.append(f"    sub_filter \"'{token}\" \"'{prefix}{token}\";")
        if token.endswith("/"):
            lines.append(f"    sub_filter 'url({token}' 'url({prefix}{token}';")
    return "\n".join(lines)


def on_include(*, www: str) -> str:
    blocks = [
        f"""# Debug consoles (HA option debug). Supervisor strips Ingress.
# X-Ingress-Path is /api/hassio_ingress/<token> in the sidebar, empty here.
location = /debug/shim.js {{
    alias {www}/debug-shim.js;
    default_type application/javascript;
    add_header Cache-Control "no-store";
    access_log off;
}}
"""
    ]
    for name, upstream, extras in ENGINES:
        mount = name
        filters = _filters(mount, extras)
        blocks.append(
            f"""location = /debug/{mount} {{
    absolute_redirect off;
    return 302 $http_x_ingress_path/debug/{mount}/;
}}
location /debug/{mount}/ {{
    proxy_pass http://{upstream}/;
    proxy_http_version 1.1;
    proxy_set_header Host {upstream};
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP 127.0.0.1;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header Accept-Encoding "";
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Content-Security-Policy;
    proxy_read_timeout 86400s;
    proxy_buffering off;
    proxy_redirect / $http_x_ingress_path/debug/{mount}/;
    proxy_redirect http://{upstream}/ $http_x_ingress_path/debug/{mount}/;
    proxy_cookie_path / $http_x_ingress_path/debug/{mount}/;
{filters}
}}
"""
        )
    return "\n".join(blocks)


def render(*, enabled: bool, www: str) -> str:
    body = on_include(www=www) if enabled else off_include()
    return body if body.endswith("\n") else body + "\n"


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("usage: write-debug-ingress INCLUDE_PATH", file=sys.stderr)
        return 2
    dest = argv[1]
    www = os.environ.get("POMPEY_WWW", "/usr/share/pompey").rstrip("/")
    text = render(enabled=debug_enabled(), www=www)
    directory = os.path.dirname(dest) or "."
    os.makedirs(directory, exist_ok=True)
    tmp = dest + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.replace(tmp, dest)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
